@model Notification_Application.Models.Lead

@{
    ViewData["Title"] = "Lead Details";
}

<div class="max-w-7xl mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center gap-4 mb-4">
            <a asp-action="Index" class="text-blue-600 hover:text-blue-800">
                <i class="fas fa-arrow-left me-2"></i>Back to Leads
            </a>
        </div>
        <h1 class="text-3xl font-bold text-gray-900">Lead Details</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Info -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Contact Information -->
            <div class="bg-white rounded-lg shadow border p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Contact Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="text-sm font-medium text-gray-500">Name</label>
                        <p class="text-gray-900 mt-1">
                            @if (!string.IsNullOrEmpty(Model.FirstName) || !string.IsNullOrEmpty(Model.LastName))
                            {
                                <span>@Model.FirstName @Model.LastName</span>
                            }
                            else
                            {
                                <span class="text-gray-400">Not provided</span>
                            }
                        </p>
                    </div>
                    <div>
                        <label class="text-sm font-medium text-gray-500">Email</label>
                        <p class="text-gray-900 mt-1">
                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                <a href="mailto:@Model.Email" class="text-blue-600 hover:underline">@Model.Email</a>
                            }
                            else
                            {
                                <span class="text-gray-400">Not provided</span>
                            }
                        </p>
                    </div>
                    <div>
                        <label class="text-sm font-medium text-gray-500">Phone</label>
                        <p class="text-gray-900 mt-1">
                            @if (!string.IsNullOrEmpty(Model.Phone))
                            {
                                <a href="tel:@Model.Phone" class="text-blue-600 hover:underline">@Model.Phone</a>
                            }
                            else
                            {
                                <span class="text-gray-400">Not provided</span>
                            }
                        </p>
                    </div>
                    <div>
                        <label class="text-sm font-medium text-gray-500">Company</label>
                        <p class="text-gray-900 mt-1">@(Model.Company ?? "Not provided")</p>
                    </div>
                </div>
            </div>

            <!-- Custom Fields -->
            @if (ViewBag.CustomFields != null && ((Dictionary<string, object>)ViewBag.CustomFields).Any())
            {
                <div class="bg-white rounded-lg shadow border p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4">Custom Fields</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        @foreach (var field in (Dictionary<string, object>)ViewBag.CustomFields)
                        {
                            <div>
                                <label class="text-sm font-medium text-gray-500">@field.Key</label>
                                <p class="text-gray-900 mt-1">@field.Value</p>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Source Information -->
            <div class="bg-white rounded-lg shadow border p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Source & Campaign</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="text-sm font-medium text-gray-500">Campaign</label>
                        <p class="text-gray-900 mt-1">@Model.Popup?.Name</p>
                    </div>
                    <div>
                        <label class="text-sm font-medium text-gray-500">View Type</label>
                        <p class="text-gray-900 mt-1">@(Model.ViewType ?? "Default")</p>
                    </div>
                    <div>
                        <label class="text-sm font-medium text-gray-500">Source URL</label>
                        <p class="text-gray-900 mt-1 text-sm break-all">@(Model.Source ?? "N/A")</p>
                    </div>
                    <div>
                        <label class="text-sm font-medium text-gray-500">Referrer</label>
                        <p class="text-gray-900 mt-1 text-sm break-all">@(Model.Referrer ?? "Direct")</p>
                    </div>
                </div>
            </div>

            <!-- UTM Parameters -->
            @if (!string.IsNullOrEmpty(Model.UtmSource) || !string.IsNullOrEmpty(Model.UtmCampaign))
            {
                <div class="bg-white rounded-lg shadow border p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4">UTM Parameters</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        @if (!string.IsNullOrEmpty(Model.UtmSource))
                        {
                            <div>
                                <label class="text-sm font-medium text-gray-500">UTM Source</label>
                                <p class="text-gray-900 mt-1">@Model.UtmSource</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.UtmMedium))
                        {
                            <div>
                                <label class="text-sm font-medium text-gray-500">UTM Medium</label>
                                <p class="text-gray-900 mt-1">@Model.UtmMedium</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.UtmCampaign))
                        {
                            <div>
                                <label class="text-sm font-medium text-gray-500">UTM Campaign</label>
                                <p class="text-gray-900 mt-1">@Model.UtmCampaign</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.UtmTerm))
                        {
                            <div>
                                <label class="text-sm font-medium text-gray-500">UTM Term</label>
                                <p class="text-gray-900 mt-1">@Model.UtmTerm</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.UtmContent))
                        {
                            <div>
                                <label class="text-sm font-medium text-gray-500">UTM Content</label>
                                <p class="text-gray-900 mt-1">@Model.UtmContent</p>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Notes Section -->
            <div class="bg-white rounded-lg shadow border p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Notes</h2>
                <div class="prose max-w-none">
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <p class="text-gray-700 whitespace-pre-wrap">@Model.Notes</p>
                    }
                    else
                    {
                        <p class="text-gray-400 italic">No notes yet</p>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <!-- Status Card -->
            <div class="bg-white rounded-lg shadow border p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Lead Status</h3>
                
                <form asp-action="UpdateStatus" method="post" class="space-y-4">
                    <input type="hidden" name="id" value="@Model.Id" />
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                        <select name="status" class="w-full border border-gray-300 rounded-md px-3 py-2">
                            <option value="New" selected="@(Model.Status == Notification_Application.Models.LeadStatus.New)">New</option>
                            <option value="Contacted" selected="@(Model.Status == Notification_Application.Models.LeadStatus.Contacted)">Contacted</option>
                            <option value="Qualified" selected="@(Model.Status == Notification_Application.Models.LeadStatus.Qualified)">Qualified</option>
                            <option value="Converted" selected="@(Model.Status == Notification_Application.Models.LeadStatus.Converted)">Converted</option>
                            <option value="Unqualified" selected="@(Model.Status == Notification_Application.Models.LeadStatus.Unqualified)">Unqualified</option>
                            <option value="Archived" selected="@(Model.Status == Notification_Application.Models.LeadStatus.Archived)">Archived</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Add Note</label>
                        <textarea name="notes" rows="3" class="w-full border border-gray-300 rounded-md px-3 py-2" placeholder="Add a note about this lead..."></textarea>
                    </div>

                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md font-medium">
                        Update Status
                    </button>
                </form>
            </div>

            <!-- Timeline -->
            <div class="bg-white rounded-lg shadow border p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Timeline</h3>
                <div class="space-y-4">
                    <div class="flex items-start gap-3">
                        <div class="bg-blue-100 p-2 rounded-full">
                            <i class="fas fa-plus text-blue-600"></i>
                        </div>
                        <div class="flex-1">
                            <p class="text-sm font-medium text-gray-900">Lead Captured</p>
                            <p class="text-xs text-gray-500">@Model.CapturedAt.ToString("MMM dd, yyyy HH:mm")</p>
                        </div>
                    </div>

                    @if (Model.LastContactedAt.HasValue)
                    {
                        <div class="flex items-start gap-3">
                            <div class="bg-purple-100 p-2 rounded-full">
                                <i class="fas fa-phone text-purple-600"></i>
                            </div>
                            <div class="flex-1">
                                <p class="text-sm font-medium text-gray-900">Contacted</p>
                                <p class="text-xs text-gray-500">@Model.LastContactedAt.Value.ToString("MMM dd, yyyy HH:mm")</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Metadata -->
            <div class="bg-white rounded-lg shadow border p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Metadata</h3>
                <div class="space-y-3 text-sm">
                    <div>
                        <span class="text-gray-500">IP Address:</span>
                        <span class="text-gray-900 ml-2">@(Model.IpAddress ?? "N/A")</span>
                    </div>
                    <div>
                        <span class="text-gray-500">GDPR Consent:</span>
                        <span class="ml-2">
                            @if (Model.ConsentGiven)
                            {
                                <span class="text-green-600"><i class="fas fa-check-circle"></i> Given</span>
                            }
                            else
                            {
                                <span class="text-gray-400"><i class="fas fa-times-circle"></i> Not given</span>
                            }
                        </span>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="bg-white rounded-lg shadow border p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Actions</h3>
                <div class="space-y-2">
                    <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this lead?');">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="w-full text-left px-4 py-2 text-red-600 hover:bg-red-50 rounded-md text-sm font-medium">
                            <i class="fas fa-trash me-2"></i>Delete Lead
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
