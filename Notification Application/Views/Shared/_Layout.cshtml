@using Microsoft.AspNetCore.Identity
@using Notification_Application.Models
@using Notification_Application.Data
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
@inject ApplicationDbContext DbContext

@{
    // Get tenant analytics configuration for logged-in users
    string? tenantGTM = null;
    string? tenantGA4 = null;
    
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            var tenant = await DbContext.Tenants.FindAsync(currentUser.TenantId);
            if (tenant != null)
            {
                tenantGTM = tenant.GoogleTagManagerId;
                tenantGA4 = tenant.GoogleAnalytics4Id;
            }
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Popup Manager Pro</title>

    <!-- Google Tag Manager (Site-wide) -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WHQDRT72');</script>
    <!-- End Google Tag Manager -->

    @if (!string.IsNullOrEmpty(tenantGTM))
    {
        <!-- Tenant-specific Google Tag Manager -->
        <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','@tenantGTM');</script>
    }

    @if (!string.IsNullOrEmpty(tenantGA4))
    {
        <!-- Tenant-specific Google Analytics 4 -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=@tenantGA4"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '@tenantGA4');
        </script>
    }

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Custom styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <!-- Render additional styles section if defined -->
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WHQDRT72"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <header class="bg-white shadow-sm border-b">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center py-3">
                <!-- Logo and Brand -->
                <div class="flex">
                    <div class="flex-shrink-0 flex items-center">
                        <a asp-controller="Home" asp-action="Index" class="flex items-center">
                            <img src="~/images/sitelogo.png" alt="Logo" style="height: 84px; width: auto;" class="mr-2" />
                        </a>
                    </div>

                    <!-- Main Navigation (when authenticated) -->
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
                            @if (User.IsInRole("User"))
                            {
                                <!-- User Dashboard -->
                                <a asp-controller="UserDashboard" asp-action="Index" class="text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 text-sm font-medium">
                                    Dashboard
                                </a>
                                <a asp-controller="Popup" asp-action="Index" class="text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 text-sm font-medium">
                                    Popups
                                </a>
                                <a asp-controller="Form" asp-action="Index" class="text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 text-sm font-medium">
                                    Forms
                                </a>
                                <a asp-controller="LandingPage" asp-action="Index" class="text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 text-sm font-medium">
                                    Landing Pages
                                </a>
                                <!-- Numbers (Call Tracking) -->
                                <a asp-controller="Numbers" asp-action="Index" class="text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 text-sm font-medium">
                                    Numbers
                                </a>
                                <!-- Analytics -->
                                <a asp-controller="UserDashboard" asp-action="Analytics" class="text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 text-sm font-medium">
                                    Analytics
                                </a>
                                <!-- CRM Dropdown -->
                                <div class="dropdown inline-flex items-center px-1 pt-1">
                                    <button class="text-gray-500 hover:text-gray-700 text-sm font-medium dropdown-toggle" type="button" id="crmMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                        CRM
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="crmMenuDropdown">
                                        <li><a class="dropdown-item" asp-controller="Leads" asp-action="Index">
                                            <i class="fas fa-users me-2"></i>Leads
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="Crm" asp-action="Pipeline">
                                            <i class="fas fa-stream me-2"></i>Pipeline
                                            @if (ViewBag.PlanId < 3)
                                            {
                                                <span class="badge bg-warning text-dark ms-2" title="Pro plan required"><i class="fas fa-lock"></i></span>
                                            }
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="Crm" asp-action="Deals">
                                            <i class="fas fa-handshake me-2"></i>Deals
                                            @if (ViewBag.PlanId < 3)
                                            {
                                                <span class="badge bg-warning text-dark ms-2" title="Pro plan required"><i class="fas fa-lock"></i></span>
                                            }
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="Crm" asp-action="Analytics">
                                            <i class="fas fa-chart-line me-2"></i>Reports
                                            @if (ViewBag.PlanId < 3)
                                            {
                                                <span class="badge bg-warning text-dark ms-2" title="Pro plan required"><i class="fas fa-lock"></i></span>
                                            }
                                        </a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Crm" asp-action="Index">
                                            <i class="fas fa-tachometer-alt me-2"></i>CRM Dashboard
                                            @if (ViewBag.PlanId < 3)
                                            {
                                                <span class="badge bg-warning text-dark ms-2" title="Pro plan required"><i class="fas fa-lock"></i></span>
                                            }
                                        </a></li>
                                    </ul>
                                </div>
                                <a asp-controller="Integration" asp-action="Index" class="text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 text-sm font-medium">
                                    Integrations
                                </a>
                            }
                            else if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                            {
                                <!-- Admin Navigation -->
                                <a asp-controller="Admin" asp-action="Index" class="text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 text-sm font-medium">
                                    Admin Dashboard
                                </a>
                                <a asp-controller="Popup" asp-action="Index" class="text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 text-sm font-medium">
                                    Popups
                                </a>
                                <div class="dropdown inline-flex items-center px-1 pt-1">
                                    <button class="text-gray-500 hover:text-gray-700 text-sm font-medium dropdown-toggle" type="button" id="adminMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                        Management
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="adminMenuDropdown">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Analytics">
                                            <i class="bi bi-graph-up me-2"></i>Analytics
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">
                                            <i class="bi bi-people me-2"></i>Team Members
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="PixelInstallation">
                                            <i class="bi bi-code-square me-2"></i>Install Pixel
                                        </a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Blog">
                                            <i class="bi bi-file-text me-2"></i>Blog Posts
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="WebsitePage" asp-action="Index">
                                            <i class="bi bi-file-earmark-text me-2"></i>Website Pages
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="Form" asp-action="Index">
                                            <i class="bi bi-ui-checks me-2"></i>Forms
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="LandingPage" asp-action="Index">
                                            <i class="bi bi-window me-2"></i>Landing Pages
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="Crm" asp-action="Settings">
                                            <i class="bi bi-sliders me-2"></i>CRM Settings
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="Integration" asp-action="Index">
                                            <i class="bi bi-plug me-2"></i>Integrations
                                        </a></li>
                                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("MasterAdmin") || User.IsInRole("MasterAdmin"))
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="UsageLimits">
                                                <i class="bi bi-speedometer2 me-2"></i>Usage Limits & AI
                                            </a></li>
                                            <li><a class="dropdown-item" asp-controller="SuperAdmin" asp-action="AllTenants">
                                                <i class="bi bi-building me-2"></i>All Tenants
                                            </a></li>
                                            <li><a class="dropdown-item" asp-controller="SuperAdmin" asp-action="Plans">
                                                <i class="bi bi-box-seam me-2"></i>Subscription Plans
                                            </a></li>
                                        }
                                        <li><hr class="dropdown-divider"></li>
                                        @if (User.Identity?.IsAuthenticated == true && User.Identity.Name == "joe.whyte@gmail.com")
                                        {
                                            <li><a class="dropdown-item text-primary fw-bold" href="#" onclick="event.preventDefault(); document.getElementById('role-form-admin').submit();">
                                                <i class="bi bi-shield-check me-2"></i>Switch to @(User.IsInRole("Admin") ? "User" : "Admin") View
                                            </a></li>
                                            <form id="role-form-admin" asp-controller="Account" asp-action="SwitchRole" method="post" class="d-none">
                                                <input type="hidden" name="role" value="@(User.IsInRole("Admin") ? "User" : "Admin")" />
                                            </form>
                                            <li><hr class="dropdown-divider"></li>
                                        }
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Settings">
                                            <i class="bi bi-gear me-2"></i>Tenant Settings
                                        </a></li>
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Public Navigation -->
                        <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
                            <a asp-controller="Home" asp-action="Features" class="text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 text-sm font-medium">
                                Features
                            </a>
                            <a asp-controller="Home" asp-action="Pricing" class="text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 text-sm font-medium">
                                Pricing
                            </a>
                            <a asp-controller="Blog" asp-action="Index" class="text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 text-sm font-medium">
                                Blog
                            </a>
                            <a asp-controller="Home" asp-action="Demo" class="text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 text-sm font-medium">
                                Demo
                            </a>
                        </div>
                    }
                </div>

                <!-- Right Side Navigation -->
                <div class="hidden sm:ml-6 sm:flex sm:items-center">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="flex items-center space-x-4">
                            <!-- User Profile Dropdown -->
                            <div class="dropdown">
                                <button class="btn btn-link p-0 dropdown-toggle d-flex align-items-center text-decoration-none" 
                                        type="button" 
                                        id="userMenuDropdown" 
                                        data-bs-toggle="dropdown" 
                                        aria-expanded="false">
                                    <div class="h-9 w-9 rounded-full bg-gradient-to-br from-blue-600 to-blue-700 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        <span class="text-white text-sm font-semibold">
                                            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                        </span>
                                    </div>
                                </button>

                                <!-- Dropdown Menu -->
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="userMenuDropdown" style="min-width: 14rem;">
                                    <!-- User Info Section -->
                                    <li class="px-3 py-2 border-bottom">
                                        <p class="mb-1 fw-medium text-dark small">@User.Identity.Name</p>
                                        <p class="mb-0 text-muted" style="font-size: 0.75rem;">
                                            @if (User.IsInRole("MasterAdmin"))
                                            {
                                                <span class="badge" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                                                    <i class="fas fa-crown me-1"></i>Master Admin
                                                </span>
                                            }
                                            else if (User.IsInRole("SuperAdmin"))
                                            {
                                                <span class="badge bg-purple text-white">
                                                    <i class="fas fa-user-shield me-1"></i>Super Admin
                                                </span>
                                            }
                                            else if (User.IsInRole("Admin"))
                                            {
                                                <span class="badge bg-primary">
                                                    <i class="fas fa-user-cog me-1"></i>Admin
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="fas fa-user me-1"></i>User
                                                </span>
                                            }
                                        </p>
                                    </li>

                                    @if ((User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("MasterAdmin")))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li class="px-3 py-2">
                                            <p class="mb-1 text-muted" style="font-size: 0.7rem;">SWITCH VIEW</p>
                                            <div class="d-flex gap-2">
                                                <a class="btn btn-sm @(User.IsInRole("User") ? "btn-primary" : "btn-outline-primary") flex-fill" 
                                                   href="#" 
                                                   onclick="event.preventDefault(); switchToView('User');">
                                                    <i class="bi bi-speedometer2 me-1"></i>User Panel
                                                </a>
                                                <a class="btn btn-sm @((User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("MasterAdmin")) && !User.IsInRole("User") ? "btn-primary" : "btn-outline-primary") flex-fill" 
                                                   href="#" 
                                                   onclick="event.preventDefault(); switchToView('Admin');">
                                                    <i class="bi bi-shield-lock me-1"></i>Admin Panel
                                                </a>
                                            </div>
                                        </li>
                                        <form id="role-switch-form" asp-controller="Account" asp-action="SwitchRole" method="post" class="d-none">
                                            <input type="hidden" name="role" id="target-role" value="" />
                                        </form>
                                        <li><hr class="dropdown-divider"></li>
                                    }

                                    <!-- Menu Items -->
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <i class="fas fa-user-circle me-2 text-muted"></i>My Profile
                                    </a></li>
                                    
                                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Settings">
                                            <i class="fas fa-cog me-2 text-muted"></i>Tenant Settings
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Subscription">
                                            <i class="fas fa-credit-card me-2 text-muted"></i>Subscription
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Support">
                                            <i class="fas fa-life-ring me-2 text-muted"></i>Support
                                        </a></li>
                                    }
                                    else if (User.IsInRole("User"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="UserDashboard" asp-action="Subscription">
                                            <i class="fas fa-credit-card me-2 text-muted"></i>Usage & Limits
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="UserDashboard" asp-action="Support">
                                            <i class="fas fa-life-ring me-2 text-muted"></i>Support
                                        </a></li>
                                    }

                                    <li><hr class="dropdown-divider"></li>
                                    
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-2">
                                            <button type="submit" class="btn btn-sm btn-danger w-100 d-flex align-items-center justify-content-center">
                                                <i class="fas fa-sign-out-alt me-2"></i>Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center space-x-4">
                            <a asp-controller="Account" asp-action="Login" class="text-gray-500 hover:text-gray-700 px-3 py-2 text-sm font-medium">
                                Login
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-blue-700 transition">
                                Get Started
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
        <!-- Success/Error Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="bg-green-50 border border-green-200 rounded-lg p-4 m-4" id="success-message">
                <div class="flex">
                    <i class="fas fa-check-circle text-green-400"></i>
                    <p class="text-sm font-medium text-green-800 ml-3">@TempData["Success"]</p>
                </div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="bg-red-50 border border-red-200 rounded-lg p-4 m-4" id="error-message">
                <div class="flex">
                    <i class="fas fa-exclamation-circle text-red-400"></i>
                    <p class="text-sm font-medium text-red-800 ml-3">@TempData["Error"]</p>
                </div>
            </div>
        }

        <!-- Page Content -->
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t mt-auto">
        <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center">
                <div class="flex items-center">
                    <img src="~/images/sitelogo.png" alt="Logo" style="height: 48px; width: auto;" class="mr-2" />
                    <span class="text-gray-500 text-sm">&copy; @DateTime.Now.Year All rights reserved.</span>
                </div>
                <div class="flex space-x-6">
                    <a asp-controller="Home" asp-action="Privacy" class="text-gray-500 hover:text-gray-700 text-sm">
                        Privacy Policy
                    </a>
                    <a asp-controller="Home" asp-action="Contact" class="text-gray-500 hover:text-gray-700 text-sm">
                        Contact
                    </a>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Admin" asp-action="Support" class="text-gray-500 hover:text-gray-700 text-sm">
                            Support
                        </a>
                    }
                </div>
            </div>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Auto-hide messages script -->
    <script>
        // Auto-hide success/error messages after 5 seconds
        setTimeout(function() {
            const successMsg = document.getElementById('success-message');
            const errorMsg = document.getElementById('error-message');

            if (successMsg) {
                successMsg.style.transition = 'opacity 0.5s';
                successMsg.style.opacity = '0';
                setTimeout(() => successMsg.remove(), 500);
            }

            if (errorMsg) {
                errorMsg.style.transition = 'opacity 0.5s';
                errorMsg.style.opacity = '0';
                setTimeout(() => errorMsg.remove(), 500);
            }
        }, 5000);

        // Role switcher function
        function switchToView(role) {
            document.getElementById('target-role').value = role;
            document.getElementById('role-switch-form').submit();
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>