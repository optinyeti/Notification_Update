@model Notification_Application.Models.PopupAnalyticsViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analytics - @Model.Popup.Name</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        * {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            padding: 0;
        }
        
        .navbar {
            background: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .analytics-container {
            max-width: 1600px;
            margin: 40px auto;
            padding: 0 30px;
        }
        
        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            overflow: hidden;
        }
        
        .card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 20px 20px 0 0 !important;
            padding: 25px 30px;
        }
        
        .card-header h4 {
            margin: 0;
            color: white;
            font-weight: 700;
            font-size: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .stat-card {
            background: white;
            padding: 30px;
            border-radius: 20px;
            border: none;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
        }
        
        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #667eea, #764ba2);
            transform: scaleX(0);
            transition: transform 0.4s ease;
        }
        
        .stat-card:hover::before {
            transform: scaleX(1);
        }
        
        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 16px 48px rgba(102, 126, 234, 0.25);
        }
        
        .stat-card .icon {
            width: 72px;
            height: 72px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            margin-bottom: 20px;
            position: relative;
        }
        
        .stat-card .icon.views {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            box-shadow: 0 8px 24px rgba(102, 126, 234, 0.3);
        }
        
        .stat-card .icon.clicks {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
            box-shadow: 0 8px 24px rgba(245, 87, 108, 0.3);
        }
        
        .stat-card .icon.conversions {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
            box-shadow: 0 8px 24px rgba(79, 172, 254, 0.3);
        }
        
        .stat-card .icon.rate {
            background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            color: white;
            box-shadow: 0 8px 24px rgba(250, 112, 154, 0.3);
        }
        
        .stat-card .icon.mobile {
            background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
            color: #c2185b;
            box-shadow: 0 8px 24px rgba(168, 237, 234, 0.3);
        }
        
        .stat-card .icon.desktop {
            background: linear-gradient(135deg, #d299c2 0%, #fef9d7 100%);
            color: #00796b;
            box-shadow: 0 8px 24px rgba(211, 153, 194, 0.3);
        }
        
        .stat-card h6 {
            color: #9ca3af;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 1.2px;
        }
        
        .stat-card .value {
            font-size: 42px;
            font-weight: 800;
            color: #1f2937;
            margin: 0;
            line-height: 1;
        }
        
        .stat-card .change {
            font-size: 14px;
            margin-top: 8px;
            font-weight: 600;
        }
        
        .stat-card .change.positive {
            color: #10b981;
        }
        
        .stat-card .change.negative {
            color: #ef4444;
        }
        
        .chart-container {
            position: relative;
            height: 420px;
            padding: 30px;
        }
        
        .date-range {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 12px 28px;
            border-radius: 12px;
            font-weight: 700;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        }
        
        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
        }
        
        .btn-outline-secondary {
            padding: 12px 28px;
            border-radius: 12px;
            font-weight: 700;
            border: 2px solid #667eea;
            color: #667eea;
            background: white;
            transition: all 0.3s;
        }
        
        .btn-outline-secondary:hover {
            background: #667eea;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        }
        
        .popup-info {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px;
            border-radius: 24px;
            margin-bottom: 30px;
            box-shadow: 0 12px 40px rgba(102, 126, 234, 0.3);
            position: relative;
            overflow: hidden;
        }
        
        .popup-info::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            border-radius: 50%;
        }
        
        .popup-info h2 {
            margin: 0;
            font-weight: 800;
            font-size: 32px;
            position: relative;
        }
        
        .popup-info .badge {
            font-size: 14px;
            padding: 10px 18px;
            margin-top: 15px;
            border-radius: 10px;
            font-weight: 700;
            backdrop-filter: blur(10px);
        }
        
        .table {
            border-collapse: separate;
            border-spacing: 0;
        }
        
        .table thead tr th {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border: none;
            padding: 18px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 1px;
            color: #6b7280;
        }
        
        .table tbody tr {
            transition: all 0.3s;
            border-bottom: 1px solid #f3f4f6;
        }
        
        .table tbody tr:hover {
            background: linear-gradient(90deg, #f9fafb 0%, #ffffff 100%);
            transform: scale(1.01);
        }
        
        .table tbody tr td {
            padding: 20px 18px;
            vertical-align: middle;
        }
        
        .badge {
            padding: 8px 14px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/Home/Dashboard">
                <i class="bi bi-bell-fill text-primary"></i> Popup Manager
            </a>
            <div class="ms-auto d-flex gap-2">
                <a href="/LandingPage" class="btn btn-outline-success">
                    <i class="bi bi-file-earmark-text"></i> Landing Pages
                </a>
                <a href="/Popup/Edit/@Model.Popup.Id" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Edit
                </a>
            </div>
        </div>
    </nav>

    <div class="container analytics-container" style="margin-top: 80px;">
        <!-- Popup Info Header -->
        <div class="popup-info">
            <div class="d-flex justify-content-between align-items-start flex-wrap">
                <div>
                    <h2><i class="bi bi-graph-up"></i> Analytics: @Model.Popup.Name</h2>
                    <div class="mt-2">
                        <span class="badge bg-light text-dark">@Model.Popup.Type</span>
                        @if (Model.Popup.Status == PopupStatus.Published)
                        {
                            <span class="badge bg-success">Published</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@Model.Popup.Status</span>
                        }
                    </div>
                </div>
                <div class="text-end">
                    <p class="mb-1"><small>Date Range</small></p>
                    <p class="mb-0 fw-bold">@Model.StartDate.ToString("MMM dd, yyyy") - @Model.EndDate.ToString("MMM dd, yyyy")</p>
                </div>
            </div>
        </div>

        <!-- Key Metrics -->
        <div class="row mb-4">
            <div class="col-md-6 col-lg-3 mb-3">
                <div class="stat-card">
                    <div class="icon views">
                        <i class="bi bi-eye-fill"></i>
                    </div>
                    <h6>Total Views</h6>
                    <p class="value">@Model.Analytics.Sum(a => a.Views).ToString("N0")</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-3">
                <div class="stat-card">
                    <div class="icon clicks">
                        <i class="bi bi-cursor-fill"></i>
                    </div>
                    <h6>Total Clicks</h6>
                    <p class="value">@Model.Analytics.Sum(a => a.Clicks).ToString("N0")</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-3">
                <div class="stat-card">
                    <div class="icon conversions">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <h6>Conversions</h6>
                    <p class="value">@Model.Analytics.Sum(a => a.Conversions).ToString("N0")</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-3">
                <div class="stat-card">
                    <div class="icon rate">
                        <i class="bi bi-percent"></i>
                    </div>
                    <h6>Conversion Rate</h6>
                    @{
                        var totalViews = Model.Analytics.Sum(a => a.Views);
                        var totalConversions = Model.Analytics.Sum(a => a.Conversions);
                        var conversionRate = totalViews > 0 ? (totalConversions * 100.0 / totalViews) : 0;
                    }
                    <p class="value">@conversionRate.ToString("F2")%</p>
                </div>
            </div>
        </div>

        <!-- Device Breakdown -->
        <div class="row mb-4">
            <div class="col-md-6 mb-3">
                <div class="stat-card">
                    <div class="icon mobile">
                        <i class="bi bi-phone-fill"></i>
                    </div>
                    <h6>Mobile Views</h6>
                    <p class="value">@Model.Analytics.Sum(a => a.MobileViews).ToString("N0")</p>
                    @{
                        var mobilePercentage = totalViews > 0 ? (Model.Analytics.Sum(a => a.MobileViews) * 100.0 / totalViews) : 0;
                    }
                    <p class="text-muted mb-0">@mobilePercentage.ToString("F1")% of total views</p>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="stat-card">
                    <div class="icon desktop">
                        <i class="bi bi-display-fill"></i>
                    </div>
                    <h6>Desktop Views</h6>
                    <p class="value">@Model.Analytics.Sum(a => a.DesktopViews).ToString("N0")</p>
                    @{
                        var desktopPercentage = totalViews > 0 ? (Model.Analytics.Sum(a => a.DesktopViews) * 100.0 / totalViews) : 0;
                    }
                    <p class="text-muted mb-0">@desktopPercentage.ToString("F1")% of total views</p>
                </div>
            </div>
        </div>

        <!-- Charts -->
        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h4><i class="bi bi-graph-up-arrow"></i> Performance Over Time</h4>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="performanceChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h4><i class="bi bi-pie-chart-fill"></i> Device Distribution</h4>
                    </div>
                    <div class="card-body">
                        <div class="chart-container" style="height: 300px;">
                            <canvas id="deviceChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detailed Analytics Table -->
        <div class="card">
            <div class="card-header">
                <h4><i class="bi bi-table"></i> Daily Analytics</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th class="text-end">Views</th>
                                <th class="text-end">Clicks</th>
                                <th class="text-end">Conversions</th>
                                <th class="text-end">Rate</th>
                                <th class="text-end">Mobile</th>
                                <th class="text-end">Desktop</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var day in Model.Analytics.OrderByDescending(a => a.Date))
                            {
                                var dayRate = day.Views > 0 ? (day.Conversions * 100.0 / day.Views) : 0;
                                <tr>
                                    <td>@day.Date.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end">@day.Views.ToString("N0")</td>
                                    <td class="text-end">@day.Clicks.ToString("N0")</td>
                                    <td class="text-end">@day.Conversions.ToString("N0")</td>
                                    <td class="text-end">
                                        <span class="badge @(dayRate >= conversionRate ? "bg-success" : "bg-warning")">
                                            @dayRate.ToString("F2")%
                                        </span>
                                    </td>
                                    <td class="text-end">@day.MobileViews.ToString("N0")</td>
                                    <td class="text-end">@day.DesktopViews.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-bold">
                                <td>Total</td>
                                <td class="text-end">@totalViews.ToString("N0")</td>
                                <td class="text-end">@Model.Analytics.Sum(a => a.Clicks).ToString("N0")</td>
                                <td class="text-end">@totalConversions.ToString("N0")</td>
                                <td class="text-end">
                                    <span class="badge bg-primary">@conversionRate.ToString("F2")%</span>
                                </td>
                                <td class="text-end">@Model.Analytics.Sum(a => a.MobileViews).ToString("N0")</td>
                                <td class="text-end">@Model.Analytics.Sum(a => a.DesktopViews).ToString("N0")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Modern gradient colors
        const gradients = {
            purple: {
                start: 'rgba(102, 126, 234, 0.8)',
                end: 'rgba(118, 75, 162, 0.2)'
            },
            pink: {
                start: 'rgba(240, 147, 251, 0.8)',
                end: 'rgba(245, 87, 108, 0.2)'
            },
            blue: {
                start: 'rgba(79, 172, 254, 0.8)',
                end: 'rgba(0, 242, 254, 0.2)'
            }
        };

        // Performance Over Time Chart
        const performanceCtx = document.getElementById('performanceChart').getContext('2d');
        
        // Create gradients
        const viewsGradient = performanceCtx.createLinearGradient(0, 0, 0, 400);
        viewsGradient.addColorStop(0, gradients.purple.start);
        viewsGradient.addColorStop(1, gradients.purple.end);
        
        const clicksGradient = performanceCtx.createLinearGradient(0, 0, 0, 400);
        clicksGradient.addColorStop(0, gradients.pink.start);
        clicksGradient.addColorStop(1, gradients.pink.end);
        
        const conversionsGradient = performanceCtx.createLinearGradient(0, 0, 0, 400);
        conversionsGradient.addColorStop(0, gradients.blue.start);
        conversionsGradient.addColorStop(1, gradients.blue.end);
        
        const performanceChart = new Chart(performanceCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.OrderBy(a => a.Date).Select(a => a.Date.ToString("MMM dd")))),
                datasets: [
                    {
                        label: 'Views',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.OrderBy(a => a.Date).Select(a => a.Views))),
                        borderColor: 'rgb(102, 126, 234)',
                        backgroundColor: viewsGradient,
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 6,
                        pointHoverRadius: 8,
                        pointBackgroundColor: 'white',
                        pointBorderColor: 'rgb(102, 126, 234)',
                        pointBorderWidth: 3
                    },
                    {
                        label: 'Clicks',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.OrderBy(a => a.Date).Select(a => a.Clicks))),
                        borderColor: 'rgb(245, 87, 108)',
                        backgroundColor: clicksGradient,
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 6,
                        pointHoverRadius: 8,
                        pointBackgroundColor: 'white',
                        pointBorderColor: 'rgb(245, 87, 108)',
                        pointBorderWidth: 3
                    },
                    {
                        label: 'Conversions',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.OrderBy(a => a.Date).Select(a => a.Conversions))),
                        borderColor: 'rgb(79, 172, 254)',
                        backgroundColor: conversionsGradient,
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 6,
                        pointHoverRadius: 8,
                        pointBackgroundColor: 'white',
                        pointBorderColor: 'rgb(79, 172, 254)',
                        pointBorderWidth: 3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            usePointStyle: true,
                            padding: 20,
                            font: {
                                size: 14,
                                weight: '700'
                            }
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        padding: 16,
                        titleFont: {
                            size: 16,
                            weight: '700'
                        },
                        bodyFont: {
                            size: 14
                        },
                        bodySpacing: 8,
                        borderColor: 'rgba(255, 255, 255, 0.1)',
                        borderWidth: 1,
                        cornerRadius: 12,
                        displayColors: true,
                        usePointStyle: true
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            font: {
                                size: 12,
                                weight: '600'
                            },
                            color: '#6b7280'
                        }
                    },
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(0, 0, 0, 0.05)',
                            drawBorder: false
                        },
                        ticks: {
                            precision: 0,
                            font: {
                                size: 12,
                                weight: '600'
                            },
                            color: '#6b7280',
                            padding: 10
                        }
                    }
                }
            }
        });

        // Device Distribution Chart
        const deviceCtx = document.getElementById('deviceChart').getContext('2d');
        const deviceChart = new Chart(deviceCtx, {
            type: 'doughnut',
            data: {
                labels: ['Mobile', 'Desktop'],
                datasets: [{
                    data: [
                        @Model.Analytics.Sum(a => a.MobileViews),
                        @Model.Analytics.Sum(a => a.DesktopViews)
                    ],
                    backgroundColor: [
                        'rgba(245, 87, 108, 0.9)',
                        'rgba(79, 172, 254, 0.9)'
                    ],
                    borderColor: 'white',
                    borderWidth: 4,
                    hoverOffset: 15
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '70%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            padding: 20,
                            font: {
                                size: 14,
                                weight: '700'
                            },
                            generateLabels: function(chart) {
                                const data = chart.data;
                                if (data.labels.length && data.datasets.length) {
                                    return data.labels.map((label, i) => {
                                        const value = data.datasets[0].data[i];
                                        const total = data.datasets[0].data.reduce((a, b) => a + b, 0);
                                        const percentage = ((value / total) * 100).toFixed(1);
                                        return {
                                            text: `${label}: ${value.toLocaleString()} (${percentage}%)`,
                                            fillStyle: data.datasets[0].backgroundColor[i],
                                            hidden: false,
                                            index: i
                                        };
                                    });
                                }
                                return [];
                            }
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        padding: 16,
                        titleFont: {
                            size: 16,
                            weight: '700'
                        },
                        bodyFont: {
                            size: 14
                        },
                        cornerRadius: 12,
                        callbacks: {
                            label: function(context) {
                                let label = context.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                label += context.parsed.toLocaleString();
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((context.parsed / total) * 100).toFixed(1);
                                label += ` (${percentage}%)`;
                                return label;
                            }
                        }
                    }
                }
            }
        });
    </script>
</body>
</html>
