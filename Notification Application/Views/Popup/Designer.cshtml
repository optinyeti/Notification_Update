                    <!-- Initial View (Default) -->
                    <div class="view-card" data-view-id="1" data-view-type="initial" style="background: white; border: 2px solid #e5e7eb; border-radius: 12px; padding: 24px; position: relative;">
                        <div style="display: flex; align-items: start; gap: 20px;">
                            <div style="flex-shrink: 0; width: 120px; height: 90px; background: #f3f4f6; border-radius: 8px; display: flex; align-items: center; justify-content: center; border: 2px dashed #d1d5db;">
                                <i class="bi bi-eye" style="font-size: 32px; color: #9ca3af;"></i>
                            </div>
                            <div style="flex: 1;">
                                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                                    <h3 style="font-size: 18px; font-weight: 600; color: #111827; margin: 0;">Initial View</h3>
                                    <span style="background: #10b981; color: white; padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 600;">DEFAULT</span>
                                </div>
                                <p style="color: #6b7280; font-size: 14px; margin-bottom: 16px;">The first view shown to visitors when they see this campaign</p>
                                <div style="display: flex; gap: 12px; align-items: center;">
                                    <select class="form-select form-select-sm" style="width: 150px;" onchange="updateViewType(this, 1)">
                                        <option value="initial" selected>Initial</option>
                                        <option value="success">Success</option>
                                        <option value="error">Error</option>
                                        <option value="thank-you">Thank You</option>
                                        <option value="download">Download</option>
                                        <option value="custom">Custom</option>
                                    </select>
                                    <input type="text" class="form-control form-control-sm" placeholder="View name..." value="Initial View" style="width: 200px;" onchange="updateViewName(this, 1)">
                                    <button class="btn btn-sm btn-outline-primary" onclick="editViewContent(1)">
                                        <i class="bi bi-pencil me-1"></i>Edit Content
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" onclick="duplicateView(1)">
                                        <i class="bi bi-files"></i>
                                    </button>
                                </div>
                            </div>
                            <div style="display: flex; gap: 8px; flex-direction: column;">
                                <button class="btn btn-sm btn-outline-secondary" onclick="moveViewUp(1)" title="Move Up">
                                    <i class="bi bi-arrow-up"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" onclick="moveViewDown(1)" title="Move Down">
                                    <i class="bi bi-arrow-down"></i>
                                </button>
                            </div>
                        </div>
                        <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #e5e7eb;">
                            <div style="display: flex; gap: 24px; align-items: center; flex-wrap: wrap;">
                                <div>
                                    <label style="font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Show When</label>
                                    <select class="form-select form-select-sm" style="width: 200px;">
                                        <option value="always">Always (Default)</option>
                                        <option value="condition">Custom Condition</option>
                                    </select>
                                </div>
                                <div>
                                    <label style="font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Next View On Submit</label>
                                    <select class="form-select form-select-sm" style="width: 200px;">
                                        <option value="">None (Close)</option>
                                        <option value="success">→ Success View</option>
                                        <option value="error">→ Error View</option>
                                    </select>
                                </div>
                                <div>
