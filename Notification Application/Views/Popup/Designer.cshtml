                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="webhookRetry" checked>
                        <label class="form-check-label" for="webhookRetry">Retry on failure (up to 3 times)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="webhookEnabled" checked>
                        <label class="form-check-label" for="webhookEnabled">Enable webhook</label>
