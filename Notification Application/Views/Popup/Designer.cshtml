        function updateTextStyle(property, value) {
            if (!selectedComponent) return;
            const elem = selectedComponent.querySelector('p');
            if (elem) elem.style[property] = value;
        }

        function updateButtonStyle(property, value) {
            if (!selectedComponent) return;
            const btn = selectedComponent.querySelector('button');
            if (btn) btn.style[property] = value;
        }

        function updateButtonText(text) {
            if (!selectedComponent) return;
            const btn = selectedComponent.querySelector('button');
            if (btn) btn.textContent = text;
        }

        function updateButtonUrl(url) {
            if (!selectedComponent) return;
            const container = selectedComponent.querySelector('[style*="text-align: center"]');
            if (container) {
                const btn = container.querySelector('button');
                if (btn && url) {
                    const anchor = document.createElement('a');
                    anchor.href = url;
                    anchor.target = '_blank';
                    anchor.style.cssText = 'text-decoration: none;';
                    btn.parentNode.insertBefore(anchor, btn);
                    anchor.appendChild(btn);
                }
            }
        }

        function updateImage(url) {
            if (!selectedComponent) return;
            const img = selectedComponent.querySelector('img');
            if (img) img.src = url;
        }

        function updateImageAlt(alt) {
            if (!selectedComponent) return;
            const img = selectedComponent.querySelector('img');
            if (img) img.alt = alt;
        }

        function updateImageStyle(property, value) {
            if (!selectedComponent) return;
            const img = selectedComponent.querySelector('img');
            if (img) img.style[property] = value;
        }

        function updateImageAlignment(align) {
            if (!selectedComponent) return;
            const container = selectedComponent.querySelector('div');
            if (container) container.style.textAlign = align;
        }

        function updateImageLink(url) {
            if (!selectedComponent) return;
            const container = selectedComponent.querySelector('div');
            const img = container?.querySelector('img');
            if (img && url) {
                const anchor = document.createElement('a');
                anchor.href = url;
                anchor.target = '_blank';
                img.parentNode.insertBefore(anchor, img);
                anchor.appendChild(img);
            }
        }

        function updateFieldType(type) {
            if (!selectedComponent) return;
            const field = selectedComponent.querySelector('input, textarea');
            if (field) {
                if (type === 'textarea') {
                    const textarea = document.createElement('textarea');
                    textarea.placeholder = field.placeholder;
                    textarea.style.cssText = field.style.cssText;
                    textarea.className = field.className;
                    field.parentNode.replaceChild(textarea, field);
                } else {
                    if (field.tagName === 'TEXTAREA') {
                        const input = document.createElement('input');
                        input.type = type;
                        input.placeholder = field.placeholder;
                        input.style.cssText = field.style.cssText;
                        input.className = field.className;
                        field.parentNode.replaceChild(input, field);
                    } else {
                        field.type = type;
                    }
                }
            }
        }

        function updateFieldPlaceholder(placeholder) {
            if (!selectedComponent) return;
            const field = selectedComponent.querySelector('input, textarea');
            if (field) field.placeholder = placeholder;
        }

        function updateFieldStyle(property, value) {
            if (!selectedComponent) return;
            const field = selectedComponent.querySelector('input, textarea');
            if (field) field.style[property] = value;
        }

        function updateFieldRequired(required) {
            if (!selectedComponent) return;
            const field = selectedComponent.querySelector('input, textarea');
            if (field) field.required = required;
        }

        function updateDividerStyle(property, value) {
            if (!selectedComponent) return;
            const hr = selectedComponent.querySelector('hr');
            if (hr) hr.style[property] = value;
        }

        function updateSpacerHeight(height) {
            if (!selectedComponent) return;
            const spacer = selectedComponent.querySelector('div');
            if (spacer) spacer.style.height = height + 'px';
        }

        function updateVideoType(type) {
            if (!selectedComponent) return;
            selectedComponent.dataset.videoType = type;
        }

        function updateVideoUrl(url) {
            if (!selectedComponent) return;
            const iframe = selectedComponent.querySelector('iframe');
            const videoType = selectedComponent.dataset.videoType || 'youtube';
            let embedUrl = '';
            
            if (videoType === 'youtube') {
                embedUrl = url.includes('youtube.com') || url.includes('youtu.be') 
                    ? url.replace('watch?v=', 'embed/').replace('youtu.be/', 'youtube.com/embed/')
                    : `https://www.youtube.com/embed/${url}`;
            } else if (videoType === 'vimeo') {
                embedUrl = url.includes('vimeo.com')
                    ? url.replace('vimeo.com/', 'player.vimeo.com/video/')
                    : `https://player.vimeo.com/video/${url}`;
            } else {
                embedUrl = url;
            }
            
            if (iframe) iframe.src = embedUrl;
        }

        function updateVideoAutoplay(autoplay) {
            if (!selectedComponent) return;
            const iframe = selectedComponent.querySelector('iframe');
            if (iframe) {
                const url = new URL(iframe.src);
                if (autoplay) {
                    url.searchParams.set('autoplay', '1');
                } else {
                    url.searchParams.delete('autoplay');
                }
                iframe.src = url.toString();
            }
        }

        function updateVideoControls(controls) {
            if (!selectedComponent) return;
            const iframe = selectedComponent.querySelector('iframe');
            if (iframe) {
                const url = new URL(iframe.src);
                if (!controls) {
                    url.searchParams.set('controls', '0');
                } else {
                    url.searchParams.delete('controls');
                }
                iframe.src = url.toString();
            }
        }

        function updateCountdownTarget(datetime) {
            if (!selectedComponent) return;
            const countdown = selectedComponent.querySelector('.countdown-timer');
            if (countdown) countdown.dataset.targetDate = datetime;
        }

        function updateCountdownStyle(property, value) {
            if (!selectedComponent) return;
            const countdown = selectedComponent.querySelector('.countdown-timer, div');
            if (countdown) countdown.style[property] = value;
        }

        function updateCountdownFormat(format) {
            if (!selectedComponent) return;
            const countdown = selectedComponent.querySelector('.countdown-timer, div');
            if (countdown) countdown.dataset.format = format;
        }

        function updateSocialUrl(platform, url) {
            if (!selectedComponent) return;
            const socialContainer = selectedComponent.querySelector('.social-buttons, div');
            if (!socialContainer) return;
            
            const iconMap = {
                facebook: 'bi-facebook',
                twitter: 'bi-twitter',
                linkedin: 'bi-linkedin',
                instagram: 'bi-instagram'
            };
            
            let link = socialContainer.querySelector(`a i.${iconMap[platform]}`)?.parentElement;
            if (!link && url) {
                link = document.createElement('a');
                link.href = url;
                link.style.cssText = 'display: inline-block; width: 36px; height: 36px; line-height: 36px; background: #3b5998; color: white; border-radius: 50%; margin: 0 4px; text-decoration: none;';
                link.innerHTML = `<i class="bi ${iconMap[platform]}"></i>`;
                socialContainer.appendChild(link);
            } else if (link) {
                link.href = url;
            }
        }

        function updateSocialSize(size) {
            if (!selectedComponent) return;
            const links = selectedComponent.querySelectorAll('.social-buttons a, div a');
            links.forEach(link => {
                link.style.width = size + 'px';
                link.style.height = size + 'px';
                link.style.lineHeight = size + 'px';
            });
        }

        function updateSocialStyle(style) {
            if (!selectedComponent) return;
            const links = selectedComponent.querySelectorAll('.social-buttons a, div a');
            const radiusMap = { circle: '50%', square: '0', rounded: '8px' };
            links.forEach(link => link.style.borderRadius = radiusMap[style]);
        }

        function updateCouponCode(code) {
            if (!selectedComponent) return;
            const couponDiv = selectedComponent.querySelector('.coupon-code div, div div');
            if (couponDiv) {
                couponDiv.textContent = code;
                const parent = selectedComponent.querySelector('.coupon-code, div');
                if (parent) parent.dataset.code = code;
            }
        }

        function updateCouponStyle(property, value) {
            if (!selectedComponent) return;
            const couponDiv = selectedComponent.querySelector('.coupon-code div, div div');
            if (couponDiv) couponDiv.style[property] = value;
        }

        function updateCouponCopy(enable) {
            if (!selectedComponent) return;
            const coupon = selectedComponent.querySelector('.coupon-code, div');
            if (coupon) {
                if (enable) {
                    coupon.style.cursor = 'pointer';
                    coupon.onclick = function() {
                        const code = this.dataset.code || this.textContent.trim();
                        navigator.clipboard.writeText(code).then(() => {
                            alert('Coupon code copied: ' + code);
                        });
                    };
                } else {
                    coupon.style.cursor = 'default';
                    coupon.onclick = null;
                }
            }
        }

        function updateHtmlContent(html) {
            if (!selectedComponent) return;
            const htmlContainer = selectedComponent.querySelector('.custom-html, div');
            if (htmlContainer) {
                const sanitize = document.getElementById('htmlSanitize')?.checked;
                htmlContainer.innerHTML = sanitize ? html.replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '') : html;
            }
        }

        function updateColumnCount(count) {
            if (!selectedComponent) return;
            const container = selectedComponent.querySelector('div');
            if (container) {
                container.style.gridTemplateColumns = `repeat(${count}, 1fr)`;
                const currentCols = container.children.length;
                if (count > currentCols) {
                    for (let i = currentCols; i < count; i++) {
                        const col = document.createElement('div');
                        col.style.cssText = 'padding: 20px; background: #f3f4f6; border-radius: 8px;';
                        col.textContent = `Column ${i + 1}`;
                        container.appendChild(col);
                    }
                } else if (count < currentCols) {
                    while (container.children.length > count) {
                        container.removeChild(container.lastChild);
                    }
                }
            }
        }

        function updateColumnGap(gap) {
            if (!selectedComponent) return;
            const container = selectedComponent.querySelector('div');
            if (container) container.style.gap = gap + 'px';
        }

        function updateColumnRatio(ratio) {
            if (!selectedComponent) return;
            const container = selectedComponent.querySelector('div');
            if (container) {
                const ratioMap = {
                    'equal': '1fr 1fr',
                    '2-1': '2fr 1fr',
                    '1-2': '1fr 2fr',
                    '3-1': '3fr 1fr'
                };
                container.style.gridTemplateColumns = ratioMap[ratio];
            }
        }

        function moveUp(id) {
            const component = document.querySelector(`[data-component-id="${id}"]`);
            if (component && component.previousElementSibling) component.parentNode.insertBefore(component, component.previousElementSibling);
        }

        function moveDown(id) {
            const component = document.querySelector(`[data-component-id="${id}"]`);
            if (component && component.nextElementSibling) component.parentNode.insertBefore(component.nextElementSibling, component);
        }

        function deleteComponent(id) {
            const component = document.querySelector(`[data-component-id="${id}"]`);
            if (component && confirm('Delete this component?')) {
                component.remove();
                document.getElementById('propertiesPanel').innerHTML = '<div class="empty-state" style="padding-top: 100px;"><i class="bi bi-sliders"></i><p>Select a block to edit properties</p></div>';
            }
        }

        // New block update functions
        function updateHeadingLevel(level) {
            if (!selectedComponent) return;
            const oldHeading = selectedComponent.querySelector('h1, h2, h3, h4');
            if (oldHeading) {
                const newHeading = document.createElement(level);
                newHeading.innerHTML = oldHeading.innerHTML;
                newHeading.style.cssText = oldHeading.style.cssText;
                newHeading.contentEditable = 'true';
                oldHeading.parentNode.replaceChild(newHeading, oldHeading);
            }
        }

        function updateHeadingStyle(property, value) {
            if (!selectedComponent) return;
            const heading = selectedComponent.querySelector('h1, h2, h3, h4');
            if (heading) heading.style[property] = value;
        }

        function updateIcon(iconClass) {
            if (!selectedComponent) return;
            const icon = selectedComponent.querySelector('i');
            if (icon) {
                icon.className = `bi ${iconClass}`;
            }
        }

        function updateIconStyle(property, value) {
            if (!selectedComponent) return;
            const icon = selectedComponent.querySelector('i');
            if (icon) icon.style[property] = value;
        }

        function updateIconAlignment(align) {
            if (!selectedComponent) return;
            const container = selectedComponent.querySelector('div');
            if (container) container.style.textAlign = align;
        }

        function updateListType(type) {
            if (!selectedComponent) return;
            const oldList = selectedComponent.querySelector('ul, ol');
            if (oldList) {
                const newList = document.createElement(type);
                newList.innerHTML = oldList.innerHTML;
                newList.style.cssText = oldList.style.cssText;
                oldList.parentNode.replaceChild(newList, oldList);
            }
        }

        function updateListStyle(property, value) {
            if (!selectedComponent) return;
            const list = selectedComponent.querySelector('ul, ol');
            if (list) list.style[property] = value;
        }

        function updateAlertType(type) {
            if (!selectedComponent) return;
            const alert = selectedComponent.querySelector('div');
            const colorMap = {
                info: { bg: '#dbeafe', border: '#2563eb', text: '#1e40af' },
                success: { bg: '#d1fae5', border: '#10b981', text: '#065f46' },
                warning: { bg: '#fef3c7', border: '#f59e0b', text: '#92400e' },
                error: { bg: '#fee2e2', border: '#ef4444', text: '#991b1b' }
            };
            if (alert && colorMap[type]) {
                alert.style.background = colorMap[type].bg;
                alert.style.borderLeftColor = colorMap[type].border;
                alert.style.color = colorMap[type].text;
            }
        }

        function updateAlertMessage(message) {
            if (!selectedComponent) return;
            const alert = selectedComponent.querySelector('div');
            if (alert) {
                const hasIcon = alert.innerHTML.includes('<strong>');
                if (hasIcon) {
                    const match = alert.innerHTML.match(/<strong>.*?<\/strong>/);
                    if (match) alert.innerHTML = match[0] + ' ' + message;
                } else {
                    alert.innerHTML = message;
                }
            }
        }

        function updateAlertIcon(show) {
            if (!selectedComponent) return;
            const alert = selectedComponent.querySelector('div');
            if (alert) {
                if (show && !alert.innerHTML.includes('<strong>')) {
                    alert.innerHTML = '<strong>Info:</strong> ' + alert.textContent;
                } else if (!show && alert.innerHTML.includes('<strong>')) {
                    alert.innerHTML = alert.textContent.replace(/^\w+:\s*/, '');
                }
            }
        }

        function updateProgressValue(value) {
            if (!selectedComponent) return;
            const fill = selectedComponent.querySelector('.progress-fill, div div');
            if (fill) {
                fill.style.width = value + '%';
                fill.textContent = value + '%';
                fill.dataset.progress = value;
            }
        }

        function updateProgressColor(color) {
            if (!selectedComponent) return;
            const fill = selectedComponent.querySelector('.progress-fill, div div');
            if (fill) fill.style.background = `linear-gradient(90deg, ${color} 0%, ${color} 100%)`;
        }

        function updateProgressBgColor(color) {
            if (!selectedComponent) return;
            const container = selectedComponent.querySelector('div > div');
            if (container) container.style.background = color;
        }

        function updateProgressHeight(height) {
            if (!selectedComponent) return;
            const container = selectedComponent.querySelector('div > div');
            if (container) container.style.height = height + 'px';
        }

        function updateProgressLabel(show) {
            if (!selectedComponent) return;
            const fill = selectedComponent.querySelector('.progress-fill, div div');
            if (fill) fill.textContent = show ? (fill.dataset.progress || '70') + '%' : '';
        }

        function updateRatingValue(value) {
            if (!selectedComponent) return;
            const container = selectedComponent.querySelector('div');
            if (container) {
                const stars = container.querySelectorAll('i');
                stars.forEach((star, index) => {
                    star.className = index < value ? 'bi bi-star-fill' : 'bi bi-star';
                });
            }
        }

        function updateRatingSize(size) {
            if (!selectedComponent) return;
            const container = selectedComponent.querySelector('div');
            if (container) container.style.fontSize = size + 'px';
        }

        function updateRatingColor(color) {
            if (!selectedComponent) return;
            const container = selectedComponent.querySelector('div');
            if (container) container.style.color = color;
        }

        function updateTestimonialQuote(text) {
            if (!selectedComponent) return;
            const quote = selectedComponent.querySelector('p');
            if (quote) quote.textContent = `"${text}"`;
        }

        function updateTestimonialAuthor(name) {
            if (!selectedComponent) return;
            const author = selectedComponent.querySelector('div > div > div:first-child');
            if (author) author.textContent = name;
        }

        function updateTestimonialTitle(title) {
            if (!selectedComponent) return;
            const titleElem = selectedComponent.querySelector('div > div > div:last-child');
            if (titleElem) titleElem.textContent = title;
        }

        function updateTestimonialImage(url) {
            if (!selectedComponent) return;
            const img = selectedComponent.querySelector('img');
            if (img) img.src = url;
        }

        function updateTestimonialBg(color) {
            if (!selectedComponent) return;
            const container = selectedComponent.querySelector('div');
            if (container) container.style.background = color;
        }

        function updateBadgeText(text) {
            if (!selectedComponent) return;
            const badge = selectedComponent.querySelector('span');
            if (badge) badge.textContent = text;
        }

        function updateBadgeStyle(property, value) {
            if (!selectedComponent) return;
            const badge = selectedComponent.querySelector('span');
            if (badge) badge.style[property] = value;
        }

        function updateBadgeSize(size) {
            if (!selectedComponent) return;
            const badge = selectedComponent.querySelector('span');
            if (badge) {
                const sizes = { small: '12px', medium: '14px', large: '16px' };
                const padding = { small: '6px 12px', medium: '8px 16px', large: '10px 20px' };
                badge.style.fontSize = sizes[size];
                badge.style.padding = padding[size];
            }
        }

        function updateCardTitle(title) {
            if (!selectedComponent) return;
            const h3 = selectedComponent.querySelector('h3');
            if (h3) h3.textContent = title;
        }

        function updateCardContent(content) {
            if (!selectedComponent) return;
            const p = selectedComponent.querySelector('p');
            if (p) p.textContent = content;
        }

        function updateCardButtonText(text) {
            if (!selectedComponent) return;
            const btn = selectedComponent.querySelector('button');
            if (btn) btn.textContent = text;
        }

        function updateCardBg(color) {
            if (!selectedComponent) return;
            const card = selectedComponent.querySelector('div');
            if (card) card.style.background = color;
        }

        function updateCardShadow(show) {
            if (!selectedComponent) return;
            const card = selectedComponent.querySelector('div');
            if (card) card.style.boxShadow = show ? '0 4px 6px -1px rgba(0, 0, 0, 0.1)' : 'none';
        }

        function updateFormButtonText(text) {
            if (!selectedComponent) return;
            const btn = selectedComponent.querySelector('button[type="submit"]');
            if (btn) btn.textContent = text;
        }

        function updateFormBg(color) {
            if (!selectedComponent) return;
            const form = selectedComponent.querySelector('form');
            if (form) form.style.background = color;
        }

        function updateFormAction(url) {
            if (!selectedComponent) return;
            const form = selectedComponent.querySelector('form');
            if (form) form.action = url;
        }

        function updateAccordionBorder(color) {
            if (!selectedComponent) return;
            const accordion = selectedComponent.querySelector('div > div');
            if (accordion) accordion.style.borderColor = color;
        }

        function updateAccordionHeaderBg(color) {
            if (!selectedComponent) return;
            const headers = selectedComponent.querySelectorAll('div > div > div:nth-child(odd)');
            headers.forEach(header => header.style.background = color);
        }

        function updateAccordionMultiple(allow) {
            if (!selectedComponent) return;
            selectedComponent.dataset.multipleOpen = allow;
        }

        function updateMapLocation(location) {
            if (!selectedComponent) return;
            const iframe = selectedComponent.querySelector('iframe');
            if (iframe && location) {
                const encodedLocation = encodeURIComponent(location);
                iframe.src = `https://www.google.com/maps/embed/v1/place?key=YOUR_API_KEY&q=${encodedLocation}`;
            }
        }

        function updateMapHeight(height) {
            if (!selectedComponent) return;
            const iframe = selectedComponent.querySelector('iframe');
            if (iframe) iframe.height = height;
        }

        function updateMapZoom(zoom) {
            if (!selectedComponent) return;
            const iframe = selectedComponent.querySelector('iframe');
            if (iframe) {
                const url = new URL(iframe.src);
                url.searchParams.set('zoom', zoom);
                iframe.src = url.toString();
            }
        }

        document.getElementById('triggerSelect')?.addEventListener('change', function() {
            document.getElementById('delayGroup').style.display = this.value === 'OnTimeDelay' ? 'block' : 'none';
        });

        document.getElementById('previewBtn').addEventListener('click', function() {
            document.getElementById('previewContent').innerHTML = document.getElementById('dropzone').innerHTML;
            new bootstrap.Modal(document.getElementById('previewModal')).show();
        });

        document.getElementById('saveBtn').addEventListener('click', async function() {
            this.disabled = true;
            this.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving...';
            const data = {
                id: popupId,
                content: JSON.stringify({ html: document.getElementById('dropzone').innerHTML }),
                targetingRules: JSON.stringify({ 
                    urls: (document.getElementById('urlTargeting')?.value || '').split('\n').filter(u => u.trim()), 
                    webhook: document.getElementById('webhookUrl')?.value || '',
                    ...integrationConfigs  // Include Zapier, Email, and Webhook integrations
                }),
                trigger: document.getElementById('triggerSelect')?.value || '@Model.Trigger',
                frequency: document.getElementById('frequencySelect')?.value || '@Model.Frequency',
                delayMs: parseInt(document.getElementById('delayInput')?.value || '0') * 1000,
                showOnMobile: document.getElementById('showMobile')?.checked ?? true,
                showOnDesktop: document.getElementById('showDesktop')?.checked ?? true
            };

            try {
                const response = await fetch(`/Popup/SaveDesign?id=${popupId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                if (response.ok) {
                    this.innerHTML = '<i class="bi bi-check2"></i> Saved!';
                    setTimeout(() => { this.innerHTML = '<i class="bi bi-check2"></i> Save'; this.disabled = false; }, 2000);
                } else {
                    alert('Error saving');
                    this.innerHTML = '<i class="bi bi-check2"></i> Save';
                    this.disabled = false;
                }
            } catch (error) {
                alert('Error: ' + error);
                this.innerHTML = '<i class="bi bi-check2"></i> Save';
                this.disabled = false;
            }
        });

        document.getElementById('blockSearch')?.addEventListener('input', function() {
            const query = this.value.toLowerCase();
            document.querySelectorAll('.block-item').forEach(block => {
                block.style.display = block.querySelector('.block-name').textContent.toLowerCase().includes(query) ? 'flex' : 'none';
            });
        });

        // Integration configuration storage
        let integrationConfigs = {
            email: {},
            zapier: {},
            webhook: {}
        };

        // Load saved integration configs
        try {
            const targetingRules = @Html.Raw(Json.Serialize(Model.TargetingRules ?? "{}"));
            if (targetingRules && typeof targetingRules === 'string') {
                const parsed = JSON.parse(targetingRules);
                if (parsed.integrations) {
                    integrationConfigs = parsed.integrations;
                    updateIntegrationStatus();
                }
                if (parsed.webhook) {
                    document.getElementById('webhookUrl').value = parsed.webhook;
                }
            }
        } catch (e) {
            console.error('Error loading integration configs:', e);
        }

        function openEmailModal() {
            new bootstrap.Modal(document.getElementById('emailModal')).show();
            if (integrationConfigs.email) {
                document.getElementById('emailProvider').value = integrationConfigs.email.provider || '';
                document.getElementById('emailApiKey').value = integrationConfigs.email.apiKey || '';
                document.getElementById('emailListId').value = integrationConfigs.email.listId || '';
                document.getElementById('emailDoubleOptIn').checked = integrationConfigs.email.doubleOptIn || false;
            }
        }

        function openZapierModal() {
            new bootstrap.Modal(document.getElementById('zapierModal')).show();
            if (integrationConfigs.zapier) {
                document.getElementById('zapierWebhook').value = integrationConfigs.zapier.webhookUrl || '';
                document.getElementById('zapierEvent').value = integrationConfigs.zapier.event || 'submission';
                document.getElementById('zapierEnabled').checked = integrationConfigs.zapier.enabled !== false;
            }
        }

        function openWebhookModal() {
            new bootstrap.Modal(document.getElementById('webhookModal')).show();
            if (integrationConfigs.webhook) {
                document.getElementById('webhookUrl').value = integrationConfigs.webhook.url || '';
                document.getElementById('webhookMethod').value = integrationConfigs.webhook.method || 'POST';
                document.getElementById('webhookHeaders').value = integrationConfigs.webhook.headers || '';
                document.getElementById('webhookEvent').value = integrationConfigs.webhook.event || 'submission';
                document.getElementById('webhookRetry').checked = integrationConfigs.webhook.retry !== false;
                document.getElementById('webhookEnabled').checked = integrationConfigs.webhook.enabled !== false;
            }
        }

        function saveEmailConfig() {
            integrationConfigs.email = {
                provider: document.getElementById('emailProvider').value,
                apiKey: document.getElementById('emailApiKey').value,
                listId: document.getElementById('emailListId').value,
                doubleOptIn: document.getElementById('emailDoubleOptIn').checked,
                enabled: true
            };
            bootstrap.Modal.getInstance(document.getElementById('emailModal')).hide();
            updateIntegrationStatus();
            alert('Email service configuration saved! Remember to click Save button to persist changes.');
        }

        function saveZapierConfig() {
            const webhook = document.getElementById('zapierWebhook').value;
            if (!webhook) {
                alert('Please enter a Zapier webhook URL');
                return;
            }
            integrationConfigs.zapier = {
                webhookUrl: webhook,
                event: document.getElementById('zapierEvent').value,
                enabled: document.getElementById('zapierEnabled').checked
            };
            bootstrap.Modal.getInstance(document.getElementById('zapierModal')).hide();
            updateIntegrationStatus();
            alert('Zapier integration saved! Remember to click Save button to persist changes.');
        }

        function saveWebhookConfig() {
            const url = document.getElementById('webhookUrl').value;
            if (!url) {
                alert('Please enter a webhook URL');
                return;
            }
            integrationConfigs.webhook = {
                url: url,
                method: document.getElementById('webhookMethod').value,
                headers: document.getElementById('webhookHeaders').value,
                event: document.getElementById('webhookEvent').value,
                retry: document.getElementById('webhookRetry').checked,
                enabled: document.getElementById('webhookEnabled').checked
            };
            bootstrap.Modal.getInstance(document.getElementById('webhookModal')).hide();
            updateIntegrationStatus();
            alert('Webhook configuration saved! Remember to click Save button to persist changes.');
        }

        function testWebhook() {
            const url = document.getElementById('webhookUrl').value;
            if (!url) {
                alert('Please enter a webhook URL first');
                return;
            }
            alert('Test payload sent to: ' + url + '\n\nCheck your server logs for the incoming request.');
        }

        function updateIntegrationStatus() {
            if (integrationConfigs.email && integrationConfigs.email.enabled) {
                document.getElementById('emailStatus').innerHTML = '<i class="bi bi-check-circle-fill text-success me-1"></i>Connected to ' + integrationConfigs.email.provider;
            }
            if (integrationConfigs.zapier && integrationConfigs.zapier.enabled) {
                document.getElementById('zapierStatus').innerHTML = '<i class="bi bi-check-circle-fill text-success me-1"></i>Active';
            }
            if (integrationConfigs.webhook && integrationConfigs.webhook.enabled) {
                document.getElementById('webhookStatus').innerHTML = '<i class="bi bi-check-circle-fill text-success me-1"></i>Configured';
            }
        }

        // Update save button to include integrations
        const originalSaveBtn = document.getElementById('saveBtn');
        const originalOnClick = originalSaveBtn.onclick;
        document.getElementById('saveBtn').onclick = async function() {
            this.disabled = true;
            this.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving...';
            const data = {
                id: popupId,
                content: JSON.stringify({ html: document.getElementById('dropzone').innerHTML }),
                targetingRules: JSON.stringify({ 
                    urls: (document.getElementById('urlTargeting')?.value || '').split('\n').filter(u => u.trim()),
                    integrations: integrationConfigs
                }),
                trigger: document.getElementById('triggerSelect')?.value || '@Model.Trigger',
                frequency: document.getElementById('frequencySelect')?.value || '@Model.Frequency',
                delayMs: parseInt(document.getElementById('delayInput')?.value || '0') * 1000,
                showOnMobile: document.getElementById('showMobile')?.checked ?? true,
                showOnDesktop: document.getElementById('showDesktop')?.checked ?? true
            };

            try {
                const response = await fetch(`/Popup/SaveDesign?id=${popupId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                if (response.ok) {
                    this.innerHTML = '<i class="bi bi-check2"></i> Saved!';
                    setTimeout(() => { this.innerHTML = '<i class="bi bi-check2"></i> Save'; this.disabled = false; }, 2000);
                } else {
                    alert('Error saving');
                    this.innerHTML = '<i class="bi bi-check2"></i> Save';
                    this.disabled = false;
                }
            } catch (error) {
                alert('Error: ' + error);
                this.innerHTML = '<i class="bi bi-check2"></i> Save';
                this.disabled = false;
            }
        };
    </script>
</body>
</html>
