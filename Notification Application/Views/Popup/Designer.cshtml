        function renderViewsList() {
            const viewsList = document.getElementById('viewsList');
            const sortedViews = Object.values(popupViews).sort((a, b) => a.order - b.order);
            
            viewsList.innerHTML = sortedViews.map(view => `
                <div class="list-group-item d-flex align-items-center justify-content-between" data-view-type="${view.type}" draggable="true">
                    <div class="d-flex align-items-center gap-3 flex-grow-1">
                        <i class="bi bi-grip-vertical text-muted" style="cursor: move;"></i>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" ${view.enabled ? 'checked' : ''} 
                                   onchange="toggleView('${view.type}', this.checked)">
                        </div>
                        <div class="flex-grow-1">
                            <strong>${view.name}</strong>
                            <div class="text-muted small">
                                Trigger: ${view.trigger} ${view.captureLead ? '• Captures Lead' : ''}
                                ${view.nextView ? '→ ' + view.nextView : ''}
                            </div>
                        </div>
                    </div>
                    <div class="btn-group">
                        <button class="btn btn-sm btn-outline-primary" onclick="editView('${view.type}')">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="switchToView('${view.type}')">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>
            `).join('');

            // Initialize Sortable for drag & drop
            new Sortable(viewsList, {
                animation: 150,
                handle: '.bi-grip-vertical',
                onEnd: function(evt) {
                    updateViewsOrder();
                }
            });
        }

        function toggleView(viewType, enabled) {
            if (popupViews[viewType]) {
                popupViews[viewType].enabled = enabled;
                updateViewTypeSelect();
            }
        }

        function editView(viewType) {
            currentEditingView = viewType;
            const view = popupViews[viewType];
            
            document.getElementById('currentViewName').value = view.name;
            document.getElementById('currentViewTrigger').value = view.trigger;
            document.getElementById('currentViewTimeout').value = view.timeout || 3;
            document.getElementById('currentViewCaptureLead').checked = view.captureLead || false;
            document.getElementById('currentViewNext').value = view.nextView || '';
            
            document.getElementById('timeoutGroup').style.display = 
                view.trigger === 'timeout' ? 'block' : 'none';
            
            document.getElementById('viewConfigSection').style.display = 'block';
            
            // Update trigger change handler
            document.getElementById('currentViewTrigger').onchange = function() {
                document.getElementById('timeoutGroup').style.display = 
                    this.value === 'timeout' ? 'block' : 'none';
            };
        }

        function switchToView(viewType) {
            document.getElementById('viewTypeSelect').value = viewType;
            document.getElementById('viewTypeSelect').dispatchEvent(new Event('change'));
            bootstrap.Modal.getInstance(document.getElementById('viewManagerModal')).hide();
        }

        function updateViewsOrder() {
            const items = document.querySelectorAll('#viewsList .list-group-item');
            items.forEach((item, index) => {
                const viewType = item.dataset.viewType;
                if (popupViews[viewType]) {
                    popupViews[viewType].order = index + 1;
                }
            });
        }

        function addCustomView() {
            const viewName = prompt('Enter custom view name:');
            if (!viewName) return;
            
            const viewType = viewName.toLowerCase().replace(/\s+/g, '_');
            
            if (popupViews[viewType]) {
                alert('A view with this name already exists');
                return;
            }
            
            popupViews[viewType] = {
                name: viewName,
                type: viewType,
                enabled: true,
                trigger: 'manual',
                captureLead: false,
                order: Object.keys(popupViews).length + 1
            };
            
            renderViewsList();
            updateViewTypeSelect();
        }

        function updateViewTypeSelect() {
            const select = document.getElementById('viewTypeSelect');
            const currentValue = select.value;
            
            select.innerHTML = Object.values(popupViews)
                .filter(v => v.enabled)
                .sort((a, b) => a.order - b.order)
                .map(v => `<option value="${v.type}">${v.name}</option>`)
                .join('');
            
            // Restore selection if still available
            if ([...select.options].some(opt => opt.value === currentValue)) {
                select.value = currentValue;
            }
        }

        function saveViewConfiguration() {
            if (currentEditingView && popupViews[currentEditingView]) {
                const view = popupViews[currentEditingView];
                view.trigger = document.getElementById('currentViewTrigger').value;
                view.timeout = parseInt(document.getElementById('currentViewTimeout').value);
                view.captureLead = document.getElementById('currentViewCaptureLead').checked;
                view.nextView = document.getElementById('currentViewNext').value;
                
                renderViewsList();
                document.getElementById('viewConfigSection').style.display = 'none';
                currentEditingView = null;
                
                alert('View configuration saved! Remember to click the main Save button to persist changes.');
            }
        }

        // Update save button to include views configuration
        const originalSaveBtn = document.getElementById('saveBtn');
        const originalOnClick = originalSaveBtn.onclick;
        document.getElementById('saveBtn').onclick = async function() {
            this.disabled = true;
            this.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving...';
            const data = {
                id: popupId,
                content: JSON.stringify({ html: getCleanHTML() }),
                targetingRules: JSON.stringify({ 
                    urls: (document.getElementById('urlTargeting')?.value || '').split('\n').filter(u => u.trim()),
                    integrations: integrationConfigs,
                    views: popupViews
                }),
                trigger: document.getElementById('triggerSelect')?.value || '@Model.Trigger',
                frequency: document.getElementById('frequencySelect')?.value || '@Model.Frequency',
                delayMs: parseInt(document.getElementById('delayInput')?.value || '0') * 1000,
                showOnMobile: document.getElementById('showMobile')?.checked ?? true,
                showOnDesktop: document.getElementById('showDesktop')?.checked ?? true
            };

            try {
                const response = await fetch(`/Popup/SaveDesign?id=${popupId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                if (response.ok) {
                    this.innerHTML = '<i class="bi bi-check2"></i> Saved!';
                    setTimeout(() => { this.innerHTML = '<i class="bi bi-check2"></i> Save'; this.disabled = false; }, 2000);
                } else {
                    alert('Error saving');
                    this.innerHTML = '<i class="bi bi-check2"></i> Save';
                    this.disabled = false;
                }
            } catch (error) {
                alert('Error: ' + error);
                this.innerHTML = '<i class="bi bi-check2"></i> Save';
                this.disabled = false;
            }
        };

        // Display Rules Functions
        let conditionCounter = 1;

        // Category switching
        document.querySelectorAll('.category-item, .category-subitem').forEach(item => {
            item.addEventListener('click', function() {
                document.querySelectorAll('.category-item').forEach(cat => cat.classList.remove('active'));
                
                if (this.classList.contains('category-item')) {
                    this.classList.add('active');
                }
                
                const category = this.dataset.category;
                document.querySelectorAll('.rules-category').forEach(cat => cat.style.display = 'none');
                const targetCategory = document.getElementById('category-' + category);
                if (targetCategory) {
                    targetCategory.style.display = 'block';
                }
            });
        });

        // Add condition function
        function addCondition() {
            conditionCounter++;
            const conditionHtml = `
                <div class="condition-row" data-id="${conditionCounter}">
                    <div class="condition-drag"><i class="bi bi-grip-vertical"></i></div>
                    <select class="condition-field">
                        <option value="url-path">current URL path</option>
                        <option value="page-targeting">Page Targeting</option>
                        <option value="exit-intent">Exit Intent</option>
                        <option value="new-visitor">New Visitor</option>
                        <option value="returning-visitor">Returning Visitor</option>
                        <option value="device">Visitor's Device</option>
                        <option value="location">Physical Location</option>
                        <option value="referral">Referral Source</option>
                        <option value="browser">Visitor's Browser</option>
                        <option value="cookie">Cookie Targeting</option>
                    </select>
                    <select class="condition-operator">
                        <option value="is-any">is any page</option>
                        <option value="is-homepage">is the homepage</option>
                        <option value="not-homepage">is not the homepage</option>
                        <option value="exactly-matches">exactly matches</option>
                        <option value="not-exactly">does not exactly match</option>
                        <option value="contains">contains</option>
                        <option value="not-contain">does not contain</option>
                        <option value="starts-with">starts with</option>
                        <option value="not-start">does not start with</option>
                        <option value="ends-with">ends with</option>
                        <option value="not-end">does not end with</option>
                    </select>
                    <div class="condition-actions">
                        <button class="condition-btn" title="Duplicate" onclick="duplicateCondition(this)">
                            <i class="bi bi-files"></i>
                        </button>
                        <button class="condition-btn" title="View" onclick="viewCondition(this)">
                            <i class="bi bi-eye"></i>
                        </button>
                        <button class="condition-btn" title="Delete" onclick="deleteCondition(this)">
                            <i class="bi bi-trash"></i>
                        </button>
                        <button class="condition-and" onclick="addCondition()">And</button>
                    </div>
                </div>
            `;
            document.getElementById('conditionsList').insertAdjacentHTML('beforeend', conditionHtml);
        }

        // Duplicate condition
        function duplicateCondition(btn) {
            const row = btn.closest('.condition-row');
            conditionCounter++;
            const newRow = row.cloneNode(true);
            newRow.dataset.id = conditionCounter;
            row.parentNode.insertBefore(newRow, row.nextSibling);
        }

        // View condition
        function viewCondition(btn) {
            const row = btn.closest('.condition-row');
            const field = row.querySelector('.condition-field').value;
            const operator = row.querySelector('.condition-operator').value;
            alert(`Condition:\nField: ${field}\nOperator: ${operator}`);
        }

        // Delete condition
        function deleteCondition(btn) {
            const conditionsList = document.getElementById('conditionsList');
            if (conditionsList.children.length > 1) {
                btn.closest('.condition-row').remove();
            } else {
                alert('You must have at least one condition.');
            }
        }

        // Delete all conditions
        document.getElementById('deleteAllConditions')?.addEventListener('click', function() {
            if (confirm('Are you sure you want to delete all conditions?')) {
                const conditionsList = document.getElementById('conditionsList');
                conditionsList.innerHTML = `
                    <div class="condition-row" data-id="1">
                        <div class="condition-drag"><i class="bi bi-grip-vertical"></i></div>
                        <select class="condition-field">
                            <option value="url-path">current URL path</option>
                            <option value="page-targeting">Page Targeting</option>
                            <option value="exit-intent">Exit Intent</option>
                            <option value="new-visitor">New Visitor</option>
                            <option value="returning-visitor">Returning Visitor</option>
                            <option value="device">Visitor's Device</option>
                        </select>
                        <select class="condition-operator">
                            <option value="is-any">is any page</option>
                            <option value="contains">contains</option>
                            <option value="equals">equals</option>
                        </select>
                        <div class="condition-actions">
                            <button class="condition-btn" title="Duplicate" onclick="duplicateCondition(this)">
                                <i class="bi bi-files"></i>
                            </button>
                            <button class="condition-btn" title="View" onclick="viewCondition(this)">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button class="condition-btn" title="Delete" onclick="deleteCondition(this)">
                                <i class="bi bi-trash"></i>
                            </button>
                            <button class="condition-and" onclick="addCondition()">And</button>
                        </div>
                    </div>
                `;
                conditionCounter = 1;
            }
        });

        // Add rule to conditions
        function addRuleToConditions(ruleValue, ruleName) {
            conditionCounter++;
            const conditionHtml = `
                <div class="condition-row" data-id="${conditionCounter}">
                    <div class="condition-drag"><i class="bi bi-grip-vertical"></i></div>
                    <select class="condition-field">
                        <option value="${ruleValue}" selected>${ruleName}</option>
                        <option value="url-path">current URL path</option>
                        <option value="page-targeting">Page Targeting</option>
                        <option value="exit-intent">Exit Intent</option>
                        <option value="new-visitor">New Visitor</option>
                        <option value="returning-visitor">Returning Visitor</option>
                        <option value="device">Visitor's Device</option>
                    </select>
                    <select class="condition-operator">
                        <option value="is-any">is any page</option>
                        <option value="contains">contains</option>
                        <option value="equals">equals</option>
                    </select>
                    <div class="condition-actions">
                        <button class="condition-btn" title="Duplicate" onclick="duplicateCondition(this)">
                            <i class="bi bi-files"></i>
                        </button>
                        <button class="condition-btn" title="View" onclick="viewCondition(this)">
                            <i class="bi bi-eye"></i>
                        </button>
                        <button class="condition-btn" title="Delete" onclick="deleteCondition(this)">
                            <i class="bi bi-trash"></i>
                        </button>
                        <button class="condition-and" onclick="addCondition()">And</button>
                    </div>
                </div>
            `;
            document.getElementById('conditionsList').insertAdjacentHTML('beforeend', conditionHtml);
            
            // Show selected badge
            const ruleItem = document.querySelector(`[data-rule="${ruleValue}"]`);
            if (ruleItem) {
                const badge = ruleItem.querySelector('.rule-selected-badge');
                if (badge) badge.style.display = 'inline-block';
            }
        }

        // Search conditions
        document.getElementById('searchConditions')?.addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            document.querySelectorAll('.rule-item').forEach(item => {
                const name = item.querySelector('.rule-item-name').textContent.toLowerCase();
                const desc = item.querySelector('.rule-item-description').textContent.toLowerCase();
                item.style.display = (name.includes(searchTerm) || desc.includes(searchTerm)) ? '' : 'none';
            });
        });

        // Save ruleset
        document.getElementById('saveRuleset')?.addEventListener('click', function() {
            const conditions = [];
            document.querySelectorAll('.condition-row').forEach(row => {
                conditions.push({
                    id: row.dataset.id,
                    field: row.querySelector('.condition-field').value,
                    operator: row.querySelector('.condition-operator').value
                });
            });
            
            const ruleset = {
                logic: document.getElementById('conditionLogic').value,
                view: document.getElementById('viewTypeSelect').value,
                conditions: conditions
            };
            
            localStorage.setItem('displayRuleset_' + popupId, JSON.stringify(ruleset));
            alert('Ruleset saved successfully!');
        });

        // Import ruleset
        document.getElementById('importRuleset')?.addEventListener('click', function() {
            const saved = localStorage.getItem('displayRuleset_' + popupId);
            if (!saved) {
                alert('No saved ruleset found for this popup.');
                return;
            }
            
            const ruleset = JSON.parse(saved);
            document.getElementById('conditionLogic').value = ruleset.logic;
            document.getElementById('viewTypeSelect').value = ruleset.view;
            
            // Clear existing conditions
            document.getElementById('conditionsList').innerHTML = '';
            
            // Add saved conditions
            ruleset.conditions.forEach((cond, index) => {
                const conditionHtml = `
                    <div class="condition-row" data-id="${cond.id}">
                        <div class="condition-drag"><i class="bi bi-grip-vertical"></i></div>
                        <select class="condition-field">
                            <option value="${cond.field}" selected>${cond.field}</option>
                            <option value="url-path">current URL path</option>
                            <option value="page-targeting">Page Targeting</option>
                        </select>
                        <select class="condition-operator">
                            <option value="${cond.operator}" selected>${cond.operator}</option>
                            <option value="is-any">is any page</option>
                            <option value="contains">contains</option>
                        </select>
                        <div class="condition-actions">
                            <button class="condition-btn" title="Duplicate" onclick="duplicateCondition(this)">
                                <i class="bi bi-files"></i>
                            </button>
                            <button class="condition-btn" title="View" onclick="viewCondition(this)">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button class="condition-btn" title="Delete" onclick="deleteCondition(this)">
                                <i class="bi bi-trash"></i>
                            </button>
                            <button class="condition-and" onclick="addCondition()">And</button>
                        </div>
                    </div>
                `;
                document.getElementById('conditionsList').insertAdjacentHTML('beforeend', conditionHtml);
            });
            
            conditionCounter = Math.max(...ruleset.conditions.map(c => parseInt(c.id)));
            alert('Ruleset imported successfully!');
        });

        // ============================================
        // VIEWS MANAGEMENT FUNCTIONS
        // ============================================

        let viewsData = [
            {
                id: 1,
                type: 'initial',
                name: 'Initial View',
                isDefault: true,
                showWhen: 'always',
                nextViewOnSubmit: null,
                captureLeads: true,
                content: '',
                order: 1
            }
        ];
        let nextViewId = 2;

        function addNewView() {
            const newView = {
                id: nextViewId++,
                type: 'custom',
                name: `View ${nextViewId - 1}`,
                isDefault: false,
                showWhen: 'always',
                nextViewOnSubmit: null,
                captureLeads: false,
                content: '',
                order: viewsData.length + 1
            };
            viewsData.push(newView);
            renderViewsList();
        }

        function addViewFromTemplate(type) {
            const templates = {
                'success': { name: 'Success View', icon: 'check-circle', captureLeads: false },
                'error': { name: 'Error View', icon: 'exclamation-triangle', captureLeads: false },
                'thank-you': { name: 'Thank You View', icon: 'emoji-smile', captureLeads: false },
                'download': { name: 'Download View', icon: 'download', captureLeads: false }
            };

            const template = templates[type];
            const newView = {
                id: nextViewId++,
                type: type,
                name: template.name,
                isDefault: false,
                showWhen: 'always',
                nextViewOnSubmit: null,
                captureLeads: template.captureLeads,
                content: '',
                order: viewsData.length + 1
            };
            viewsData.push(newView);
            renderViewsList();
        }

        function renderViewsList() {
            const viewsList = document.getElementById('viewsList');
            viewsList.innerHTML = '';

            viewsData.sort((a, b) => a.order - b.order).forEach(view => {
                const viewCard = createViewCard(view);
                viewsList.insertAdjacentHTML('beforeend', viewCard);
            });
        }

        function createViewCard(view) {
            const typeColors = {
                'initial': '#10b981',
                'success': '#10b981',
                'error': '#ef4444',
                'thank-you': '#8b5cf6',
                'download': '#3b82f6',
                'custom': '#6b7280'
            };

            const color = typeColors[view.type] || '#6b7280';
            const defaultBadge = view.isDefault ? `<span style="background: #10b981; color: white; padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 600;">DEFAULT</span>` : '';

            return `
                <div class="view-card" data-view-id="${view.id}" data-view-type="${view.type}" style="background: white; border: 2px solid #e5e7eb; border-radius: 12px; padding: 24px; position: relative;">
                    <div style="display: flex; align-items: start; gap: 20px;">
                        <div style="flex-shrink: 0; width: 120px; height: 90px; background: #f3f4f6; border-radius: 8px; display: flex; align-items: center; justify-content: center; border: 2px dashed #d1d5db;">
                            <i class="bi bi-eye" style="font-size: 32px; color: #9ca3af;"></i>
                        </div>
                        <div style="flex: 1;">
                            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                                <h3 style="font-size: 18px; font-weight: 600; color: #111827; margin: 0;">${view.name}</h3>
                                ${defaultBadge}
                            </div>
                            <p style="color: #6b7280; font-size: 14px; margin-bottom: 16px;">Configure this view's content and behavior</p>
                            <div style="display: flex; gap: 12px; align-items: center;">
                                <select class="form-select form-select-sm" style="width: 150px;" onchange="updateViewType(this, ${view.id})">
                                    <option value="initial" ${view.type === 'initial' ? 'selected' : ''}>Initial</option>
                                    <option value="success" ${view.type === 'success' ? 'selected' : ''}>Success</option>
                                    <option value="error" ${view.type === 'error' ? 'selected' : ''}>Error</option>
                                    <option value="thank-you" ${view.type === 'thank-you' ? 'selected' : ''}>Thank You</option>
                                    <option value="download" ${view.type === 'download' ? 'selected' : ''}>Download</option>
                                    <option value="custom" ${view.type === 'custom' ? 'selected' : ''}>Custom</option>
                                </select>
                                <input type="text" class="form-control form-control-sm" placeholder="View name..." value="${view.name}" style="width: 200px;" onchange="updateViewName(this, ${view.id})">
                                <button class="btn btn-sm btn-outline-primary" onclick="editViewContent(${view.id})">
                                    <i class="bi bi-pencil me-1"></i>Edit Content
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" onclick="duplicateView(${view.id})">
                                    <i class="bi bi-files"></i>
                                </button>
                                ${!view.isDefault ? `<button class="btn btn-sm btn-outline-danger" onclick="deleteView(${view.id})"><i class="bi bi-trash"></i></button>` : ''}
                            </div>
                        </div>
                        <div style="display: flex; gap: 8px; flex-direction: column;">
                            <button class="btn btn-sm btn-outline-secondary" onclick="moveViewUp(${view.id})" title="Move Up">
                                <i class="bi bi-arrow-up"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" onclick="moveViewDown(${view.id})" title="Move Down">
                                <i class="bi bi-arrow-down"></i>
                            </button>
                        </div>
                    </div>
                    <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #e5e7eb;">
                        <div style="display: flex; gap: 24px; align-items: center; flex-wrap: wrap;">
                            <div>
                                <label style="font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Show When</label>
                                <select class="form-select form-select-sm" style="width: 200px;" onchange="updateShowWhen(this, ${view.id})">
                                    <option value="always" ${view.showWhen === 'always' ? 'selected' : ''}>Always (Default)</option>
                                    <option value="condition" ${view.showWhen === 'condition' ? 'selected' : ''}>Custom Condition</option>
                                </select>
                            </div>
                            <div>
                                <label style="font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Next View On Submit</label>
                                <select class="form-select form-select-sm" style="width: 200px;" onchange="updateNextView(this, ${view.id})">
                                    <option value="">None (Close)</option>
                                    ${viewsData.filter(v => v.id !== view.id).map(v => `<option value="${v.id}" ${view.nextViewOnSubmit == v.id ? 'selected' : ''}>→ ${v.name}</option>`).join('')}
                                </select>
                            </div>
                            <div>
                                <label style="font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Capture Leads</label>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" ${view.captureLeads ? 'checked' : ''} onchange="toggleLeadCapture(this, ${view.id})">
                                    <label class="form-check-label" style="font-size: 13px;">Enable</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        function updateViewType(select, viewId) {
            const view = viewsData.find(v => v.id === viewId);
            if (view) {
                view.type = select.value;
                renderViewsList();
            }
        }

        function updateViewName(input, viewId) {
            const view = viewsData.find(v => v.id === viewId);
            if (view) {
                view.name = input.value;
            }
        }

        function updateShowWhen(select, viewId) {
            const view = viewsData.find(v => v.id === viewId);
            if (view) {
                view.showWhen = select.value;
            }
        }

        function updateNextView(select, viewId) {
            const view = viewsData.find(v => v.id === viewId);
            if (view) {
                view.nextViewOnSubmit = select.value || null;
            }
        }

        function toggleLeadCapture(checkbox, viewId) {
            const view = viewsData.find(v => v.id === viewId);
            if (view) {
                view.captureLeads = checkbox.checked;
            }
        }

        function editViewContent(viewId) {
            const view = viewsData.find(v => v.id === viewId);
            if (view) {
                // Store current view being edited
                currentEditingViewId = viewId;
                
                // Load view content into design canvas
                const canvas = document.getElementById('dropzone');
                if (view.content) {
                    canvas.innerHTML = view.content;
                } else {
                    // If no content, load from template if available
                    if (view.template && view.template !== 'custom') {
                        loadViewTemplate(view.template, (html) => {
                            canvas.innerHTML = html;
                            view.content = html;
                        });
                    } else {
                        canvas.innerHTML = '<div style="padding: 40px; text-align: center; color: #9ca3af;"><i class="bi bi-plus-circle" style="font-size: 48px; margin-bottom: 16px;"></i><br>Click "Add Component" to start designing</div>';
                    }
                }
                
                // Show indicator of which view is being edited
                const indicator = document.getElementById('viewEditIndicator') || createViewEditIndicator();
                const textElement = indicator.querySelector('#viewEditText');
                if (textElement) {
                    textElement.textContent = `Editing View: ${view.name}`;
                }
                indicator.style.display = 'flex';
                
                // Switch to Design tab
                document.querySelector('[data-bs-target="#design"]').click();
            }
        }
        
        function createViewEditIndicator() {
            const indicator = document.createElement('div');
            indicator.id = 'viewEditIndicator';
            indicator.style.cssText = 'position: fixed; top: 70px; left: 50%; transform: translateX(-50%); background: #3b82f6; color: white; padding: 8px 20px; border-radius: 20px; font-size: 13px; font-weight: 600; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3); z-index: 1050; display: none; gap: 12px; align-items: center;';
            indicator.innerHTML = `
                <span id="viewEditText">Editing View</span>
                <button onclick="saveCurrentViewContent()" style="background: white; color: #3b82f6; border: none; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600; cursor: pointer;">Save View</button>
                <button onclick="exitViewEditing()" style="background: rgba(255,255,255,0.2); color: white; border: none; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600; cursor: pointer;">Exit</button>
            `;
            document.body.appendChild(indicator);
            return indicator;
        }
        
        function loadViewTemplate(templateType, callback) {
            const templatePath = `/Templates/Views/${templateType}.html`;
            fetch(templatePath)
                .then(response => response.text())
                .then(html => {
                    if (callback) callback(html);
                })
                .catch(err => {
                    console.error('Error loading view template:', err);
                    if (callback) callback('<div style="padding: 20px;">Error loading template</div>');
                });
        }
        
        let currentEditingViewId = null;
        
        function saveCurrentViewContent() {
            if (currentEditingViewId === null) return;
            
            const view = viewsData.find(v => v.id === currentEditingViewId);
            if (view) {
                const canvas = document.getElementById('dropzone');
                view.content = canvas.innerHTML;
                
                // Show success message
                const indicator = document.getElementById('viewEditIndicator');
                const textElement = indicator.querySelector('#viewEditText');
                if (textElement) {
                    const originalText = textElement.textContent;
                    textElement.textContent = '✓ View Saved!';
                    indicator.style.background = '#10b981';
                    
                    setTimeout(() => {
                        textElement.textContent = originalText;
                        indicator.style.background = '#3b82f6';
                    }, 2000);
                }
                
                renderViewsList();
            }
        }
        
        function exitViewEditing() {
            currentEditingViewId = null;
            const indicator = document.getElementById('viewEditIndicator');
            if (indicator) {
                indicator.style.display = 'none';
            }
            // Load main popup content back
            location.reload();
        }

        function duplicateView(viewId) {
            const view = viewsData.find(v => v.id === viewId);
            if (view) {
                const newView = {
                    ...view,
                    id: nextViewId++,
                    name: `${view.name} (Copy)`,
                    isDefault: false,
                    order: viewsData.length + 1
                };
                viewsData.push(newView);
                renderViewsList();
            }
        }

        function deleteView(viewId) {
            if (confirm('Are you sure you want to delete this view?')) {
                viewsData = viewsData.filter(v => v.id !== viewId);
                renderViewsList();
            }
        }

        function moveViewUp(viewId) {
            const index = viewsData.findIndex(v => v.id === viewId);
            if (index > 0) {
                [viewsData[index].order, viewsData[index - 1].order] = [viewsData[index - 1].order, viewsData[index].order];
                renderViewsList();
            }
        }

        function moveViewDown(viewId) {
            const index = viewsData.findIndex(v => v.id === viewId);
            if (index < viewsData.length - 1) {
                [viewsData[index].order, viewsData[index + 1].order] = [viewsData[index + 1].order, viewsData[index].order];
                renderViewsList();
            }
        }

        function importView() {
            alert('Import view functionality coming soon!');
        }

        // Initialize views on page load
        renderViewsList();
    </script>
