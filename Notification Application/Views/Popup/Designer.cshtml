    <!-- View Manager Modal -->
    <div class="modal fade" id="viewManagerModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-grid-3x3 me-2"></i>View Manager - Configure Multiple Views</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Multi-View Support:</strong> Create different views for different states (Success, Error, Loading, etc.). 
                        Drag to reorder and customize each view independently.
                    </div>

                    <!-- View List with Drag & Drop -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">Available Views</h6>
                            <button class="btn btn-sm btn-primary" onclick="addCustomView()">
                                <i class="bi bi-plus-circle me-1"></i>Add Custom View
                            </button>
                        </div>
                        <div id="viewsList" class="list-group">
                            <!-- Views will be populated by JavaScript -->
                        </div>
                    </div>

                    <!-- View Configuration -->
                    <div id="viewConfigSection" style="display: none;">
                        <h6 class="mb-3">Configure View Actions</h6>
                        <div class="property-group">
                            <label class="property-label">View Name</label>
                            <input type="text" class="property-input" id="currentViewName" readonly>
                        </div>
                        <div class="property-group">
                            <label class="property-label">Trigger Event</label>
                            <select class="property-select" id="currentViewTrigger">
                                <option value="manual">Manual Trigger</option>
                                <option value="form_success">Form Submit Success</option>
                                <option value="form_error">Form Submit Error</option>
                                <option value="button_click">Button Click</option>
                                <option value="timeout">After Timeout</option>
                            </select>
                        </div>
                        <div class="property-group" id="timeoutGroup" style="display: none;">
                            <label class="property-label">Timeout (seconds)</label>
                            <input type="number" class="property-input" id="currentViewTimeout" min="0" value="3">
                        </div>
                        <div class="property-group">
                            <label class="property-label">Auto-switch to View</label>
                            <select class="property-select" id="currentViewNext">
                                <option value="">None - Stay on this view</option>
                                <option value="success">Success View</option>
                                <option value="error">Error View</option>
                                <option value="optin">Optin View</option>
                            </select>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="currentViewCaptureLead">
                            <label class="form-check-label" for="currentViewCaptureLead">
                                Capture as Lead when this view is shown
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" onclick="saveViewConfiguration()">
                        <i class="bi bi-check2 me-1"></i>Save Configuration
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
    <script>
        const popupId = @Model.Id;
        let selectedComponent = null;
        let componentCounter = 0;

        // View Management System
        let popupViews = {
            optin: {
                name: 'Optin View',
                type: 'optin',
                enabled: true,
                trigger: 'manual',
                captureLead: true,
                order: 1
            },
            success: {
                name: 'Success View',
                type: 'success',
                enabled: true,
                trigger: 'form_success',
                captureLead: false,
                order: 2,
                nextView: null
            },
            error: {
                name: 'Error View',
                type: 'error',
                enabled: false,
                trigger: 'form_error',
                captureLead: false,
                order: 3
            },
            loading: {
                name: 'Loading View',
                type: 'loading',
                enabled: false,
                trigger: 'manual',
                captureLead: false,
                order: 4,
                timeout: 3,
                nextView: 'success'
            }
        };

        let currentEditingView = null;

        window.addEventListener('DOMContentLoaded', function() {
            // Get popup type from URL parameter
            const urlParams = new URLSearchParams(window.location.search);
            const popupType = urlParams.get('type');
            
            // Apply popup type positioning
            if (popupType) {
                applyPopupTypePosition(popupType);
            } else {
                // Default to center modal if no type specified
                detectPopupPosition();
            }
            
            // Load existing values
            const trigger = '@Model.Trigger';
            const frequency = '@Model.Frequency';
            const delayMs = @Model.DelayMs;
            const showMobile = @Model.ShowOnMobile.ToString().ToLower();
            const showDesktop = @Model.ShowOnDesktop.ToString().ToLower();
            
            if (document.getElementById('triggerSelect')) {
                document.getElementById('triggerSelect').value = trigger;
                document.getElementById('delayGroup').style.display = trigger === 'OnTimeDelay' ? 'block' : 'none';
            }
            if (document.getElementById('frequencySelect')) document.getElementById('frequencySelect').value = frequency;
            if (document.getElementById('delayInput')) document.getElementById('delayInput').value = delayMs / 1000;
            if (document.getElementById('showMobile')) document.getElementById('showMobile').checked = showMobile === 'true';
            if (document.getElementById('showDesktop')) document.getElementById('showDesktop').checked = showDesktop === 'true';
            
            // Load existing content
            try {
                const contentStr = @Html.Raw(Json.Serialize(Model.Content ?? "{}"));
                console.log('Loading content:', contentStr);
                console.log('Content type:', typeof contentStr);
                
                if (contentStr && contentStr !== '{}' && contentStr !== '' && contentStr !== '""') {
                    let htmlContent = '';
                    
                    try {
                        // Try to parse as JSON first
                        const parsed = typeof contentStr === 'string' ? JSON.parse(contentStr) : contentStr;
                        console.log('Parsed content as JSON:', parsed);
                        
                        if (typeof parsed === 'object' && parsed.html) {
                            // Saved popup with JSON structure
                            htmlContent = parsed.html;
                        } else if (typeof parsed === 'string') {
                            // Plain HTML string that was JSON-serialized
                            htmlContent = parsed;
                        } else {
                            // If it's already a string (template loaded from file)
                            htmlContent = contentStr;
                        }
                    } catch (jsonError) {
                        // Not valid JSON, treat as plain HTML (template from file)
                        console.log('Content is not JSON, using as plain HTML');
                        htmlContent = contentStr;
                    }
                    
                    console.log('Final HTML content to load:', htmlContent);
                    
                    // If we have HTML content, load it
                    if (htmlContent && htmlContent.trim() !== '' && htmlContent !== '{}' && htmlContent !== '""') {
                        console.log('Loading HTML content into dropzone');
                        document.getElementById('dropzone').innerHTML = htmlContent;
                        const emptyState = document.querySelector('.empty-state');
                        if (emptyState) emptyState.remove();
                        
                        // Wrap existing elements with component wrappers for editing
                        wrapExistingElements();
                        
                        // Attach event listeners
                        attachEventListeners();
                        
                        // Make all text elements directly editable
                        makeTextElementsEditable();
                        
                        // Re-initialize drag and drop after loading template
                        initializeDragAndDrop();
                        
                        // Detect and set popup position based on template type
                        detectPopupPosition();
                    } else {
                        console.log('No valid HTML content found');
                    }
                } else {
                    console.log('Content is empty or default');
                }
            } catch (e) {
                console.error('Error parsing content:', e);
                console.error('Error stack:', e.stack);
            }
        });

        function initializeDragAndDrop() {
            const dropzone = document.getElementById('dropzone');
            
            // Re-attach drag events to all block items
            document.querySelectorAll('.block-item').forEach(block => {
                block.addEventListener('dragstart', e => e.dataTransfer.setData('blockType', block.dataset.blockType));
            });
            
            // Ensure dropzone has drag handlers
            dropzone.addEventListener('dragover', e => { e.preventDefault(); dropzone.classList.add('drag-over'); });
            dropzone.addEventListener('dragleave', () => dropzone.classList.remove('drag-over'));
            dropzone.addEventListener('drop', function(e) {
                e.preventDefault();
                dropzone.classList.remove('drag-over');
                addComponent(e.dataTransfer.getData('blockType'));
                const emptyState = dropzone.querySelector('.empty-state');
                if (emptyState) emptyState.remove();
            });
            
            // Click on empty space to deselect
            dropzone.addEventListener('click', function(e) {
                if (e.target === dropzone || e.target.classList.contains('canvas-dropzone')) {
                    if (selectedComponent) {
                        selectedComponent.classList.remove('selected');
                        selectedComponent = null;
                        document.getElementById('propertiesPanel').innerHTML = '<div class="empty-state" style="padding-top: 100px;"><i class="bi bi-sliders"></i><p>Select a block to edit properties</p></div>';
                    }
                }
            });
        }

        function applyPopupTypePosition(type) {
            const popupCanvas = document.getElementById('popupCanvas');
            const dropzone = document.getElementById('dropzone');
            
            // Remove all position classes
            popupCanvas.classList.remove('position-top', 'position-bottom', 'position-center', 'position-fullscreen', 'position-side');
            
            // Apply position based on type
            switch(type) {
                case 'Modal':
                case 'Notification':
                    popupCanvas.classList.add('position-center');
                    dropzone.style.maxWidth = '600px';
                    dropzone.style.width = 'auto';
                    dropzone.style.borderRadius = '12px';
                    break;
                    
                case 'FloatingBar':
                    popupCanvas.classList.add('position-top');
                    dropzone.style.maxWidth = '100%';
                    dropzone.style.width = '100%';
                    dropzone.style.borderRadius = '0';
                    dropzone.style.maxHeight = '150px';
                    break;
                    
                case 'SlideIn':
                    popupCanvas.classList.add('position-bottom');
                    popupCanvas.style.alignItems = 'flex-end';
                    popupCanvas.style.justifyContent = 'flex-end';
                    popupCanvas.style.padding = '20px';
                    dropzone.style.maxWidth = '400px';
                    dropzone.style.width = '400px';
                    dropzone.style.borderRadius = '12px';
                    dropzone.style.marginRight = '20px';
                    dropzone.style.marginBottom = '20px';
                    break;
                    
                case 'Fullscreen':
                    popupCanvas.classList.add('position-fullscreen');
                    dropzone.style.width = '100%';
                    dropzone.style.height = '100%';
                    dropzone.style.maxWidth = '100%';
                    dropzone.style.maxHeight = '100%';
                    dropzone.style.borderRadius = '0';
                    break;
                    
                case 'SidePanel':
                    popupCanvas.classList.add('position-side');
                    dropzone.style.width = '400px';
                    dropzone.style.height = '100%';
                    dropzone.style.maxWidth = '400px';
                    dropzone.style.maxHeight = '100%';
                    dropzone.style.borderRadius = '0';
                    break;
                    
                default:
                    popupCanvas.classList.add('position-center');
                    dropzone.style.maxWidth = '600px';
                    dropzone.style.width = 'auto';
            }
        }

        function detectPopupPosition() {
            const popupCanvas = document.getElementById('popupCanvas');
            const dropzone = document.getElementById('dropzone');
            const templateName = '@Model.Name'.toLowerCase();
            
            // Remove existing position classes
            popupCanvas.classList.remove('position-top', 'position-bottom', 'position-center');
            
            // Check for floating bar templates (should appear at top or bottom)
            if (templateName.includes('floating') || templateName.includes('bar') || templateName.includes('banner')) {
                // Check template content for positioning hints
                const content = dropzone.innerHTML.toLowerCase();
                if (content.includes('bottom') || content.includes('footer')) {
                    popupCanvas.classList.add('position-bottom');
                } else {
                    popupCanvas.classList.add('position-top');
                }
                // Adjust dropzone for full width
                dropzone.style.maxWidth = '100%';
                dropzone.style.width = '100%';
            } else {
                // Center position for modal/lightbox popups
                popupCanvas.classList.add('position-center');
                dropzone.style.maxWidth = '90%';
                dropzone.style.width = 'auto';
            }
        }

        document.querySelectorAll('.nav-tab').forEach(tab => {
            tab.addEventListener('click', function() {
                document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
                this.classList.add('active');
                const tabName = this.dataset.tab;
                
                // Hide all sections
                document.querySelectorAll('.properties-section, .rules-section, .analytics-section').forEach(s => s.classList.remove('active'));
                document.getElementById('designSidebar').classList.remove('active');
                document.getElementById('displayRulesContainer').classList.remove('active');
                document.getElementById('viewsContainer').style.display = 'none';
                
                // Toggle designer container visibility
                const designerContainer = document.querySelector('.designer-container');
                
                if (tabName === 'design') {
                    designerContainer.classList.remove('hidden');
                    document.getElementById('propertiesPanel').classList.add('active');
                    document.getElementById('designSidebar').classList.add('active');
                } else if (tabName === 'views') {
                    designerContainer.classList.add('hidden');
                    document.getElementById('viewsContainer').style.display = 'flex';
                } else if (tabName === 'display-rules') {
                    designerContainer.classList.add('hidden');
                    document.getElementById('displayRulesContainer').classList.add('active');
                } else {
                    designerContainer.classList.remove('hidden');
                    if (tabName === 'analytics') {
                        document.getElementById('analyticsPanel').classList.add('active');
                    }
                }
            });
        });

        document.querySelectorAll('.device-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.device-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                const deviceFrame = document.getElementById('deviceFrame');
                const previewFrame = document.getElementById('previewDeviceFrame');
                
                if (this.dataset.device === 'mobile') {
                    deviceFrame.classList.remove('desktop');
                    deviceFrame.classList.add('mobile');
                    if (previewFrame) {
                        previewFrame.classList.remove('desktop');
                        previewFrame.classList.add('mobile');
                    }
                } else {
                    deviceFrame.classList.remove('mobile');
                    deviceFrame.classList.add('desktop');
                    if (previewFrame) {
                        previewFrame.classList.remove('mobile');
                        previewFrame.classList.add('desktop');
                    }
                }
            });
        });

        // Initialize drag and drop on page load
        initializeDragAndDrop();

        function addComponent(type) {
            componentCounter++;
            const wrapper = document.createElement('div');
            wrapper.className = 'component-wrapper';
            wrapper.dataset.componentId = componentCounter;
            wrapper.dataset.componentType = type;
            let content = '';
            switch(type) {
                case 'heading': content = '<h2 contenteditable="true" style="margin: 16px 0; font-size: 32px; font-weight: 700; color: #111827;">Edit Heading</h2>'; break;
                case 'text': content = '<p contenteditable="true" style="margin: 16px 0; font-size: 16px; color: #374151;">Click to edit text</p>'; break;
                case 'button': content = '<div style="text-align: center; margin: 16px 0;"><button style="background: #2563eb; color: white; border: none; padding: 12px 24px; border-radius: 6px; font-weight: 600; cursor: pointer;">Click Me</button></div>'; break;
                case 'image': content = '<div style="text-align: center; margin: 16px 0;"><img src="https://via.placeholder.com/400x200" style="max-width: 100%; border-radius: 8px;"></div>'; break;
                case 'icon': content = '<div style="text-align: center; margin: 16px 0;"><i class="bi bi-star-fill" style="font-size: 48px; color: #f59e0b;"></i></div>'; break;
                case 'fields': content = '<div style="margin: 16px 0;"><input type="email" placeholder="Enter your email" style="width: 100%; padding: 12px; border: 1px solid #d1d5db; border-radius: 6px;"></div>'; break;
                case 'list': content = '<ul style="margin: 16px 0; padding-left: 24px; color: #374151;"><li style="margin: 8px 0;">List item 1</li><li style="margin: 8px 0;">List item 2</li><li style="margin: 8px 0;">List item 3</li></ul>'; break;
                case 'alert': content = '<div style="margin: 16px 0; padding: 16px; background: #dbeafe; border-left: 4px solid #2563eb; border-radius: 6px; color: #1e40af;"><strong>Info:</strong> This is an alert message</div>'; break;
                case 'divider': content = '<hr style="margin: 24px 0; border: 0; border-top: 1px solid #e5e7eb;">'; break;
                case 'spacer': content = '<div style="height: 32px;"></div>'; break;
                case 'video': content = '<div style="margin: 16px 0;"><div style="position: relative; padding-bottom: 56.25%; height: 0;"><iframe src="https://www.youtube.com/embed/dQw4w9WgXcQ" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;" allowfullscreen></iframe></div></div>'; break;
                case 'countdown': content = '<div class="countdown-timer" data-target-date="" style="text-align: center; margin: 16px 0; font-size: 32px; font-weight: 700; color: #2563eb;" data-format="00:59:59">00:59:59</div>'; break;
                case 'progress': content = '<div style="margin: 16px 0;"><div style="background: #e5e7eb; height: 24px; border-radius: 12px; overflow: hidden;"><div class="progress-fill" data-progress="70" style="width: 70%; height: 100%; background: linear-gradient(90deg, #10b981 0%, #059669 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 12px; font-weight: 600;">70%</div></div></div>'; break;
                case 'rating': content = '<div style="text-align: center; margin: 16px 0; font-size: 28px; color: #f59e0b;"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star"></i></div>'; break;
                case 'testimonial': content = '<div style="margin: 16px 0; padding: 24px; background: #f9fafb; border-radius: 12px; border-left: 4px solid #2563eb;"><p style="font-size: 16px; font-style: italic; color: #374151; margin-bottom: 16px;">"This is an amazing product! Highly recommended."</p><div style="display: flex; align-items: center; gap: 12px;"><img src="https://via.placeholder.com/48" style="width: 48px; height: 48px; border-radius: 50%;"><div><div style="font-weight: 600; color: #111827;">John Doe</div><div style="font-size: 14px; color: #6b7280;">Customer</div></div></div></div>'; break;
                case 'badge': content = '<div style="text-align: center; margin: 16px 0;"><span style="display: inline-block; padding: 8px 16px; background: #2563eb; color: white; border-radius: 20px; font-size: 14px; font-weight: 600;">NEW</span></div>'; break;
                case 'card': content = '<div style="margin: 16px 0; padding: 24px; background: white; border: 1px solid #e5e7eb; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);"><h3 style="font-size: 20px; font-weight: 600; color: #111827; margin-bottom: 12px;">Card Title</h3><p style="color: #6b7280; margin-bottom: 16px;">Card content goes here. You can add text, images, or other elements.</p><button style="background: #2563eb; color: white; border: none; padding: 10px 20px; border-radius: 6px; font-weight: 600; cursor: pointer;">Learn More</button></div>'; break;
                case 'social': content = '<div class="social-buttons" style="text-align: center; margin: 16px 0;"><a href="#" style="display: inline-block; width: 36px; height: 36px; line-height: 36px; background: #3b5998; color: white; border-radius: 50%; margin: 0 4px; text-decoration: none;"><i class="bi bi-facebook"></i></a><a href="#" style="display: inline-block; width: 36px; height: 36px; line-height: 36px; background: #1da1f2; color: white; border-radius: 50%; margin: 0 4px; text-decoration: none;"><i class="bi bi-twitter"></i></a><a href="#" style="display: inline-block; width: 36px; height: 36px; line-height: 36px; background: #0077b5; color: white; border-radius: 50%; margin: 0 4px; text-decoration: none;"><i class="bi bi-linkedin"></i></a></div>'; break;
                case 'coupon': content = '<div class="coupon-code" data-code="SAVE20" style="text-align: center; margin: 16px 0;"><div style="background: #1e293b; color: white; padding: 16px 32px; border-radius: 8px; font-size: 24px; font-weight: 700; letter-spacing: 2px; display: inline-block;">SAVE20</div></div>'; break;
                case 'form': content = '<form style="margin: 16px 0; padding: 24px; background: #f9fafb; border-radius: 12px;"><div style="margin-bottom: 16px;"><label style="display: block; margin-bottom: 6px; font-weight: 600; color: #374151;">Name</label><input type="text" placeholder="Your name" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;"></div><div style="margin-bottom: 16px;"><label style="display: block; margin-bottom: 6px; font-weight: 600; color: #374151;">Email</label><input type="email" placeholder="your@email.com" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;"></div><button type="submit" style="width: 100%; background: #2563eb; color: white; border: none; padding: 12px; border-radius: 6px; font-weight: 600; cursor: pointer;">Submit</button></form>'; break;
                case 'accordion': content = '<div style="margin: 16px 0;"><div style="border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden;"><div style="padding: 16px; background: #f9fafb; font-weight: 600; cursor: pointer; border-bottom: 1px solid #e5e7eb;">Section 1 <i class="bi bi-chevron-down" style="float: right;"></i></div><div style="padding: 16px; display: none;">Content for section 1</div><div style="padding: 16px; background: #f9fafb; font-weight: 600; cursor: pointer; border-bottom: 1px solid #e5e7eb;">Section 2 <i class="bi bi-chevron-down" style="float: right;"></i></div><div style="padding: 16px; display: none;">Content for section 2</div></div></div>'; break;
                case 'map': content = '<div style="margin: 16px 0;"><iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3024.2219901290355!2d-74.00369368400567!3d40.71312937933185!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c25a316e8c5e27%3A0x21be8c84cf88ccf5!2sNew%20York%2C%20NY%2C%20USA!5e0!3m2!1sen!2s!4v1234567890" width="100%" height="300" style="border:0; border-radius: 8px;" allowfullscreen loading="lazy"></iframe></div>'; break;
                case 'html': content = '<div class="custom-html" style="margin: 16px 0; padding: 16px; background: #f9fafb; border: 2px dashed #d1d5db; border-radius: 8px;"><p style="color: #6b7280; text-align: center; margin: 0;">Custom HTML Block</p></div>'; break;
                case 'columns': content = '<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 16px 0;"><div style="padding: 20px; background: #f3f4f6; border-radius: 8px;">Column 1</div><div style="padding: 20px; background: #f3f4f6; border-radius: 8px;">Column 2</div></div>'; break;
                default: content = `<div style="padding: 16px; background: #f3f4f6; border-radius: 8px; margin: 16px 0; text-align: center;">${type} block</div>`;
            }
            wrapper.innerHTML = `<div class="component-controls"><button class="control-btn" title="Move Up"><i class="bi bi-arrow-up"></i></button><button class="control-btn" title="Move Down"><i class="bi bi-arrow-down"></i></button><button class="control-btn delete-btn" title="Delete (Del)"><i class="bi bi-trash"></i></button></div>${content}`;
            dropzone.appendChild(wrapper);
            
            // Add button event listeners to controls
            const controls = wrapper.querySelector('.component-controls');
            const moveUpBtn = controls.children[0];
            const moveDownBtn = controls.children[1];
            const deleteBtn = controls.children[2];
            
            const currentId = componentCounter;
            
            moveUpBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                e.preventDefault();
                moveUp(currentId, e);
            });
            
            moveDownBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                e.preventDefault();
                moveDown(currentId, e);
            });
            
            deleteBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                e.preventDefault();
                deleteComponent(currentId);
            });
            
            wrapper.addEventListener('click', function(e) { e.stopPropagation(); selectComponent(this); });
            
            // Make text elements in the new component editable
            const textElements = wrapper.querySelectorAll('h1, h2, h3, h4, h5, h6, p, span, button:not(.control-btn), div[style*="text-align"]');
            textElements.forEach(elem => {
                const hasDirectText = Array.from(elem.childNodes).some(node => 
                    node.nodeType === Node.TEXT_NODE && node.textContent.trim()
                );
                const hasOnlyInlineContent = !elem.querySelector('div:not(.component-controls):not([style*="inline"]), form, table, ul, ol, img, iframe, input, select, textarea');
                const isButton = elem.tagName === 'BUTTON' && !elem.classList.contains('control-btn');
                
                if ((hasDirectText && hasOnlyInlineContent) || isButton) {
                    elem.setAttribute('contenteditable', 'true');
                    elem.style.cursor = 'text';
                    
                    // Prevent button default action when editing
                    if (isButton) {
                        elem.addEventListener('click', function(e) {
                            e.preventDefault();
                            e.stopPropagation();
                        });
                    }
                }
            });
        }

        // Add keyboard shortcuts for component operations
        document.addEventListener('keydown', function(e) {
            // Delete key - delete selected component
            if (e.key === 'Delete' && selectedComponent && document.activeElement.getAttribute('contenteditable') !== 'true') {
                const componentId = selectedComponent.dataset.componentId;
                deleteComponent(componentId);
                e.preventDefault();
            }
            
            // Escape key - deselect component
            if (e.key === 'Escape' && selectedComponent) {
                selectedComponent.classList.remove('selected');
                selectedComponent = null;
                document.getElementById('propertiesPanel').innerHTML = '<div class="empty-state" style="padding-top: 100px;"><i class="bi bi-sliders"></i><p>Select a block to edit properties</p></div>';
            }
        });

        function attachEventListeners() {
            document.querySelectorAll('.component-wrapper').forEach((wrapper, index) => {
                if (!wrapper.dataset.componentId) wrapper.dataset.componentId = ++componentCounter;
                wrapper.addEventListener('click', function(e) { e.stopPropagation(); selectComponent(this); });
            });
        }

        function wrapExistingElements() {
            const dropzone = document.getElementById('dropzone');
            const children = Array.from(dropzone.children);
            
            console.log('Wrapping existing elements, found:', children.length);
            
            children.forEach(child => {
                // Skip if already wrapped
                if (child.classList.contains('component-wrapper') || child.classList.contains('empty-state')) {
                    return;
                }
                
                // Detect component type
                let componentType = 'text';
                
                // Check for main popup container divs (from templates)
                if (child.classList.contains('minimal-popup') || 
                    child.classList.contains('success-view') ||
                    child.classList.contains('error-view') ||
                    child.classList.contains('discount-popup') ||
                    child.style.maxWidth || 
                    child.style.padding) {
                    // This is likely a complete template container - treat as card
                    componentType = 'card';
                }
                // Check for testimonial (italic quote with author info)
                else if (child.querySelector('p[style*="italic"]') && child.querySelector('img[style*="border-radius: 50%"]')) {
                    componentType = 'testimonial';
                } else if (child.tagName === 'H1' || child.tagName === 'H2' || child.tagName === 'H3' || child.tagName === 'H4') {
                    componentType = 'heading';
                } else if (child.querySelector('button:not([type="submit"])') && !child.querySelector('form')) {
                    componentType = 'button';
                } else if (child.querySelector('img')) {
                    componentType = 'image';
                } else if (child.querySelector('input[type="email"]') && !child.querySelector('form')) {
                    componentType = 'fields';
                } else if (child.querySelector('.countdown-timer')) {
                    componentType = 'countdown';
                } else if (child.querySelector('.progress-fill')) {
                    componentType = 'progress';
                } else if (child.querySelector('i.bi-star-fill, i.bi-star') && !child.querySelector('a') && !child.querySelector('img')) {
                    componentType = 'rating';
                } else if (child.querySelector('form') || child.classList.contains('popup-form')) {
                    componentType = 'form';
                } else if (child.querySelector('.social-buttons') || (child.querySelectorAll('a i.bi-facebook, a i.bi-twitter').length > 0)) {
                    componentType = 'social';
                } else if (child.querySelector('.coupon-code')) {
                    componentType = 'coupon';
                } else if (child.tagName === 'HR') {
                    componentType = 'divider';
                } else if (child.querySelector('i.bi-') && !child.querySelector('ul') && !child.querySelector('button') && !child.querySelector('img')) {
                    componentType = 'icon';
                } else if (child.querySelector('ul, ol')) {
                    componentType = 'list';
                } else if (child.querySelector('iframe[src*="youtube"], iframe[src*="vimeo"]')) {
                    componentType = 'video';
                } else if (child.querySelector('iframe[src*="google.com/maps"]')) {
                    componentType = 'map';
                } else if (child.style.display === 'grid' || child.style.gridTemplateColumns) {
                    componentType = 'columns';
                } else if (child.querySelector('h3') && child.querySelector('button') && child.style.padding) {
                    componentType = 'card';
                } else if (child.querySelector('span[style*="border-radius: 20px"]') || child.querySelector('span[style*="border-radius:20px"]')) {
                    componentType = 'badge';
                } else if (child.tagName === 'STYLE') {
                    // Don't wrap style tags
                    return;
                }
                
                console.log('Wrapping element:', child.tagName, 'as type:', componentType);
                
                // Create wrapper
                componentCounter++;
                const wrapper = document.createElement('div');
                wrapper.className = 'component-wrapper';
                wrapper.dataset.componentId = componentCounter;
                wrapper.dataset.componentType = componentType;
                
                // Add controls
                const controls = document.createElement('div');
                controls.className = 'component-controls';
                controls.innerHTML = `
                    <button class="control-btn" title="Move Up"><i class="bi bi-arrow-up"></i></button>
                    <button class="control-btn" title="Move Down"><i class="bi bi-arrow-down"></i></button>
                    <button class="control-btn delete-btn" title="Delete (Del)"><i class="bi bi-trash"></i></button>
                `;
                
                // Wrap the element
                child.parentNode.insertBefore(wrapper, child);
                wrapper.appendChild(controls);
                wrapper.appendChild(child);
                
                // Add button event listeners
                const moveUpBtn = controls.children[0];
                const moveDownBtn = controls.children[1];
                const deleteBtn = controls.children[2];
                
                // Capture current ID for closure
                const currentId = componentCounter;
                
                moveUpBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    e.preventDefault();
                    moveUp(currentId, e);
                });
                
                moveDownBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    e.preventDefault();
                    moveDown(currentId, e);
                });
                
                deleteBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    e.preventDefault();
                    deleteComponent(currentId);
                });
                
                // Add click listener
                wrapper.addEventListener('click', function(e) { 
                    e.stopPropagation(); 
                    selectComponent(this); 
                });
            });
            
            console.log('Wrapped', componentCounter, 'components');
        }

        function makeTextElementsEditable() {
            const dropzone = document.getElementById('dropzone');
            // Select all text-containing elements that should be editable
            const textElements = dropzone.querySelectorAll('h1, h2, h3, h4, h5, h6, p, span:not(.component-controls *), button:not(.control-btn), a:not([href*="facebook"]):not([href*="twitter"]):not([href*="linkedin"]), div[style*="text-align"]');
            
            textElements.forEach(elem => {
                // Skip if in controls or already has input/select/textarea children
                if (elem.closest('.component-controls') || 
                    elem.querySelector('input, select, textarea, img, iframe, i.bi-')) {
                    return;
                }
                
                // Check if element has direct text content
                const hasDirectText = Array.from(elem.childNodes).some(node => 
                    node.nodeType === Node.TEXT_NODE && node.textContent.trim()
                );
                
                // Check if it's a simple container with only text/inline elements
                const hasOnlyInlineContent = !elem.querySelector('div:not([style*="inline"]), form, table, ul, ol, img, iframe');
                
                // Special case for buttons - always make them editable if they have text
                const isButton = elem.tagName === 'BUTTON' && !elem.classList.contains('control-btn');
                
                if ((hasDirectText && hasOnlyInlineContent) || isButton) {
                    elem.setAttribute('contenteditable', 'true');
                    elem.style.cursor = 'text';
                    
                    // Add hover effect for editability indication
                    elem.addEventListener('mouseenter', function() {
                        if (!this.closest('.component-wrapper.selected')) {
                            this.style.outline = '1px dashed rgba(37, 99, 235, 0.3)';
                        }
                    });
                    
                    elem.addEventListener('mouseleave', function() {
                        if (!this.closest('.component-wrapper.selected')) {
                            this.style.outline = 'none';
                        }
                    });
                    
                    elem.addEventListener('focus', function() {
                        this.style.outline = '2px solid #3b82f6';
                        this.style.outlineOffset = '2px';
                    });
                    
                    elem.addEventListener('blur', function() {
                        this.style.outline = 'none';
                    });
                    
                    // Prevent button default action when editing
                    if (isButton) {
                        elem.addEventListener('click', function(e) {
                            e.preventDefault();
                            e.stopPropagation();
                        });
                    }
                }
            });
        }

        function selectComponent(wrapper) {
            if (selectedComponent) {
                selectedComponent.classList.remove('selected');
                // Disconnect previous observer if exists
                if (selectedComponent.mutationObserver) {
                    selectedComponent.mutationObserver.disconnect();
                }
            }
            selectedComponent = wrapper;
            wrapper.classList.add('selected');
            showProperties(wrapper.dataset.componentType);
            
            // Add MutationObserver for card components to auto-refresh properties when content changes
            if (wrapper.dataset.componentType === 'card') {
                const cardElem = wrapper.children[1] || wrapper;
                const observer = new MutationObserver(() => {
                    // Refresh properties panel when card content changes
                    showProperties('card');
                });
                observer.observe(cardElem, {
                    childList: true,
                    subtree: true,
                    attributes: true,
                    attributeFilter: ['style', 'class']
                });
                wrapper.mutationObserver = observer;
            }
            
            // Enable contenteditable for text elements - more comprehensive selection
            const editableElements = wrapper.querySelectorAll('h1, h2, h3, h4, h5, h6, p, button:not(.control-btn), span, li, div:not(.component-controls):not(.component-wrapper), a, label, td, th');
            editableElements.forEach(elem => {
                // Only make elements with direct text content editable
                // Skip if element contains other block elements
                const hasBlockChildren = elem.querySelector('div:not([style*="inline"]), p, h1, h2, h3, h4, h5, h6, ul, ol, table, form, img, iframe, input, select, textarea');
                const hasOnlyText = elem.childNodes.length > 0 && Array.from(elem.childNodes).some(node => node.nodeType === Node.TEXT_NODE && node.textContent.trim());
                const isButton = elem.tagName === 'BUTTON' && !elem.classList.contains('control-btn');
                
                if ((!hasBlockChildren && hasOnlyText) || isButton) {
                    if (!elem.classList.contains('component-controls') && !elem.classList.contains('control-btn')) {
                        elem.setAttribute('contenteditable', 'true');
                        // Add visual feedback on hover
                        elem.style.cursor = 'text';
                        elem.addEventListener('focus', function() {
                            this.style.outline = '2px solid #3b82f6';
                            this.style.outlineOffset = '2px';
                        });
                        elem.addEventListener('blur', function() {
                            this.style.outline = 'none';
                        });
                        
                        // Prevent button default action when editing
                        if (isButton) {
                            elem.addEventListener('click', function(e) {
                                e.preventDefault();
                                e.stopPropagation();
                            });
                        }
                    }
                }
            });
        }

        function showProperties(type) {
            const panel = document.getElementById('propertiesPanel');
            let html = `<h4 style="margin-bottom: 20px; font-size: 16px; font-weight: 700;">${type.charAt(0).toUpperCase() + type.slice(1)} Properties</h4>`;
            
            // Helper to get current values from selected component
            const getCurrentValue = (selector, property = 'textContent', defaultValue = '') => {
                if (!selectedComponent) return defaultValue;
                const elem = selectedComponent.querySelector(selector);
                if (!elem) return defaultValue;
                if (property === 'textContent') return elem.textContent || defaultValue;
                if (property.startsWith('style.')) {
                    const styleProp = property.replace('style.', '');
                    return elem.style[styleProp] || defaultValue;
                }
                return elem[property] || defaultValue;
            };
            
            switch(type) {
                case 'text':
                    const textElem = selectedComponent?.querySelector('p');
                    const fontSize = textElem ? parseInt(textElem.style.fontSize) || 16 : 16;
                    const textColor = textElem ? textElem.style.color || '#374151' : '#374151';
                    const fontWeight = textElem ? textElem.style.fontWeight || '400' : '400';
                    const textAlign = textElem ? textElem.style.textAlign || 'left' : 'left';
                    
                    html += `
                        <div class="property-group">
                            <label class="property-label">Font Size (px)</label>
                            <input type="number" class="property-input" id="fontSize" value="${fontSize}" onchange="updateTextStyle('fontSize', this.value + 'px')">
                        </div>
                        <div class="property-group">
                            <label class="property-label">Text Color</label>
                            <div class="color-picker-row">
                                <input type="color" class="color-preview" id="textColor" value="${textColor}" onchange="updateTextStyle('color', this.value); document.getElementById('textColorHex').value = this.value;">
                                <input type="text" class="property-input" id="textColorHex" value="${textColor}" style="flex: 1;" onchange="document.getElementById('textColor').value = this.value; updateTextStyle('color', this.value)">
                            </div>
                        </div>
                        <div class="property-group">
                            <label class="property-label">Font Weight</label>
                            <select class="property-select" onchange="updateTextStyle('fontWeight', this.value)">
                                <option value="400" ${fontWeight === '400' ? 'selected' : ''}>Normal</option>
                                <option value="500" ${fontWeight === '500' ? 'selected' : ''}>Medium</option>
                                <option value="600" ${fontWeight === '600' ? 'selected' : ''}>Semi Bold</option>
                                <option value="700" ${fontWeight === '700' ? 'selected' : ''}>Bold</option>
                            </select>
                        </div>
                        <div class="property-group">
                            <label class="property-label">Alignment</label>
                            <select class="property-select" onchange="updateTextStyle('textAlign', this.value)">
                                <option value="left" ${textAlign === 'left' ? 'selected' : ''}>Left</option>
                                <option value="center" ${textAlign === 'center' ? 'selected' : ''}>Center</option>
                                <option value="right" ${textAlign === 'right' ? 'selected' : ''}>Right</option>
                                <option value="justify" ${textAlign === 'justify' ? 'selected' : ''}>Justify</option>
                            </select>
                        </div>
                        <div class="property-group">
                            <label class="property-label">Margin (px)</label>
                            <input type="text" class="property-input" value="${textElem ? textElem.style.margin : '16px 0'}" placeholder="e.g., 16px 0" onchange="updateTextStyle('margin', this.value)">
                        </div>
                    `;
                    break;
                    
                case 'button':
                    const btnElem = selectedComponent?.querySelector('button');
                    const btnText = btnElem ? btnElem.textContent || 'Click Me' : 'Click Me';
                    const btnBg = btnElem ? btnElem.style.background || '#2563eb' : '#2563eb';
                    const btnColor = btnElem ? btnElem.style.color || '#ffffff' : '#ffffff';
                    const btnPadding = btnElem ? btnElem.style.padding || '12px 24px' : '12px 24px';
                    const btnRadius = btnElem ? parseInt(btnElem.style.borderRadius) || 6 : 6;
                    const btnFontSize = btnElem ? parseInt(btnElem.style.fontSize) || 16 : 16;
                    
                    html += `
                        <div class="property-group">
                            <label class="property-label">Button Text</label>
                            <input type="text" class="property-input" id="buttonText" value="${btnText}" onchange="updateButtonText(this.value)">
                        </div>
                        <div class="property-group">
                            <label class="property-label">Background Color</label>
                            <div class="color-picker-row">
                                <input type="color" class="color-preview" id="btnBg" value="${btnBg}" onchange="updateButtonStyle('background', this.value)">
                                <input type="text" class="property-input" value="${btnBg}" style="flex: 1;" onchange="document.getElementById('btnBg').value = this.value; updateButtonStyle('background', this.value)">
                            </div>
                        </div>
                        <div class="property-group">
                            <label class="property-label">Text Color</label>
                            <div class="color-picker-row">
                                <input type="color" class="color-preview" id="btnColor" value="${btnColor}" onchange="updateButtonStyle('color', this.value)">
                                <input type="text" class="property-input" value="${btnColor}" style="flex: 1;" onchange="document.getElementById('btnColor').value = this.value; updateButtonStyle('color', this.value)">
                            </div>
                        </div>
                        <div class="property-group">
                            <label class="property-label">Padding</label>
                            <input type="text" class="property-input" value="${btnPadding}" onchange="updateButtonStyle('padding', this.value)">
                        </div>
                        <div class="property-group">
                            <label class="property-label">Border Radius (px)</label>
                            <input type="number" class="property-input" value="${btnRadius}" onchange="updateButtonStyle('borderRadius', this.value + 'px')">
                        </div>
                        <div class="property-group">
                            <label class="property-label">Link URL</label>
                            <input type="url" class="property-input" id="buttonUrl" placeholder="https://" onchange="updateButtonUrl(this.value)">
                        </div>
                        <div class="property-group">
                            <label class="property-label">Font Size (px)</label>
                            <input type="number" class="property-input" value="${btnFontSize}" onchange="updateButtonStyle('fontSize', this.value + 'px')">
                        </div>
                    `;
                    break;
                    
                case 'image':
                    const imgElem = selectedComponent?.querySelector('img');
                    const imgUrl = imgElem ? imgElem.src || 'https://via.placeholder.com/400x200' : 'https://via.placeholder.com/400x200';
                    const imgAlt = imgElem ? imgElem.alt || '' : '';
                    const imgMaxWidth = imgElem ? parseInt(imgElem.style.maxWidth) || 100 : 100;
                    const imgRadius = imgElem ? parseInt(imgElem.style.borderRadius) || 8 : 8;
                    const imgContainer = selectedComponent?.querySelector('div');
                    const imgAlign = imgContainer ? imgContainer.style.textAlign || 'center' : 'center';
                    
                    html += `
                        <div class="property-group">
                            <label class="property-label">Image URL</label>
                            <input type="url" class="property-input" id="imageUrl" value="${imgUrl}" onchange="updateImage(this.value)">
                        </div>
                        <div class="property-group">
                            <label class="property-label">Alt Text</label>
                            <input type="text" class="property-input" value="${imgAlt}" placeholder="Image description" onchange="updateImageAlt(this.value)">
                        </div>
                        <div class="property-group">
                            <label class="property-label">Max Width (%)</label>
                            <input type="number" class="property-input" value="${imgMaxWidth}" min="10" max="100" onchange="updateImageStyle('maxWidth', this.value + '%')">
                        </div>
                        <div class="property-group">
                            <label class="property-label">Border Radius (px)</label>
                            <input type="number" class="property-input" value="${imgRadius}" onchange="updateImageStyle('borderRadius', this.value + 'px')">
                        </div>
                        <div class="property-group">
                            <label class="property-label">Alignment</label>
                            <select class="property-select" onchange="updateImageAlignment(this.value)">
                                <option value="center" ${imgAlign === 'center' ? 'selected' : ''}>Center</option>
                                <option value="left" ${imgAlign === 'left' ? 'selected' : ''}>Left</option>
                                <option value="right" ${imgAlign === 'right' ? 'selected' : ''}>Right</option>
                            </select>
                        </div>
                        <div class="property-group">
                            <label class="property-label">Link URL (optional)</label>
                            <input type="url" class="property-input" placeholder="https://" onchange="updateImageLink(this.value)">
                        </div>
                    `;
                    break;
                    
                case 'card':
                    // For template cards, extract properties dynamically
                    // Get the actual content element (skip component-controls)
                    let cardElem = Array.from(selectedComponent.children).find(child => 
                        !child.classList.contains('component-controls')
                    );
                    if (!cardElem) cardElem = selectedComponent;
                    
                    const headingElem = cardElem.querySelector('h1, h2, h3, h4, h5, h6');
                    const paragraphElems = cardElem.querySelectorAll('p');
                    const buttonElem = cardElem.querySelector('button');
                    const cardImgElem = cardElem.querySelector('img');
                    const inputElems = cardElem.querySelectorAll('input[type="email"], input[type="text"], input[type="password"], input[type="tel"], input[type="number"]');
                    
                    // Extract container properties
                    const cardBg = cardElem.style.background || cardElem.style.backgroundColor || '#ffffff';
                    const cardPadding = cardElem.style.padding || '32px';
