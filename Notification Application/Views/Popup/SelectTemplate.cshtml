@model IEnumerable<Notification_Application.Models.PopupTemplate>
@{
    ViewData["Title"] = "Choose a Template";
    var categories = Model.GroupBy(t => t.Category).OrderBy(g => g.Key).ToList();
}

<style>
    body { background-color: #f8f9fa; }
    
    .template-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 3rem 0 2rem;
        margin-bottom: 2rem;
    }
    
    .template-header h1 {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
    }
    
    .template-header p {
        font-size: 1.2rem;
        opacity: 0.95;
    }
    
    .filter-bar {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    
    .filter-bar .form-control, .filter-bar .form-select {
        border-radius: 8px;
        border: 2px solid #e2e8f0;
        padding: 0.75rem 1rem;
    }
    
    .filter-bar .form-control:focus, .filter-bar .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }
    
    .category-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 2rem;
    }
    
    .category-btn {
        padding: 0.75rem 1.5rem;
        border-radius: 25px;
        background: white;
        border: 2px solid #e2e8f0;
        color: #64748b;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        white-space: nowrap;
    }
    
    .category-btn:hover {
        border-color: #cbd5e1;
        background: #f8fafc;
    }
    
    .category-btn.active {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-color: transparent;
    }
    
    .template-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 2rem;
        margin-bottom: 3rem;
    }
    
    .template-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        border: 2px solid transparent;
        position: relative;
    }
    
    .template-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 16px 32px rgba(0,0,0,0.12);
        border-color: #667eea;
    }
    
    .template-preview {
        position: relative;
        height: 240px;
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
    
    .template-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .template-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 0.4rem 0.9rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .badge-premium { 
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%); 
        color: white;
        box-shadow: 0 4px 8px rgba(251, 191, 36, 0.3);
    }
    
    .badge-new { 
        background: linear-gradient(135deg, #10b981 0%, #059669 100%); 
        color: white;
        box-shadow: 0 4px 8px rgba(16, 185, 129, 0.3);
    }
    
    .badge-popular { 
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); 
        color: white;
        box-shadow: 0 4px 8px rgba(59, 130, 246, 0.3);
    }
    
    .template-info {
        padding: 1.5rem;
    }
    
    .template-category {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #667eea;
        background: #ede9fe;
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        margin-bottom: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .template-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 0.5rem;
        line-height: 1.3;
    }
    
    .template-description {
        font-size: 0.9rem;
        color: #64748b;
        margin-bottom: 1.25rem;
        line-height: 1.6;
    }
    
    .template-actions {
        display: flex;
        gap: 0.75rem;
    }
    
    .btn-use-template {
        flex: 1;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 0.75rem 1.25rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s;
        text-align: center;
        text-decoration: none;
        display: inline-block;
    }
    
    .btn-use-template:hover {
        transform: scale(1.03);
        box-shadow: 0 8px 16px rgba(102, 126, 234, 0.4);
        color: white;
    }
    
    .btn-preview {
        padding: 0.75rem 1.25rem;
        border: 2px solid #e2e8f0;
        background: white;
        color: #64748b;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s;
    }
    
    .btn-preview:hover {
        border-color: #667eea;
        background: #fafbfe;
        color: #667eea;
    }
    
    .blank-card {
        background: linear-gradient(135deg, #ffffff 0%, #fafbfe 100%);
        border: 3px dashed #cbd5e1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem 2rem;
        border-radius: 16px;
        transition: all 0.3s;
        cursor: pointer;
        min-height: 400px;
    }
    
    .blank-card:hover {
        border-color: #667eea;
        background: linear-gradient(135deg, #fafbfe 0%, #f0f3ff 100%);
    }
    
    .blank-icon {
        font-size: 4rem;
        color: #cbd5e1;
        margin-bottom: 1rem;
    }
    
    .blank-card h3 {
        color: #475569;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    
    .blank-card p {
        color: #94a3b8;
        margin-bottom: 1.5rem;
    }
    
    .stats-bar {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        margin-bottom: 2rem;
    }
    
    .stat-item {
        text-align: center;
    }
    
    .stat-number {
        font-size: 2rem;
        font-weight: 800;
        color: #667eea;
        display: block;
    }
    
    .stat-label {
        font-size: 0.9rem;
        color: #64748b;
        font-weight: 600;
    }
</style>

<!-- Header -->
<div class="template-header">
    <div class="container">
        <h1><i class="bi bi-grid-3x3-gap-fill me-3"></i>Template Gallery</h1>
        <p>Choose from professionally designed templates to kickstart your campaign</p>
    </div>
</div>

<div class="container pb-5">
    <!-- Stats Bar -->
    <div class="stats-bar">
        <div class="row">
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <span class="stat-number">@Model.Count()</span>
                    <span class="stat-label">Templates</span>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <span class="stat-number">@categories.Count</span>
                    <span class="stat-label">Categories</span>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <span class="stat-number">@Model.Count(t => t.IsPremium)</span>
                    <span class="stat-label">Premium</span>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <span class="stat-number">New</span>
                    <span class="stat-label">Weekly Updates</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="filter-bar">
        <div class="row align-items-end g-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold mb-2">
                    <i class="bi bi-search me-2"></i>Search Templates
                </label>
                <input type="text" class="form-control" id="searchInput" placeholder="Search by name or description...">
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold mb-2">
                    <i class="bi bi-funnel me-2"></i>Filter by Category
                </label>
                <select class="form-select" id="categoryFilter">
                    <option value="all">All Categories</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category.Key">@category.Key</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold mb-2">
                    <i class="bi bi-sort-down me-2"></i>Sort By
                </label>
                <select class="form-select" id="sortFilter">
                    <option value="name">Name (A-Z)</option>
                    <option value="category">Category</option>
                    <option value="popular">Popular First</option>
                    <option value="new">Newest First</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Category Navigation -->
    <div class="category-nav">
        <button class="category-btn active" data-category="all">
            <i class="bi bi-collection me-2"></i>All Templates
        </button>
        @foreach (var category in categories)
        {
            <button class="category-btn" data-category="@category.Key">
                @if(category.Key == "Email Collection") { <i class="bi bi-envelope me-2"></i> }
                @if(category.Key == "Advertising") { <i class="bi bi-megaphone me-2"></i> }
                @if(category.Key == "Coupon") { <i class="bi bi-tag me-2"></i> }
                @if(category.Key == "Home Services") { <i class="bi bi-house me-2"></i> }
                @if(category.Key == "E-commerce") { <i class="bi bi-cart me-2"></i> }
                @if(category.Key == "Lead Generation") { <i class="bi bi-people me-2"></i> }
                @category.Key
                <span class="badge bg-light text-dark ms-2">@category.Count()</span>
            </button>
        }
    </div>

    <!-- Template Grid -->
    <div class="template-grid" id="templateGrid">
        <!-- Blank Template Card -->
        <div class="template-card blank-template" data-category="all" data-name="blank template">
            <a href="@Url.Action("Designer", "Popup", new { name = "Blank" })" class="text-decoration-none">
                <div class="blank-card">
                    <div class="blank-icon">
                        <i class="bi bi-plus-circle"></i>
                    </div>
                    <h3>Start from Scratch</h3>
                    <p>Create a custom campaign with our drag & drop builder</p>
                    <div class="btn-use-template">
                        <i class="bi bi-plus-lg me-2"></i>Create Blank Campaign
                    </div>
                </div>
            </a>
        </div>

        <!-- Template Cards -->
        @foreach (var template in Model.OrderBy(t => t.SortOrder))
        {
            <div class="template-card" 
                 data-category="@template.Category" 
                 data-name="@template.Name @template.Description"
                 data-popular="@(template.IsPremium ? "yes" : "no")">
                <div class="template-preview">
                    @if (!string.IsNullOrEmpty(template.PreviewImageUrl))
                    {
                        <img src="@template.PreviewImageUrl" alt="@template.Name">
                    }
                    else
                    {
                        <i class="bi bi-image" style="font-size: 4rem; color: #cbd5e1;"></i>
                    }
                    
                    @if (template.IsPremium)
                    {
                        <div class="template-badge badge-premium">
                            <i class="bi bi-star-fill me-1"></i>Premium
                        </div>
                    }
                    else if (template.SortOrder >= 35)
                    {
                        <div class="template-badge badge-new">
                            <i class="bi bi-lightning-fill me-1"></i>New
                        </div>
                    }
                    else if (template.SortOrder % 7 == 0)
                    {
                        <div class="template-badge badge-popular">
                            <i class="bi bi-fire me-1"></i>Popular
                        </div>
                    }
                </div>
                <div class="template-info">
                    <div class="template-category">
                        @template.Category
                    </div>
                    <h3 class="template-title">@template.Name</h3>
                    <p class="template-description">@template.Description</p>
                    <div class="template-actions">
                        <a href="@Url.Action("CreateFromTemplate", "Popup", new { templateId = template.Id })" 
                           class="btn-use-template">
                            <i class="bi bi-plus-lg me-2"></i>Use This Template
                        </a>
                        <button class="btn-preview" onclick="previewTemplate(@template.Id)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Empty State -->
    <div id="emptyState" style="display: none; text-align: center; padding: 4rem 2rem;">
        <i class="bi bi-search" style="font-size: 4rem; color: #cbd5e1; margin-bottom: 1rem;"></i>
        <h3 style="color: #64748b; margin-bottom: 0.5rem;">No templates found</h3>
        <p style="color: #94a3b8;">Try adjusting your filters or search query</p>
    </div>
</div>

@section Scripts {
<script>
    // Filter and Search Functionality
    const searchInput = document.getElementById('searchInput');
    const categoryFilter = document.getElementById('categoryFilter');
    const sortFilter = document.getElementById('sortFilter');
    const templateGrid = document.getElementById('templateGrid');
    const categoryButtons = document.querySelectorAll('.category-btn');
    const emptyState = document.getElementById('emptyState');
    
    let currentCategory = 'all';
    
    // Category button clicks
    categoryButtons.forEach(btn => {
        btn.addEventListener('click', function() {
            categoryButtons.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            currentCategory = this.dataset.category;
            categoryFilter.value = currentCategory;
            filterTemplates();
        });
    });
    
    // Search input
    searchInput.addEventListener('input', filterTemplates);
    
    // Category dropdown
    categoryFilter.addEventListener('change', function() {
        currentCategory = this.value;
        categoryButtons.forEach(btn => {
            btn.classList.toggle('active', btn.dataset.category === currentCategory);
        });
        filterTemplates();
    });
    
    // Sort dropdown
    sortFilter.addEventListener('change', sortTemplates);
    
    function filterTemplates() {
        const searchTerm = searchInput.value.toLowerCase();
        const cards = document.querySelectorAll('.template-card');
        let visibleCount = 0;
        
        cards.forEach(card => {
            const category = card.dataset.category;
            const name = card.dataset.name?.toLowerCase() || '';
            
            const categoryMatch = currentCategory === 'all' || category === currentCategory || card.classList.contains('blank-template');
            const searchMatch = !searchTerm || name.includes(searchTerm);
            
            if (categoryMatch && searchMatch) {
                card.style.display = 'block';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });
        
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        templateGrid.style.display = visibleCount === 0 ? 'none' : 'grid';
    }
    
    function sortTemplates() {
        const sortBy = sortFilter.value;
        const cards = Array.from(document.querySelectorAll('.template-card:not(.blank-template)'));
        const blankCard = document.querySelector('.template-card.blank-template');
        
        cards.sort((a, b) => {
            if (sortBy === 'name') {
                return (a.dataset.name || '').localeCompare(b.dataset.name || '');
            } else if (sortBy === 'category') {
                return (a.dataset.category || '').localeCompare(b.dataset.category || '');
            } else if (sortBy === 'popular') {
                return (b.dataset.popular === 'yes' ? 1 : 0) - (a.dataset.popular === 'yes' ? 1 : 0);
            }
            return 0;
        });
        
        // Clear and re-append
        templateGrid.innerHTML = '';
        templateGrid.appendChild(blankCard);
        cards.forEach(card => templateGrid.appendChild(card));
    }
    
    function previewTemplate(templateId) {
        // TODO: Implement preview modal
        alert('Preview functionality coming soon!');
    }
</script>
}
