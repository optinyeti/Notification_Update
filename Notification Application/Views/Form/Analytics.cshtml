@model dynamic
@{
    ViewData["Title"] = "Form Analytics - " + Model.Form.Name;
    var form = Model.Form as Notification_Application.Models.WebsiteForm;
    var analytics = Model.Analytics as List<Notification_Application.Models.FormAnalytics>;
    var totalViews = analytics?.Sum(a => a.Views) ?? form.Views;
    var totalSubmissions = analytics?.Sum(a => a.Submissions) ?? form.Submissions;
    var avgConversion = totalViews > 0 ? (decimal)totalSubmissions / totalViews * 100 : 0;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Form")">Forms</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Builder", "Form", new { id = form.Id })">@form.Name</a></li>
                    <li class="breadcrumb-item active">Analytics</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0">Analytics</h1>
        </div>
        <div class="d-flex gap-2">
            <select class="form-select" id="dateRange" style="width: auto;" onchange="filterByDate()">
                <option value="7">Last 7 Days</option>
                <option value="30" selected>Last 30 Days</option>
                <option value="90">Last 90 Days</option>
                <option value="365">Last Year</option>
            </select>
            <a href="@Url.Action("Submissions", "Form", new { id = form.Id })" class="btn btn-outline-primary">
                <i class="bi bi-list-check me-2"></i>View Submissions
            </a>
        </div>
    </div>

    <!-- Overview Stats -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-3 me-3">
                            <i class="bi bi-eye text-primary fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Total Views</h6>
                            <h3 class="mb-0">@totalViews.ToString("N0")</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 p-3 rounded-3 me-3">
                            <i class="bi bi-check-circle text-success fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Submissions</h6>
                            <h3 class="mb-0">@totalSubmissions.ToString("N0")</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 p-3 rounded-3 me-3">
                            <i class="bi bi-arrow-repeat text-warning fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Conversion Rate</h6>
                            <h3 class="mb-0">@avgConversion.ToString("F1")%</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-info bg-opacity-10 p-3 rounded-3 me-3">
                            <i class="bi bi-phone text-info fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Mobile Views</h6>
                            @{
                                var mobileViews = analytics?.Sum(a => a.MobileViews) ?? 0;
                                var mobilePercent = totalViews > 0 ? (decimal)mobileViews / totalViews * 100 : 0;
                            }
                            <h3 class="mb-0">@mobilePercent.ToString("F0")%</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Views & Submissions Chart -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="mb-0"><i class="bi bi-graph-up me-2"></i>Views & Submissions Over Time</h6>
                </div>
                <div class="card-body">
                    <canvas id="performanceChart" height="300"></canvas>
                </div>
            </div>
        </div>

        <!-- Device Breakdown -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="mb-0"><i class="bi bi-laptop me-2"></i>Device Breakdown</h6>
                </div>
                <div class="card-body">
                    <canvas id="deviceChart" height="250"></canvas>
                    <div class="mt-3">
                        @{
                            var desktopViews = analytics?.Sum(a => a.DesktopViews) ?? 0;
                            var tabletViews = analytics?.Sum(a => a.TabletViews) ?? 0;
                        }
                        <div class="d-flex justify-content-between mb-2">
                            <span><i class="bi bi-display me-2 text-primary"></i>Desktop</span>
                            <span class="fw-medium">@desktopViews.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span><i class="bi bi-phone me-2 text-success"></i>Mobile</span>
                            <span class="fw-medium">@mobileViews.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span><i class="bi bi-tablet me-2 text-warning"></i>Tablet</span>
                            <span class="fw-medium">@tabletViews.ToString("N0")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Conversion Funnel -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="mb-0"><i class="bi bi-funnel me-2"></i>Conversion Funnel</h6>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Form Views</span>
                            <span class="fw-medium">@totalViews.ToString("N0")</span>
                        </div>
                        <div class="progress" style="height: 30px;">
                            <div class="progress-bar bg-primary" style="width: 100%"></div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Started Filling</span>
                            @{
                                var startedPercent = 65; // Estimated
                                var startedCount = (int)(totalViews * startedPercent / 100);
                            }
                            <span class="fw-medium">~@startedCount.ToString("N0")</span>
                        </div>
                        <div class="progress" style="height: 30px;">
                            <div class="progress-bar bg-info" style="width: @startedPercent%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Completed Submission</span>
                            <span class="fw-medium">@totalSubmissions.ToString("N0")</span>
                        </div>
                        <div class="progress" style="height: 30px;">
                            <div class="progress-bar bg-success" style="width: @avgConversion%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Daily Performance Table -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="mb-0"><i class="bi bi-table me-2"></i>Daily Performance</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="border-0 ps-4">Date</th>
                                    <th class="border-0 text-center">Views</th>
                                    <th class="border-0 text-center">Submissions</th>
                                    <th class="border-0 text-center">Conversion</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (analytics != null && analytics.Any())
                                {
                                    foreach (var day in analytics.OrderByDescending(a => a.Date).Take(10))
                                    {
                                        var dayConversion = day.Views > 0 ? (decimal)day.Submissions / day.Views * 100 : 0;
                                        <tr>
                                            <td class="ps-4">@day.Date.ToString("MMM d")</td>
                                            <td class="text-center">@day.Views.ToString("N0")</td>
                                            <td class="text-center text-success">@day.Submissions.ToString("N0")</td>
                                            <td class="text-center">
                                                <span class="badge bg-@(dayConversion >= 20 ? "success" : dayConversion >= 10 ? "warning" : "secondary")">
                                                    @dayConversion.ToString("F1")%
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">No data available</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const analyticsData = @Html.Raw(analytics != null ? System.Text.Json.JsonSerializer.Serialize(analytics.Select(a => new {
        date = a.Date.ToString("yyyy-MM-dd"),
        views = a.Views,
        submissions = a.Submissions,
        desktopViews = a.DesktopViews,
        mobileViews = a.MobileViews,
        tabletViews = a.TabletViews
    }).OrderBy(a => a.date).ToList()) : "[]");
    
    // Performance Chart
    const perfCtx = document.getElementById('performanceChart').getContext('2d');
    new Chart(perfCtx, {
        type: 'line',
        data: {
            labels: analyticsData.map(d => new Date(d.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })),
            datasets: [{
                label: 'Views',
                data: analyticsData.map(d => d.views),
                borderColor: '#3b82f6',
                backgroundColor: 'rgba(59, 130, 246, 0.1)',
                fill: true,
                tension: 0.4
            }, {
                label: 'Submissions',
                data: analyticsData.map(d => d.submissions),
                borderColor: '#10b981',
                backgroundColor: 'rgba(16, 185, 129, 0.1)',
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'top' }
            },
            scales: {
                y: { beginAtZero: true }
            }
        }
    });
    
    // Device Chart
    const deviceCtx = document.getElementById('deviceChart').getContext('2d');
    const totalDesktop = analyticsData.reduce((sum, d) => sum + d.desktopViews, 0);
    const totalMobile = analyticsData.reduce((sum, d) => sum + d.mobileViews, 0);
    const totalTablet = analyticsData.reduce((sum, d) => sum + d.tabletViews, 0);
    
    new Chart(deviceCtx, {
        type: 'doughnut',
        data: {
            labels: ['Desktop', 'Mobile', 'Tablet'],
            datasets: [{
                data: [totalDesktop || 60, totalMobile || 35, totalTablet || 5],
                backgroundColor: ['#3b82f6', '#10b981', '#f59e0b'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            }
        }
    });
    
    function filterByDate() {
        // In production, this would reload the page with a date filter
        const days = document.getElementById('dateRange').value;
        window.location.href = `?days=${days}`;
    }
</script>
}
