@model Notification_Application.Models.WebsiteForm
@{
    ViewData["Title"] = "Embed Form - " + Model.Name;
    var baseUrl = ViewBag.BaseUrl as string ?? "";
    var embedCode = Model.EmbedCode;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Form")">Forms</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Builder", "Form", new { id = Model.Id })">@Model.Name</a></li>
                    <li class="breadcrumb-item active">Embed</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0">Embed Your Form</h1>
            <p class="text-muted mt-1">Add this form to your website using the embed code below</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Preview", new { id = Model.Id })" target="_blank" class="btn btn-outline-secondary">
                <i class="bi bi-eye me-2"></i>Preview
            </a>
            <a href="@Url.Action("Builder", new { id = Model.Id })" class="btn btn-outline-primary">
                <i class="bi bi-pencil me-2"></i>Edit Form
            </a>
        </div>
    </div>

    @if (Model.Status != Notification_Application.Models.FormStatus.Published)
    {
        <div class="alert alert-warning mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>Form Not Published</strong> - This form is not live. 
            <a href="@Url.Action("Builder", new { id = Model.Id })" class="alert-link">Publish it</a> before embedding.
        </div>
    }

    <div class="row">
        <!-- Embed Code Section -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0"><i class="bi bi-code-slash me-2"></i>Embed Code</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">Copy and paste this code into your website where you want the form to appear.</p>
                    
                    <div class="position-relative">
                        <pre class="bg-dark text-light p-3 rounded" style="white-space: pre-wrap; word-break: break-all;"><code id="embedCode">&lt;div id="optinyeti-form-@embedCode"&gt;&lt;/div&gt;
&lt;script src="@baseUrl/api/FormApi/embed.js" data-form="@embedCode" data-container="optinyeti-form-@embedCode" async&gt;&lt;/script&gt;</code></pre>
                        <button type="button" class="btn btn-sm btn-primary position-absolute" 
                                style="top: 10px; right: 10px;" onclick="copyToClipboard('embedCode')">
                            <i class="bi bi-clipboard me-1"></i>Copy
                        </button>
                    </div>
                </div>
            </div>

            <!-- Direct Link Section -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0"><i class="bi bi-link-45deg me-2"></i>Direct Link</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">Share this link directly to your form. Opens in a standalone page.</p>
                    
                    @{
                        var directLink = $"{baseUrl}/api/FormApi/standalone/{embedCode}";
                    }
                    <div class="input-group">
                        <input type="text" class="form-control" id="directLink" value="@directLink" readonly>
                        <button type="button" class="btn btn-outline-primary" onclick="copyToClipboard('directLink')">
                            <i class="bi bi-clipboard me-1"></i>Copy
                        </button>
                        <a href="@directLink" target="_blank" class="btn btn-outline-secondary">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Open
                        </a>
                    </div>
                </div>
            </div>

            <!-- WordPress Section -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0"><i class="bi bi-wordpress me-2"></i>WordPress Shortcode</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">If you're using WordPress, you can add the embed code in an HTML block or use this approach.</p>
                    
                    <div class="position-relative">
                        <pre class="bg-dark text-light p-3 rounded"><code id="wpCode">&lt;!-- Add to your theme's functions.php or use a code snippets plugin --&gt;
[optinyeti_form id="@embedCode"]</code></pre>
                        <button type="button" class="btn btn-sm btn-primary position-absolute" 
                                style="top: 10px; right: 10px;" onclick="copyToClipboard('wpCode')">
                            <i class="bi bi-clipboard me-1"></i>Copy
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Preview & Settings Sidebar -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Form Details</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-5 text-muted">Name</dt>
                        <dd class="col-7">@Model.Name</dd>
                        
                        <dt class="col-5 text-muted">Status</dt>
                        <dd class="col-7">
                            @if (Model.Status == Notification_Application.Models.FormStatus.Published)
                            {
                                <span class="badge bg-success">Published</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Draft</span>
                            }
                        </dd>
                        
                        <dt class="col-5 text-muted">Embed Code</dt>
                        <dd class="col-7"><code>@embedCode</code></dd>
                        
                        <dt class="col-5 text-muted">Submissions</dt>
                        <dd class="col-7">@Model.Submissions</dd>
                        
                        <dt class="col-5 text-muted">Views</dt>
                        <dd class="col-7">@Model.Views</dd>
                        
                        <dt class="col-5 text-muted">Conversion</dt>
                        <dd class="col-7">@Model.ConversionRate.ToString("F1")%</dd>
                    </dl>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0"><i class="bi bi-eye me-2"></i>Live Preview</h5>
                </div>
                <div class="card-body p-0">
                    <iframe src="@Url.Action("Preview", new { id = Model.Id })" 
                            style="width: 100%; height: 400px; border: none;"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function copyToClipboard(elementId) {
        const el = document.getElementById(elementId);
        const text = el.tagName === 'INPUT' ? el.value : el.textContent;
        
        navigator.clipboard.writeText(text).then(() => {
            // Show success feedback
            const btn = event.target.closest('button');
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check me-1"></i>Copied!';
            btn.classList.remove('btn-primary', 'btn-outline-primary');
            btn.classList.add('btn-success');
            
            setTimeout(() => {
                btn.innerHTML = originalHtml;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-primary');
            }, 2000);
        });
    }
</script>
}
