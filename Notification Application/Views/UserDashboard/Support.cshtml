@model IEnumerable<SupportTicket>
@{
    ViewData["Title"] = "Support Tickets";
}

<div class="max-w-7xl mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Support Tickets</h1>
            <p class="text-gray-600 mt-2">View and manage your support requests</p>
        </div>
        <a href="@Url.Action("CreateSupportTicket")" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold transition shadow-md flex items-center gap-2">
            <i class="bi bi-plus-circle"></i>
            Create Ticket
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-6 bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg">
            <i class="bi bi-check-circle-fill mr-2"></i>
            @TempData["Success"]
        </div>
    }

    <!-- Tickets List -->
    @if (Model.Any())
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ticket ID</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Subject</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Priority</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Messages</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var ticket in Model.OrderByDescending(t => t.CreatedAt))
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                    #@ticket.Id
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-900">
                                    <div class="max-w-xs truncate">@ticket.Subject</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    @switch (ticket.Category)
                                    {
                                        case TicketCategory.Technical:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                                                <i class="bi bi-tools mr-1"></i> Technical
                                            </span>
                                            break;
                                        case TicketCategory.Billing:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                <i class="bi bi-credit-card mr-1"></i> Billing
                                            </span>
                                            break;
                                        case TicketCategory.FeatureRequest:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                <i class="bi bi-lightbulb mr-1"></i> Feature Request
                                            </span>
                                            break;
                                        case TicketCategory.BugReport:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                                <i class="bi bi-bug mr-1"></i> Bug Report
                                            </span>
                                            break;
                                        default:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                                <i class="bi bi-question-circle mr-1"></i> General
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    @switch (ticket.Priority)
                                    {
                                        case TicketPriority.Critical:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                                <i class="bi bi-exclamation-triangle-fill mr-1"></i> Critical
                                            </span>
                                            break;
                                        case TicketPriority.High:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                                <i class="bi bi-exclamation-circle-fill mr-1"></i> High
                                            </span>
                                            break;
                                        case TicketPriority.Low:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                <i class="bi bi-info-circle mr-1"></i> Low
                                            </span>
                                            break;
                                        default:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                                <i class="bi bi-dash-circle mr-1"></i> Medium
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    @switch (ticket.Status)
                                    {
                                        case TicketStatus.Open:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                <i class="bi bi-circle-fill mr-1" style="font-size: 6px;"></i> Open
                                            </span>
                                            break;
                                        case TicketStatus.InProgress:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                <i class="bi bi-arrow-repeat mr-1"></i> In Progress
                                            </span>
                                            break;
                                        case TicketStatus.Waiting:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                                <i class="bi bi-hourglass-split mr-1"></i> Waiting
                                            </span>
                                            break;
                                        case TicketStatus.Resolved:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                                                <i class="bi bi-check-circle mr-1"></i> Resolved
                                            </span>
                                            break;
                                        case TicketStatus.Closed:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                                <i class="bi bi-x-circle mr-1"></i> Closed
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    @ticket.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                        <i class="bi bi-chat-dots mr-1"></i> @ticket.Messages.Count
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                    <a href="@Url.Action("SupportTicket", new { id = ticket.Id })" class="text-blue-600 hover:text-blue-900">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-12 text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-100 rounded-full mb-4">
                <i class="bi bi-ticket-detailed text-blue-600 text-2xl"></i>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">No Support Tickets</h3>
            <p class="text-gray-600 mb-6">You haven't created any support tickets yet.</p>
            <a href="@Url.Action("CreateSupportTicket")" class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold transition">
                <i class="bi bi-plus-circle mr-2"></i>
                Create Your First Ticket
            </a>
        </div>
    }

    <!-- Quick Help Section -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
            <div class="flex items-start">
                <div class="flex-shrink-0">
                    <i class="bi bi-book text-blue-600 text-2xl"></i>
                </div>
                <div class="ml-4">
                    <h4 class="text-lg font-semibold text-gray-900 mb-2">Documentation</h4>
                    <p class="text-sm text-gray-600 mb-3">Find answers in our comprehensive guides and tutorials.</p>
                    <a href="#" class="text-sm text-blue-600 hover:text-blue-800 font-medium">
                        Browse Docs <i class="bi bi-arrow-right ml-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="bg-green-50 border border-green-200 rounded-lg p-6">
            <div class="flex items-start">
                <div class="flex-shrink-0">
                    <i class="bi bi-chat-square-dots text-green-600 text-2xl"></i>
                </div>
                <div class="ml-4">
                    <h4 class="text-lg font-semibold text-gray-900 mb-2">Community</h4>
                    <p class="text-sm text-gray-600 mb-3">Connect with other users and share experiences.</p>
                    <a href="#" class="text-sm text-green-600 hover:text-green-800 font-medium">
                        Join Community <i class="bi bi-arrow-right ml-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="bg-purple-50 border border-purple-200 rounded-lg p-6">
            <div class="flex items-start">
                <div class="flex-shrink-0">
                    <i class="bi bi-envelope text-purple-600 text-2xl"></i>
                </div>
                <div class="ml-4">
                    <h4 class="text-lg font-semibold text-gray-900 mb-2">Email Support</h4>
                    <p class="text-sm text-gray-600 mb-3">Reach us directly at support@example.com</p>
                    <a href="mailto:support@example.com" class="text-sm text-purple-600 hover:text-purple-800 font-medium">
                        Send Email <i class="bi bi-arrow-right ml-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
