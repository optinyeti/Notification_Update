    <!-- Forms Section -->
    <div class="bg-white rounded-lg shadow border p-6 mb-8">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-xl font-semibold text-gray-900">
                    <i class="fas fa-file-alt me-2 text-green-600"></i>Website Forms
                </h2>
                <p class="text-sm text-gray-500 mt-1">Capture leads with embeddable forms</p>
            </div>
            <a asp-controller="Form" asp-action="Index" class="text-green-600 hover:text-green-800 text-sm font-medium">
                Manage Forms <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>

        <!-- Forms Stats Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-green-50 p-4 rounded-lg">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-medium text-green-600">Total Forms</span>
                    <i class="fas fa-file-alt text-green-400"></i>
                </div>
                <p class="text-2xl font-bold text-green-900">@(Model?.TotalForms ?? 0)</p>
            </div>
            <div class="bg-emerald-50 p-4 rounded-lg">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-medium text-emerald-600">Published</span>
                    <i class="fas fa-check-circle text-emerald-400"></i>
                </div>
                <p class="text-2xl font-bold text-emerald-900">@(Model?.PublishedForms ?? 0)</p>
            </div>
            <div class="bg-teal-50 p-4 rounded-lg">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-medium text-teal-600">Submissions</span>
                    <i class="fas fa-inbox text-teal-400"></i>
                </div>
                <p class="text-2xl font-bold text-teal-900">@(Model?.TotalFormSubmissions ?? 0)</p>
            </div>
            <div class="bg-cyan-50 p-4 rounded-lg">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-medium text-cyan-600">This Week</span>
                    <i class="fas fa-calendar-week text-cyan-400"></i>
                </div>
                <p class="text-2xl font-bold text-cyan-900">@(Model?.FormSubmissionsThisWeek ?? 0)</p>
            </div>
        </div>

        <!-- Recent Forms -->
        @if (Model?.RecentForms != null && Model.RecentForms.Any())
        {
            <div class="border-t pt-4">
                <h3 class="text-sm font-semibold text-gray-700 mb-3">Recent Forms</h3>
                <div class="space-y-2">
                    @foreach (var form in Model.RecentForms)
                    {
                        <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-file-alt text-green-600"></i>
                                </div>
                                <div>
                                    <p class="font-medium text-gray-900">@form.Name</p>
                                    <p class="text-xs text-gray-500">@form.Submissions submissions • @form.Views views</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-1 text-xs rounded-full @(form.Status == FormStatus.Published ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-600")">
                                    @form.Status
                                </span>
                                <a asp-controller="Form" asp-action="Builder" asp-route-id="@form.Id" class="text-green-600 hover:text-green-800">
                                    <i class="fas fa-edit"></i>
                                </a>
