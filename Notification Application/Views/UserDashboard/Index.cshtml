        <a asp-controller="Form" asp-action="Create" class="block bg-gradient-to-br from-purple-500 to-purple-600 text-white p-6 rounded-lg shadow-lg hover:shadow-xl transition">
            <div class="flex items-center gap-4">
                <div class="bg-white/20 p-3 rounded-lg">
                    <i class="fas fa-file-alt text-2xl"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-lg">Create Form</h3>
                    <p class="text-purple-100 text-sm">Build a new lead form</p>
                </div>
            </div>
        </a>

        <a asp-controller="Crm" asp-action="CreateDeal" class="block bg-gradient-to-br from-green-500 to-green-600 text-white p-6 rounded-lg shadow-lg hover:shadow-xl transition">
            <div class="flex items-center gap-4">
                <div class="bg-white/20 p-3 rounded-lg">
                    <i class="fas fa-handshake text-2xl"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-lg">Create a Deal</h3>
                    <p class="text-green-100 text-sm">Add a new deal to pipeline</p>
                </div>
            </div>
        </a>
