                <a asp-controller="Form" asp-action="Create" class="text-green-600 hover:text-green-800 text-sm mt-1 inline-block">
                    Create your first form <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
        }
    </div>

    @if (Model?.HasCrmAccess == true)
    {
        <!-- Sales Pipeline Visual Widget (Pro+ Only) -->
        <div class="bg-white rounded-lg shadow border p-6 mb-8">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h2 class="text-xl font-semibold text-gray-900">
                        <i class="fas fa-chart-line me-2 text-indigo-600"></i>Sales Pipeline
                    </h2>
                    <p class="text-sm text-gray-500 mt-1">Visual overview of your active pipelines</p>
                </div>
                <a asp-controller="Crm" asp-action="Pipelines" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">
                    Manage Pipelines <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>

            @if (Model?.Pipelines != null && Model.Pipelines.Any())
            {
                <div class="space-y-6">
                    @foreach (var pipeline in Model.Pipelines.Take(3))
                    {
                        // Filter deals where the Lead belongs to this pipeline
                        var pipelineDeals = Model.RecentDeals?
                            .Where(d => d.Lead != null && d.Lead.PipelineId == pipeline.Id)
                            .ToList() ?? new List<Deal>();
                        var pipelineValue = pipelineDeals.Sum(d => d.Amount);
                        
                        <div class="border rounded-lg p-4">
                            <div class="flex items-center justify-between mb-4">
                                <div>
                                    <h3 class="font-semibold text-gray-900">@pipeline.Name</h3>
                                    <p class="text-sm text-gray-500">@pipelineDeals.Count deals • @pipelineValue.ToString("C0") total value</p>
                                </div>
                            </div>
                            
                            @if (pipeline.Stages != null && pipeline.Stages.Any())
                            {
                                <!-- Pipeline Stage Flow -->
                                <div class="grid gap-2" style="grid-template-columns: repeat(@pipeline.Stages.Count, 1fr);">
                                    @foreach (var stage in pipeline.Stages.OrderBy(s => s.Order))
                                    {
                                        var stageDeals = pipelineDeals.Where(d => d.Lead != null && d.Lead.StageId == stage.Id).ToList();
                                        var stageValue = stageDeals.Sum(d => d.Amount);
                                        var stageColor = stage.Color ?? "#6366f1";
                                        
                                        <div class="relative">
                                            <div class="bg-gray-50 rounded-lg p-3 border-2 hover:shadow-md transition cursor-pointer" 
                                                 style="border-color: @stageColor;"
                                                 title="@stage.Name: @stageDeals.Count deals">
                                                <div class="text-xs font-medium text-gray-700 mb-1 truncate">@stage.Name</div>
                                                <div class="flex items-center justify-between">
                                                    <span class="text-lg font-bold" style="color: @stageColor;">@stageDeals.Count</span>
                                                    <span class="text-xs text-gray-500">@stageValue.ToString("C0")</span>
                                                </div>
                                                @if (stageDeals.Any())
                                                {
                                                    <div class="mt-2 pt-2 border-t">
                                                        <div class="space-y-1">
                                                            @foreach (var deal in stageDeals.Take(2))
                                                            {
                                                                <div class="text-xs text-gray-600 truncate">
                                                                    <i class="fas fa-circle text-xs me-1" style="color: @stageColor; font-size: 6px;"></i>
                                                                    @deal.Name
                                                                </div>
                                                            }
                                                            @if (stageDeals.Count > 2)
                                                            {
                                                                <div class="text-xs text-gray-400">+@(stageDeals.Count - 2) more</div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-8 text-gray-500">
                    <i class="fas fa-funnel-dollar text-4xl text-gray-300 mb-3"></i>
                    <p>No pipelines configured yet</p>
                    <a asp-controller="Crm" asp-action="Pipelines" class="text-indigo-600 hover:text-indigo-800 text-sm mt-2 inline-block">
                        Create your first pipeline <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            }
        </div>

        <!-- Pipeline & Deals Section (Pro+ Only) -->
        <div class="bg-white rounded-lg shadow border p-6 mb-8">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h2 class="text-xl font-semibold text-gray-900">
                        <i class="fas fa-funnel-dollar me-2 text-indigo-600"></i>Deals Overview
                    </h2>
                    <p class="text-sm text-gray-500 mt-1">Performance metrics for your deals</p>
                </div>
                <a asp-controller="Crm" asp-action="Deals" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">
                    View All Deals <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>

            <!-- Pipeline Stats Grid -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                <div class="bg-indigo-50 p-4 rounded-lg">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-medium text-indigo-600">Open Deals</span>
                        <i class="fas fa-handshake text-indigo-400"></i>
                    </div>
                    <p class="text-2xl font-bold text-indigo-900">@(Model?.OpenDeals ?? 0)</p>
                </div>
                <div class="bg-emerald-50 p-4 rounded-lg">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-medium text-emerald-600">Won Deals</span>
                        <i class="fas fa-trophy text-emerald-400"></i>
                    </div>
                    <p class="text-2xl font-bold text-emerald-900">@(Model?.WonDeals ?? 0)</p>
                </div>
                <div class="bg-amber-50 p-4 rounded-lg">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-medium text-amber-600">Total Value</span>
                        <i class="fas fa-dollar-sign text-amber-400"></i>
                    </div>
                    <p class="text-2xl font-bold text-amber-900">@((Model?.TotalDealValue ?? 0).ToString("C0"))</p>
                </div>
                <div class="bg-green-50 p-4 rounded-lg">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-medium text-green-600">Won Value</span>
                        <i class="fas fa-check-circle text-green-400"></i>
                    </div>
                    <p class="text-2xl font-bold text-green-900">@((Model?.WonDealValue ?? 0).ToString("C0"))</p>
                </div>
            </div>

            <!-- Recent Deals -->
            @if (Model?.RecentDeals != null && Model.RecentDeals.Any())
            {
                <div class="border-t pt-4">
                    <h3 class="text-sm font-semibold text-gray-700 mb-3">Recent Deals</h3>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead>
                                <tr>
                                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Deal</th>
                                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Lead</th>
                                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Value</th>
                                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Probability</th>
                                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                @foreach (var deal in Model.RecentDeals)
                                {
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-4 py-3">
                                            <span class="font-medium text-gray-900">@deal.Name</span>
                                        </td>
                                        <td class="px-4 py-3 text-sm text-gray-600">
                                            @(deal.Lead != null ? $"{deal.Lead.FirstName} {deal.Lead.LastName}".Trim() : "N/A")
                                        </td>
                                        <td class="px-4 py-3 text-sm font-medium text-gray-900">
                                            @deal.Amount.ToString("C0")
                                        </td>
                                        <td class="px-4 py-3">
                                            <span class="text-sm text-gray-500">@((deal.Probability).ToString("0"))%</span>
                                        </td>
                                        <td class="px-4 py-3">
                                            <span class="px-2 py-1 text-xs rounded-full @(deal.Status == DealStatus.Won ? "bg-green-100 text-green-800" : deal.Status == DealStatus.Lost ? "bg-red-100 text-red-800" : "bg-blue-100 text-blue-800")">
                                                @deal.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-6 text-gray-500">
                    <i class="fas fa-handshake text-3xl text-gray-300 mb-2"></i>
                    <p>No deals yet</p>
                    <p class="text-sm mt-1">Deals are created when you qualify leads in your pipeline</p>
                </div>
            }
        </div>

        <!-- Recent Activity Section (Pro+ Only) -->
        <div class="bg-white rounded-lg shadow border p-6 mb-8">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h2 class="text-xl font-semibold text-gray-900">
                        <i class="fas fa-history me-2 text-purple-600"></i>Recent Activity
                    </h2>
                    <p class="text-sm text-gray-500 mt-1">@(Model?.ActivitiesToday ?? 0) activities today</p>
                </div>
            </div>

            @if (Model?.RecentActivities != null && Model.RecentActivities.Any())
            {
                <div class="space-y-3">
                    @foreach (var activity in Model.RecentActivities.Take(8))
                    {
                        <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center @GetActivityIconClass(activity.Type)">
                                <i class="@GetActivityIcon(activity.Type) text-sm"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm text-gray-900">
                                    <span class="font-medium">@(activity.PerformedBy?.FirstName ?? "System")</span>
                                    @GetActivityDescription(activity.Type)
                                    @if (activity.Lead != null)
                                    {
                                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@activity.LeadId" class="text-blue-600 hover:underline">
                                            @(!string.IsNullOrEmpty(activity.Lead.FirstName) ? $"{activity.Lead.FirstName} {activity.Lead.LastName}".Trim() : activity.Lead.Email)
                                        </a>
                                    }
                                </p>
                                @if (!string.IsNullOrEmpty(activity.Description))
                                {
                                    <p class="text-xs text-gray-500 mt-1">@activity.Description</p>
                                }
                                <p class="text-xs text-gray-400 mt-1">@activity.CreatedAt.ToString("MMM dd, h:mm tt")</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-6 text-gray-500">
                    <i class="fas fa-history text-3xl text-gray-300 mb-2"></i>
                    <p>No recent activity</p>
                </div>
            }
        </div>
    }

    <!-- Quick Actions -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
