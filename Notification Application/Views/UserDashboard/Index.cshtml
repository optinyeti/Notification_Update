    <!-- Quick Links & Support -->
    <div class="bg-white rounded-lg shadow border p-6 mb-8">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">
            <i class="fas fa-link me-2 text-blue-600"></i>Quick Links & Support
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <a asp-controller="UserDashboard" asp-action="Usage" class="flex items-center gap-3 p-4 border rounded-lg hover:bg-gray-50 transition">
