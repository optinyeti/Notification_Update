            <a asp-controller="UserDashboard" asp-action="Support" class="flex items-center gap-3 p-4 border rounded-lg hover:bg-gray-50 transition">
                <i class="fas fa-life-ring text-orange-500 text-xl"></i>
                <div>
                    <div class="font-medium text-gray-900">Support</div>
                    <div class="text-sm text-gray-500">Get help and support</div>
                </div>
            </a>
