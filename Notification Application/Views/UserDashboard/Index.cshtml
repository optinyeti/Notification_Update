@{
    ViewData["Title"] = "Dashboard";
}

<div class="max-w-7xl mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">My Dashboard</h1>
        <p class="text-gray-600 mt-2">Welcome back! Here's an overview of your account.</p>
    </div>

    <!-- Quick Actions -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <a asp-controller="Popup" asp-action="CreateCampaign" class="block bg-gradient-to-br from-blue-500 to-blue-600 text-white p-6 rounded-lg shadow-lg hover:shadow-xl transition">
            <div class="flex items-center gap-4">
                <div class="bg-white/20 p-3 rounded-lg">
                    <i class="fas fa-plus text-2xl"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-lg">Create Campaign</h3>
                    <p class="text-blue-100 text-sm">Start a new popup campaign</p>
                </div>
            </div>
        </a>

        <a asp-controller="Popup" asp-action="Index" class="block bg-gradient-to-br from-purple-500 to-purple-600 text-white p-6 rounded-lg shadow-lg hover:shadow-xl transition">
            <div class="flex items-center gap-4">
                <div class="bg-white/20 p-3 rounded-lg">
                    <i class="fas fa-window-restore text-2xl"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-lg">My Popups</h3>
                    <p class="text-purple-100 text-sm">View and manage campaigns</p>
                </div>
            </div>
        </a>

        <a asp-controller="Template" asp-action="SelectTemplate" class="block bg-gradient-to-br from-green-500 to-green-600 text-white p-6 rounded-lg shadow-lg hover:shadow-xl transition">
            <div class="flex items-center gap-4">
                <div class="bg-white/20 p-3 rounded-lg">
                    <i class="fas fa-palette text-2xl"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-lg">Templates</h3>
                    <p class="text-green-100 text-sm">Browse popup templates</p>
                </div>
            </div>
        </a>
    </div>

    <!-- Stats Overview -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white p-6 rounded-lg shadow border">
            <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-medium text-gray-600">Total Campaigns</h3>
                <i class="fas fa-chart-line text-blue-500"></i>
            </div>
            <p class="text-3xl font-bold text-gray-900">0</p>
            <p class="text-xs text-gray-500 mt-2">All time</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow border">
            <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-medium text-gray-600">Active Popups</h3>
                <i class="fas fa-toggle-on text-green-500"></i>
            </div>
            <p class="text-3xl font-bold text-gray-900">0</p>
            <p class="text-xs text-gray-500 mt-2">Currently live</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow border">
            <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-medium text-gray-600">Total Views</h3>
                <i class="fas fa-eye text-purple-500"></i>
            </div>
            <p class="text-3xl font-bold text-gray-900">0</p>
            <p class="text-xs text-gray-500 mt-2">Last 30 days</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow border">
            <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-medium text-gray-600">Conversions</h3>
                <i class="fas fa-check-circle text-orange-500"></i>
            </div>
            <p class="text-3xl font-bold text-gray-900">0</p>
            <p class="text-xs text-gray-500 mt-2">Last 30 days</p>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="bg-white rounded-lg shadow border p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Quick Links</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a asp-controller="UserDashboard" asp-action="Usage" class="flex items-center gap-3 p-4 border rounded-lg hover:bg-gray-50 transition">
                <i class="fas fa-chart-bar text-blue-500 text-xl"></i>
                <div>
                    <div class="font-medium text-gray-900">Usage & Limits</div>
                    <div class="text-sm text-gray-500">View your plan usage</div>
                </div>
            </a>

            <a asp-controller="UserDashboard" asp-action="Analytics" class="flex items-center gap-3 p-4 border rounded-lg hover:bg-gray-50 transition">
                <i class="fas fa-chart-line text-purple-500 text-xl"></i>
                <div>
                    <div class="font-medium text-gray-900">Analytics</div>
                    <div class="text-sm text-gray-500">View campaign performance</div>
                </div>
            </a>

            <a asp-controller="UserDashboard" asp-action="Support" class="flex items-center gap-3 p-4 border rounded-lg hover:bg-gray-50 transition">
                <i class="fas fa-life-ring text-orange-500 text-xl"></i>
                <div>
                    <div class="font-medium text-gray-900">Support</div>
                    <div class="text-sm text-gray-500">Get help and support</div>
                </div>
            </a>
        </div>
    </div>
</div>
