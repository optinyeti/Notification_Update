@using Notification_Application.Models
@using Notification_Application.Controllers
@model UserDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

@functions {
    string GetStatusClass(LeadStatus status)
    {
        return status switch
        {
            LeadStatus.New => "bg-blue-100 text-blue-800",
            LeadStatus.Contacted => "bg-yellow-100 text-yellow-800",
            LeadStatus.Qualified => "bg-green-100 text-green-800",
            LeadStatus.Converted => "bg-purple-100 text-purple-800",
            LeadStatus.Unqualified => "bg-red-100 text-red-800",
            LeadStatus.Archived => "bg-gray-100 text-gray-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    string GetActivityIcon(ActivityType type)
    {
        return type switch
        {
            ActivityType.LeadCreated => "fas fa-plus",
            ActivityType.StatusChanged => "fas fa-exchange-alt",
            ActivityType.StageChanged => "fas fa-arrow-right",
            ActivityType.Note => "fas fa-sticky-note",
            ActivityType.Email => "fas fa-envelope",
            ActivityType.Call => "fas fa-phone",
            ActivityType.Meeting => "fas fa-calendar",
            ActivityType.Task => "fas fa-check",
            ActivityType.DealCreated => "fas fa-handshake",
            ActivityType.DealUpdated => "fas fa-edit",
            ActivityType.FormSubmitted => "fas fa-file-alt",
            _ => "fas fa-info-circle"
        };
    }

    string GetActivityIconClass(ActivityType type)
    {
        return type switch
        {
            ActivityType.LeadCreated => "bg-green-100 text-green-600",
            ActivityType.StatusChanged => "bg-blue-100 text-blue-600",
            ActivityType.StageChanged => "bg-indigo-100 text-indigo-600",
            ActivityType.Note => "bg-yellow-100 text-yellow-600",
            ActivityType.Email => "bg-purple-100 text-purple-600",
            ActivityType.Call => "bg-orange-100 text-orange-600",
            ActivityType.Meeting => "bg-pink-100 text-pink-600",
            ActivityType.Task => "bg-emerald-100 text-emerald-600",
            ActivityType.DealCreated => "bg-cyan-100 text-cyan-600",
            ActivityType.DealUpdated => "bg-teal-100 text-teal-600",
            ActivityType.FormSubmitted => "bg-lime-100 text-lime-600",
            _ => "bg-gray-100 text-gray-600"
        };
    }

    string GetActivityDescription(ActivityType type)
    {
        return type switch
        {
            ActivityType.LeadCreated => "created lead",
            ActivityType.StatusChanged => "changed status of",
            ActivityType.StageChanged => "moved to new stage",
            ActivityType.Note => "added a note to",
            ActivityType.Email => "sent email to",
            ActivityType.Call => "called",
            ActivityType.Meeting => "scheduled meeting with",
            ActivityType.Task => "completed task for",
            ActivityType.DealCreated => "created deal for",
            ActivityType.DealUpdated => "updated deal for",
            ActivityType.FormSubmitted => "submitted form for",
            _ => "updated"
        };
    }
}

<div class="max-w-7xl mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">My Dashboard</h1>
        <p class="text-gray-600 mt-2">Welcome back! Here's an overview of your account.</p>
    </div>

    <!-- Onboarding Checklist Widget -->
    @{
        var progress = ViewBag.OnboardingProgress as OnboardingProgress;
        var showOnboarding = progress != null && !progress.HasDismissed && !progress.IsComplete;
    }
    @if (showOnboarding)
    {
        <div id="onboardingWidget" class="mb-8 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl border-2 border-blue-200 p-6 shadow-lg relative">
            <button onclick="dismissOnboarding()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition-colors">
                <i class="fas fa-times text-xl"></i>
            </button>

            <div class="flex items-start gap-4 mb-6">
                <div class="bg-gradient-to-br from-blue-500 to-indigo-600 rounded-xl p-3 shadow-lg">
                    <i class="fas fa-rocket text-white text-2xl"></i>
                </div>
                <div class="flex-1">
                    <h2 class="text-2xl font-bold text-gray-900">Get Started with OptinYeti</h2>
                    <p class="text-gray-600 mt-1">Complete these steps to unlock the full power of your account</p>
                </div>
            </div>

            <!-- Progress Bar -->
            <div class="mb-6">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-sm font-semibold text-gray-700">Overall Progress</span>
                    <span class="text-sm font-bold text-blue-600">@progress.CompletionPercentage%</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-3 overflow-hidden">
                    <div class="bg-gradient-to-r from-blue-500 to-indigo-600 h-full transition-all duration-500 ease-out"
                         style="width: @progress.CompletionPercentage%"></div>
                </div>
            </div>

            <!-- Checklist -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Step 1: Add Website -->
                <div class="flex items-center gap-3 p-4 bg-white rounded-lg @(progress.HasAddedWebsite ? "border-2 border-green-300" : "border border-gray-200")">
                    <div class="flex-shrink-0">
                        @if (progress.HasAddedWebsite)
                        {
                            <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center">
                                <i class="fas fa-check text-white text-lg"></i>
                            </div>
                        }
                        else
                        {
                            <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center">
                                <i class="fas fa-globe text-gray-400"></i>
                            </div>
                        }
                    </div>
                    <div class="flex-1">
                        <h3 class="font-semibold text-gray-900">Add Your Website</h3>
                        <p class="text-sm text-gray-600">Connect your domain to start tracking</p>
                    </div>
                    @if (!progress.HasAddedWebsite)
                    {
                        <a asp-controller="Integration" asp-action="Index" class="px-3 py-1 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700 transition-colors">
                            Start
                        </a>
                    }
                </div>

                <!-- Step 2: Create Popup -->
                <div class="flex items-center gap-3 p-4 bg-white rounded-lg @(progress.HasCreatedPopup ? "border-2 border-green-300" : "border border-gray-200")">
                    <div class="flex-shrink-0">
                        @if (progress.HasCreatedPopup)
                        {
                            <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center">
                                <i class="fas fa-check text-white text-lg"></i>
                            </div>
                        }
                        else
                        {
                            <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center">
                                <i class="fas fa-window-maximize text-gray-400"></i>
                            </div>
                        }
                    </div>
                    <div class="flex-1">
                        <h3 class="font-semibold text-gray-900">Create Your First Popup</h3>
                        <p class="text-sm text-gray-600">Design and launch a popup campaign</p>
                    </div>
                    @if (!progress.HasCreatedPopup)
                    {
                        <a asp-controller="Popup" asp-action="CreateCampaign" class="px-3 py-1 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700 transition-colors">
                            Start
                        </a>
                    }
                </div>

                <!-- Step 3: Install Pixel -->
                <div class="flex items-center gap-3 p-4 bg-white rounded-lg @(progress.HasInstalledPixel ? "border-2 border-green-300" : "border border-gray-200")">
                    <div class="flex-shrink-0">
                        @if (progress.HasInstalledPixel)
                        {
                            <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center">
                                <i class="fas fa-check text-white text-lg"></i>
                            </div>
                        }
                        else
                        {
                            <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center">
                                <i class="fas fa-code text-gray-400"></i>
                            </div>
                        }
                    </div>
                    <div class="flex-1">
                        <h3 class="font-semibold text-gray-900">Install Tracking Pixel</h3>
                        <p class="text-sm text-gray-600">Add tracking code to your website</p>
                    </div>
                    @if (!progress.HasInstalledPixel)
                    {
                        <a asp-controller="Integration" asp-action="Index" class="px-3 py-1 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700 transition-colors">
                            Start
                        </a>
                    }
                </div>

                <!-- Step 4: Connect Integration -->
                <div class="flex items-center gap-3 p-4 bg-white rounded-lg @(progress.HasConnectedIntegration ? "border-2 border-green-300" : "border border-gray-200")">
                    <div class="flex-shrink-0">
                        @if (progress.HasConnectedIntegration)
                        {
                            <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center">
                                <i class="fas fa-check text-white text-lg"></i>
                            </div>
                        }
                        else
                        {
                            <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center">
                                <i class="fas fa-plug text-gray-400"></i>
                            </div>
                        }
                    </div>
                    <div class="flex-1">
                        <h3 class="font-semibold text-gray-900">Connect an Integration</h3>
                        <p class="text-sm text-gray-600">Sync leads to your favorite tools</p>
                    </div>
                    @if (!progress.HasConnectedIntegration)
                    {
                        <a asp-controller="Integration" asp-action="Index" class="px-3 py-1 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700 transition-colors">
                            Start
                        </a>
                    }
                </div>

                <!-- Step 5: Configure Targeting -->
                <div class="flex items-center gap-3 p-4 bg-white rounded-lg @(progress.HasConfiguredTargeting ? "border-2 border-green-300" : "border border-gray-200")">
                    <div class="flex-shrink-0">
                        @if (progress.HasConfiguredTargeting)
                        {
                            <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center">
                                <i class="fas fa-check text-white text-lg"></i>
                            </div>
                        }
                        else
                        {
                            <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center">
                                <i class="fas fa-bullseye text-gray-400"></i>
                            </div>
                        }
                    </div>
                    <div class="flex-1">
                        <h3 class="font-semibold text-gray-900">Set Up Targeting</h3>
                        <p class="text-sm text-gray-600">Target the right audience</p>
                    </div>
                    @if (!progress.HasConfiguredTargeting)
                    {
                        <a asp-controller="Popup" asp-action="Index" class="px-3 py-1 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700 transition-colors">
                            Start
                        </a>
                    }
                </div>

                <!-- Step 6: View Analytics -->
                <div class="flex items-center gap-3 p-4 bg-white rounded-lg @(progress.HasViewedAnalytics ? "border-2 border-green-300" : "border border-gray-200")">
                    <div class="flex-shrink-0">
                        @if (progress.HasViewedAnalytics)
                        {
                            <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center">
                                <i class="fas fa-check text-white text-lg"></i>
                            </div>
                        }
                        else
                        {
                            <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center">
                                <i class="fas fa-chart-line text-gray-400"></i>
                            </div>
                        }
                    </div>
                    <div class="flex-1">
                        <h3 class="font-semibold text-gray-900">Check Your Analytics</h3>
                        <p class="text-sm text-gray-600">Monitor performance metrics</p>
                    </div>
                    @if (!progress.HasViewedAnalytics)
                    {
                        <a asp-controller="Popup" asp-action="Analytics" class="px-3 py-1 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700 transition-colors">
                            Start
                        </a>
                    }
                </div>
            </div>
        </div>

        @section Scripts {
            <script>
                async function dismissOnboarding() {
                    if (!confirm('Are you sure you want to dismiss this checklist? You can always access help from the navigation menu.')) {
                        return;
                    }

                    try {
                        const response = await fetch('/UserDashboard/DismissOnboarding', {
                            method: 'POST'
                        });

                        if (response.ok) {
                            document.getElementById('onboardingWidget').style.display = 'none';
                        }
                    } catch (error) {
                        console.error('Error dismissing onboarding:', error);
                    }
                }
            </script>
        }
    }

    <!-- Quick Action Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        <!-- Create Popup -->
        <a asp-controller="Popup" asp-action="CreateCampaign" class="block bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl shadow-lg p-6 text-white hover:from-blue-600 hover:to-blue-700 transform hover:scale-105 transition-all duration-200">
            <div class="flex items-center justify-between mb-4">
                <i class="fas fa-window-maximize text-3xl"></i>
                <i class="fas fa-arrow-right text-2xl"></i>
            </div>
            <h3 class="text-xl font-bold mb-2">Create Popup</h3>
            <p class="text-blue-100 text-sm">Launch a new popup campaign to capture leads and engage visitors</p>
        </a>

        <!-- Create Landing Page -->
        <a asp-controller="LandingPage" asp-action="Create" class="block bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl shadow-lg p-6 text-white hover:from-green-600 hover:to-emerald-700 transform hover:scale-105 transition-all duration-200">
            <div class="flex items-center justify-between mb-4">
                <i class="fas fa-file-alt text-3xl"></i>
                <i class="fas fa-arrow-right text-2xl"></i>
            </div>
            <h3 class="text-xl font-bold mb-2">Create Landing Page</h3>
            <p class="text-green-100 text-sm">Build high-converting landing pages with our drag-and-drop builder</p>
        </a>

        <!-- Create Number (Call Tracking) -->
        <a asp-controller="Numbers" asp-action="Search" class="block bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl shadow-lg p-6 text-white hover:from-purple-600 hover:to-purple-700 transform hover:scale-105 transition-all duration-200">
            <div class="flex items-center justify-between mb-4">
                <i class="fas fa-phone text-3xl"></i>
                <i class="fas fa-arrow-right text-2xl"></i>
            </div>
            <h3 class="text-xl font-bold mb-2">Get Number</h3>
            <p class="text-purple-100 text-sm">Purchase a tracking number to monitor calls and conversions</p>
        </a>
    </div>

    <!-- Performance Metrics Overview -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white p-6 rounded-lg shadow border">
            <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-medium text-gray-600">Total Leads</h3>
                <i class="fas fa-users text-blue-500"></i>
            </div>
            <p class="text-3xl font-bold text-gray-900">@(Model?.TotalLeads ?? 0)</p>
            <p class="text-xs text-gray-500 mt-2">All time captures</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow border">
            <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-medium text-gray-600">New This Week</h3>
                <i class="fas fa-calendar-week text-green-500"></i>
            </div>
            <p class="text-3xl font-bold text-gray-900">@(Model?.NewLeadsThisWeek ?? 0)</p>
            <p class="text-xs text-gray-500 mt-2">Recent activity</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow border">
            <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-medium text-gray-600">Form Submissions</h3>
                <i class="fas fa-file-alt text-purple-500"></i>
            </div>
            <p class="text-3xl font-bold text-gray-900">@(Model?.TotalFormSubmissions ?? 0)</p>
            <p class="text-xs text-gray-500 mt-2">Total captures</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow border">
            <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-medium text-gray-600">Pipeline Value</h3>
                <i class="fas fa-dollar-sign text-orange-500"></i>
            </div>
            <p class="text-3xl font-bold text-gray-900">@((Model?.TotalPipelineValue ?? 0).ToString("C0"))</p>
            <p class="text-xs text-gray-500 mt-2">Total potential</p>
        </div>
    </div>

    <!-- Leads & CRM Activity Section -->
    <div class="bg-white rounded-lg shadow border p-6 mb-8">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-xl font-semibold text-gray-900">
                    <i class="fas fa-users me-2 text-blue-600"></i>Leads Activity
                </h2>
                <p class="text-sm text-gray-500 mt-1">Overview of your lead capture and CRM pipeline</p>
            </div>
            <a asp-controller="Leads" asp-action="Index" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                View All Leads <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>

        <!-- Lead Stats Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-blue-50 p-4 rounded-lg">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-medium text-blue-600">Total Leads</span>
                    <i class="fas fa-users text-blue-400"></i>
                </div>
                <p class="text-2xl font-bold text-blue-900">@(Model?.TotalLeads ?? 0)</p>
            </div>
            <div class="bg-green-50 p-4 rounded-lg">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-medium text-green-600">New This Week</span>
                    <i class="fas fa-calendar-week text-green-400"></i>
                </div>
                <p class="text-2xl font-bold text-green-900">@(Model?.NewLeadsThisWeek ?? 0)</p>
            </div>
            <div class="bg-purple-50 p-4 rounded-lg">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-medium text-purple-600">Qualified</span>
                    <i class="fas fa-star text-purple-400"></i>
                </div>
                <p class="text-2xl font-bold text-purple-900">@(Model?.QualifiedLeads ?? 0)</p>
            </div>
            <div class="bg-orange-50 p-4 rounded-lg">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-medium text-orange-600">Today</span>
                    <i class="fas fa-bolt text-orange-400"></i>
                </div>
                <p class="text-2xl font-bold text-orange-900">@(Model?.NewLeadsToday ?? 0)</p>
            </div>
        </div>

        @if (Model?.HasCrmAccess == true)
        {
            <!-- CRM Stats (Pro+ Only) -->
            <div class="border-t pt-4 mb-6">
                <h3 class="text-sm font-semibold text-gray-700 mb-3">
                    <i class="fas fa-chart-line me-1"></i>CRM Pipeline
                </h3>
                <div class="grid grid-cols-2 md:grid-cols-2 gap-4">
                    <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
                        <div class="bg-indigo-100 p-2 rounded-full">
                            <i class="fas fa-stream text-indigo-600"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500">In Pipeline</p>
                            <p class="text-lg font-semibold text-gray-900">@(Model?.LeadsInPipeline ?? 0)</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
                        <div class="bg-emerald-100 p-2 rounded-full">
                            <i class="fas fa-dollar-sign text-emerald-600"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500">Pipeline Value</p>
                            <p class="text-lg font-semibold text-gray-900">@(Model?.TotalPipelineValue.ToString("C0") ?? "$0")</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- CRM Upgrade Prompt -->
            <div class="border-t pt-4 mb-6">
                <div class="bg-gradient-to-r from-purple-50 to-indigo-50 p-4 rounded-lg flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="bg-purple-100 p-2 rounded-full">
                            <i class="fas fa-rocket text-purple-600"></i>
                        </div>
                        <div>
                            <p class="font-medium text-gray-900">Unlock CRM Features</p>
                            <p class="text-sm text-gray-600">Pipeline management, deals, and reports with Pro plan</p>
                        </div>
                    </div>
                    <a asp-controller="UserDashboard" asp-action="Subscription" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm font-medium">
                        Upgrade
                    </a>
                </div>
            </div>
        }

        <!-- Recent Leads Table -->
        @if (Model?.RecentLeads != null && Model.RecentLeads.Any())
        {
            <div class="border-t pt-4">
                <h3 class="text-sm font-semibold text-gray-700 mb-3">Recent Leads</h3>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead>
                            <tr>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Contact</th>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Source</th>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Captured</th>
                                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @foreach (var lead in Model.RecentLeads)
                            {
                                <tr class="hover:bg-gray-50">
                                    <td class="px-4 py-3">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                                                <span class="text-blue-600 font-medium text-sm">
                                                    @((!string.IsNullOrEmpty(lead.FirstName) ? lead.FirstName.Substring(0, 1) : 
                                                       !string.IsNullOrEmpty(lead.Email) ? lead.Email.Substring(0, 1) : "?").ToUpper())
                                                </span>
                                            </div>
                                            <div>
                                                <p class="text-sm font-medium text-gray-900">
                                                    @(!string.IsNullOrEmpty(lead.FirstName) || !string.IsNullOrEmpty(lead.LastName) 
                                                        ? $"{lead.FirstName} {lead.LastName}".Trim() 
                                                        : lead.Email ?? "Unknown")
                                                </p>
                                                @if (!string.IsNullOrEmpty(lead.Email))
                                                {
                                                    <p class="text-xs text-gray-500">@lead.Email</p>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="text-sm text-gray-600">@(lead.Popup?.Name ?? "Direct")</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="px-2 py-1 text-xs rounded-full @GetStatusClass(lead.Status)">
                                            @lead.Status
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-500">
                                        @lead.CapturedAt.ToString("MMM dd, h:mm tt")
                                    </td>
                                    <td class="px-4 py-3 text-right">
                                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@lead.Id" 
                                           class="text-blue-600 hover:text-blue-800 text-sm">
                                            View <i class="fas fa-chevron-right ms-1"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-8 text-gray-500">
                <i class="fas fa-inbox text-4xl text-gray-300 mb-3"></i>
                <p>No leads captured yet</p>
                <p class="text-sm mt-1">Create a popup campaign to start capturing leads</p>
            </div>
