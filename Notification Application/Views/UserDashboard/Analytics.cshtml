@{
    ViewData["Title"] = "Analytics";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-3"><i class="bi bi-graph-up me-2"></i>Analytics</h1>
            <p class="text-muted">Track your campaign performance and engagement metrics</p>
        </div>
    </div>

    <!-- Key Metrics -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Total Views</p>
                            <h3 class="mb-0">12,543</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded">
                            <i class="bi bi-eye text-primary" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                    <small class="text-success">
                        <i class="bi bi-arrow-up"></i> 12.5% from last month
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Total Leads</p>
                            <h3 class="mb-0">2,847</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded">
                            <i class="bi bi-person-check text-success" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                    <small class="text-success">
                        <i class="bi bi-arrow-up"></i> 8.3% from last month
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Conversion Rate</p>
                            <h3 class="mb-0">22.7%</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded">
                            <i class="bi bi-graph-up-arrow text-warning" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                    <small class="text-success">
                        <i class="bi bi-arrow-up"></i> 3.1% from last month
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Revenue</p>
                            <h3 class="mb-0">$45,290</h3>
                        </div>
                        <div class="bg-info bg-opacity-10 p-3 rounded">
                            <i class="bi bi-currency-dollar text-info" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                    <small class="text-success">
                        <i class="bi bi-arrow-up"></i> 15.8% from last month
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Performance Overview</h5>
                </div>
                <div class="card-body">
                    <canvas id="performanceChart" height="80"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Top Campaigns</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item border-0 px-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>Black Friday Sale</strong>
                                    <br><small class="text-muted">1,234 conversions</small>
                                </div>
                                <span class="badge bg-success">Active</span>
                            </div>
                        </div>
                        <div class="list-group-item border-0 px-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>Newsletter Signup</strong>
                                    <br><small class="text-muted">892 conversions</small>
                                </div>
                                <span class="badge bg-success">Active</span>
                            </div>
                        </div>
                        <div class="list-group-item border-0 px-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>Free Trial Offer</strong>
                                    <br><small class="text-muted">567 conversions</small>
                                </div>
                                <span class="badge bg-secondary">Paused</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Recent Conversions</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Campaign</th>
                                    <th>Lead</th>
                                    <th>Source</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>2 hours ago</td>
                                    <td>Black Friday Sale</td>
                                    <td>john.doe@example.com</td>
                                    <td><span class="badge bg-primary">Popup</span></td>
                                    <td>$129.00</td>
                                </tr>
                                <tr>
                                    <td>5 hours ago</td>
                                    <td>Newsletter Signup</td>
                                    <td>jane.smith@example.com</td>
                                    <td><span class="badge bg-info">Form</span></td>
                                    <td>$0.00</td>
                                </tr>
                                <tr>
                                    <td>1 day ago</td>
                                    <td>Free Trial Offer</td>
                                    <td>mike.jones@example.com</td>
                                    <td><span class="badge bg-primary">Popup</span></td>
                                    <td>$49.00</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Performance Chart
    const ctx = document.getElementById('performanceChart');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
            datasets: [{
                label: 'Views',
                data: [850, 920, 1100, 980, 1250, 1180, 1350, 1420, 1280, 1450, 1380, 1543],
                borderColor: 'rgb(75, 192, 192)',
                tension: 0.1
            }, {
                label: 'Conversions',
                data: [180, 210, 245, 220, 280, 265, 310, 325, 290, 340, 315, 347],
                borderColor: 'rgb(255, 99, 132)',
                tension: 0.1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: {
                    position: 'top',
                }
            }
        }
    });
</script>
}
