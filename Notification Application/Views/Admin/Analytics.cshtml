@model AnalyticsViewModel
@{
    ViewData["Title"] = "Analytics";
}

<div class="max-w-7xl mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Analytics</h1>
            <p class="text-gray-600 mt-2">Detailed performance analytics for your popups</p>
        </div>
        <button type="button" class="btn btn-gradient-ai" data-bs-toggle="modal" data-bs-target="#aiReportModal">
            <i class="bi bi-robot me-2"></i>Generate Report with AI
        </button>
    </div>

    <!-- Date Range Filter -->
    <div class="bg-white rounded-lg shadow border p-6 mb-8">
        <div class="flex items-center space-x-4">
            <label for="start-date" class="font-medium">Date Range:</label>
            <input type="date" id="start-date" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="border border-gray-300 rounded-lg px-3 py-2">
            <span>to</span>
            <input type="date" id="end-date" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="border border-gray-300 rounded-lg px-3 py-2">
            <button class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">Apply</button>
        </div>
    </div>

    <!-- Summary Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white p-6 rounded-lg shadow border">
            <h3 class="text-lg font-semibold text-gray-800">Total Views</h3>
            <p class="text-3xl font-bold text-blue-600">@((Model.Summary as dynamic)?.TotalViews ?? 0)</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow border">
            <h3 class="text-lg font-semibold text-gray-800">Total Clicks</h3>
            <p class="text-3xl font-bold text-green-600">@((Model.Summary as dynamic)?.TotalClicks ?? 0)</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow border">
            <h3 class="text-lg font-semibold text-gray-800">Total Conversions</h3>
            <p class="text-3xl font-bold text-purple-600">@((Model.Summary as dynamic)?.TotalConversions ?? 0)</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow border">
            <h3 class="text-lg font-semibold text-gray-800">Avg. Conversion Rate</h3>
            <p class="text-3xl font-bold text-orange-600">@(((Model.Summary as dynamic)?.AverageConversionRate ?? 0.0).ToString("F1"))%</p>
        </div>
    </div>

    <!-- Charts -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
        <div class="bg-white p-6 rounded-lg shadow border">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Views & Conversions Over Time</h3>
            <canvas id="viewsConversionsChart"></canvas>
        </div>
        <div class="bg-white p-6 rounded-lg shadow border">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Device Breakdown</h3>
            <canvas id="deviceChart"></canvas>
        </div>
    </div>

    <!-- Popup Performance Table -->
    <div class="bg-white rounded-lg shadow border">
        <div class="p-6 border-b">
            <h2 class="text-xl font-semibold text-gray-900">Popup Performance</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Popup</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Views</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Clicks</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Conversions</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Conversion Rate</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var item in Model.PopupAnalytics)
                    {
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@item.Popup?.Name</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.Views</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.Clicks</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.Conversions</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.ConversionRate.ToString("F1")%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Views & Conversions Chart
        var ctx1 = document.getElementById('viewsConversionsChart').getContext('2d');
        new Chart(ctx1, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'], // Replace with dynamic data
                datasets: [{
                    label: 'Views',
                    data: [1200, 1900, 3000, 5000, 2300, 3200], // Replace with dynamic data
                    borderColor: '#3b82f6',
                    tension: 0.1
                }, {
                    label: 'Conversions',
                    data: [120, 190, 300, 500, 230, 320], // Replace with dynamic data
                    borderColor: '#8b5cf6',
                    tension: 0.1
                }]
            }
        });

        // Device Chart
        var ctx2 = document.getElementById('deviceChart').getContext('2d');
        new Chart(ctx2, {
            type: 'doughnut',
            data: {
                labels: ['Desktop', 'Mobile'],
                datasets: [{
                    data: [@((Model.Summary as dynamic)?.DesktopViews ?? 0), @((Model.Summary as dynamic)?.MobileViews ?? 0)],
                    backgroundColor: ['#3b82f6', '#10b981']
                }]
            }
        });
    });
</script>

<!-- AI Report Builder Modal -->
<div class="modal fade" id="aiReportModal" tabindex="-1" aria-labelledby="aiReportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-gradient-ai text-white">
                <h5 class="modal-title" id="aiReportModalLabel">
                    <i class="bi bi-robot me-2"></i>Generate Report with AI
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Describe the report you want to generate. AI will analyze your data and create a comprehensive report with insights and recommendations.
                </div>
                
                <div class="mb-3">
                    <label for="reportDescription" class="form-label fw-bold">Report Description</label>
                    <textarea id="reportDescription" class="form-control" rows="4" placeholder="Example: Generate a report analyzing lead conversion trends over the last 30 days, focusing on which popup campaigns performed best and recommendations for improvement"></textarea>
                </div>
                
                <div id="aiReportLoading" class="d-none text-center py-4">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted">AI is analyzing your data and generating report...</p>
                </div>
                
                <div id="aiReportResults" class="mt-4"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-gradient-ai" onclick="generateAIReport()">
                    <i class="bi bi-robot me-2"></i>Generate Report
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.btn-gradient-ai {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    transition: all 0.3s ease;
}
.btn-gradient-ai:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
    color: white;
}
.bg-gradient-ai {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}
</style>

<script>
async function generateAIReport() {
    const description = document.getElementById('reportDescription').value.trim();
    
    if (!description) {
        alert('Please describe the report you want to generate.');
        return;
    }
    
    const loadingDiv = document.getElementById('aiReportLoading');
    const resultsDiv = document.getElementById('aiReportResults');
    
    loadingDiv.classList.remove('d-none');
    resultsDiv.innerHTML = '';
    
    try {
        const response = await fetch('/api/AIReportBuilder/generate', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ reportDescription: description })
        });
        
        const result = await response.json();
        
        loadingDiv.classList.add('d-none');
        
        if (result.success) {
            resultsDiv.innerHTML = `
                <div class="alert alert-success">
                    <i class="bi bi-check-circle me-2"></i>
                    Report generated successfully! (Tokens used: ${result.tokensUsed})
                </div>
                <div class="border rounded p-4 bg-light">
                    ${result.reportHtml}
                </div>
                <div class="mt-3 text-end">
                    <button class="btn btn-primary" onclick="downloadReport()">
                        <i class="bi bi-download me-2"></i>Download Report
                    </button>
                </div>
            `;
        } else {
            resultsDiv.innerHTML = `
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Failed to generate report. Please try again.
                </div>
            `;
        }
    } catch (error) {
        loadingDiv.classList.add('d-none');
        resultsDiv.innerHTML = `
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Error: ${error.message}
            </div>
        `;
    }
}

function downloadReport() {
    const reportContent = document.querySelector('#aiReportResults .bg-light').innerHTML;
    const blob = new Blob([`
        <!DOCTYPE html>
        <html>
        <head>
            <title>AI Generated Report</title>
            <style>
                body { font-family: Arial, sans-serif; padding: 20px; }
                h1, h2, h3 { color: #333; }
                table { border-collapse: collapse; width: 100%; margin: 20px 0; }
                th, td { border: 1px solid #ddd; padding: 12px; text-align: left; }
                th { background-color: #667eea; color: white; }
            </style>
        </head>
        <body>
            ${reportContent}
        </body>
        </html>
    `], { type: 'text/html' });
    
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `AI_Report_${new Date().toISOString().split('T')[0]}.html`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
}
</script>
}