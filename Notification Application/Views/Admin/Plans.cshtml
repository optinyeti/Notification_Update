@model List<SubscriptionPlan>
@{
    ViewData["Title"] = "Manage Subscription Plans";
}

<style>
    .plans-header {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        border: 1px solid #dee2e6;
    }
    
    .plan-card {
        border: 2px solid #e9ecef;
        border-radius: 16px;
        transition: all 0.3s ease;
        background: white;
        overflow: hidden;
    }
    
    .plan-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.12) !important;
        border-color: #0d6efd;
    }
    
    .plan-card.inactive {
        opacity: 0.7;
        background: #f8f9fa;
    }
    
    .plan-header {
        background: linear-gradient(135deg, #fff 0%, #f8f9fa 100%);
        border-bottom: 2px solid #e9ecef;
        padding: 1.5rem;
    }
    
    .plan-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: #212529;
        margin-bottom: 0.5rem;
    }
    
    .pricing-display {
        background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);
        padding: 2rem;
        text-align: center;
        color: white;
        margin: -1px;
    }
    
    .price-amount {
        font-size: 3rem;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 0.5rem;
    }
    
    .price-period {
        font-size: 0.9rem;
        opacity: 0.9;
    }
    
    .yearly-price {
        background: rgba(255,255,255,0.2);
        padding: 0.75rem 1rem;
        border-radius: 8px;
        margin-top: 1rem;
        font-size: 0.95rem;
    }
    
    .feature-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    
    .feature-list li {
        padding: 0.75rem 0;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    
    .feature-list li:last-child {
        border-bottom: none;
    }
    
    .feature-icon {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 0.5rem;
        font-size: 0.75rem;
    }
    
    .feature-icon.check {
        background: #d1e7dd;
        color: #0f5132;
    }
    
    .limit-badge {
        background: #e7f1ff;
        color: #004085;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
    }
    
    .action-buttons {
        display: flex;
        gap: 0.5rem;
        padding: 1rem 1.5rem;
        background: #f8f9fa;
        border-top: 1px solid #e9ecef;
    }
    
    .action-buttons .btn {
        flex: 1;
        font-weight: 600;
        border-radius: 8px;
        padding: 0.6rem;
    }
    
    .section-divider {
        margin: 1.5rem 0;
        border: none;
        border-top: 2px dashed #e9ecef;
    }
    
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: white;
        border-radius: 16px;
        border: 2px dashed #dee2e6;
    }
    
    .empty-state-icon {
        font-size: 4rem;
        color: #adb5bd;
        margin-bottom: 1rem;
    }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Enhanced Header -->
    <div class="plans-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="mb-2" style="font-weight: 700; font-size: 2rem;">
                    <i class="bi bi-box-seam me-2 text-primary"></i>
                    Subscription Plans
                </h1>
                <p class="text-muted mb-0" style="font-size: 1.05rem;">
                    Create and manage pricing packages for your customers
                </p>
            </div>
            <a asp-action="CreatePlan" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-plus-circle me-2"></i>Create New Plan
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <!-- Enhanced Plans Grid -->
        <div class="row g-4">
            @foreach (var plan in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="plan-card h-100 @(!plan.IsActive ? "inactive" : "")">
                        <!-- Plan Header -->
                        <div class="plan-header">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h3 class="plan-name">@plan.Name</h3>
                                    <span class="badge @(plan.IsActive ? "bg-success" : "bg-secondary") px-3 py-2">
                                        <i class="bi bi-@(plan.IsActive ? "check-circle" : "pause-circle") me-1"></i>
                                        @(plan.IsActive ? "Active" : "Inactive")
                                    </span>
                                </div>
                            </div>
                            <p class="text-muted mb-0">@plan.Description</p>
                        </div>

                        <!-- Pricing Display -->
                        <div class="pricing-display">
                            <div class="price-amount">
                                $@plan.MonthlyPrice.ToString("0")
                            </div>
                            <div class="price-period">per month</div>
                            <div class="yearly-price">
                                <strong>$@plan.YearlyPrice.ToString("0")</strong> / year
                                @if (plan.MonthlyPrice > 0)
                                {
                                    var savings = (((plan.MonthlyPrice * 12) - plan.YearlyPrice) / (plan.MonthlyPrice * 12) * 100);
                                    <span class="ms-2">
                                        <i class="bi bi-star-fill"></i>
                                        Save @savings.ToString("0")%
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Plan Details -->
                        <div class="card-body p-4">
                            <!-- Limits Section -->
                            <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                Usage Limits
                            </h6>
                            <ul class="feature-list mb-4">
                                <li>
                                    <div>
                                        <span class="feature-icon check">
                                            <i class="bi bi-card-list"></i>
                                        </span>
                                        <span class="text-muted">Popups</span>
                                    </div>
                                    <span class="limit-badge">
                                        @(plan.MaxPopups == -1 ? "∞ Unlimited" : plan.MaxPopups.ToString())
                                    </span>
                                </li>
                                <li>
                                    <div>
                                        <span class="feature-icon check">
                                            <i class="bi bi-eye"></i>
                                        </span>
                                        <span class="text-muted">Views/Month</span>
                                    </div>
                                    <span class="limit-badge">
                                        @(plan.MaxPopupViews == -1 ? "∞ Unlimited" : plan.MaxPopupViews.ToString("N0"))
                                    </span>
                                </li>
                                <li>
                                    <div>
                                        <span class="feature-icon check">
                                            <i class="bi bi-people"></i>
                                        </span>
                                        <span class="text-muted">Team Members</span>
                                    </div>
                                    <span class="limit-badge">
                                        @(plan.MaxUsers == -1 ? "∞ Unlimited" : plan.MaxUsers.ToString())
                                    </span>
                                </li>
                            </ul>

                            <!-- Features Section -->
                            <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                Features Included
                            </h6>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @if (plan.HasAdvancedTargeting)
                                {
                                    <span class="badge bg-primary-subtle text-primary px-3 py-2">
                                        <i class="bi bi-bullseye me-1"></i>Advanced Targeting
                                    </span>
                                }
                                @if (plan.HasAnalytics)
                                {
                                    <span class="badge bg-info-subtle text-info px-3 py-2">
                                        <i class="bi bi-graph-up me-1"></i>Analytics
                                    </span>
                                }
                                @if (plan.HasAPIAccess)
                                {
                                    <span class="badge bg-success-subtle text-success px-3 py-2">
                                        <i class="bi bi-code-slash me-1"></i>API Access
                                    </span>
                                }
                                @if (plan.HasPrioritySupport)
                                {
                                    <span class="badge bg-warning-subtle text-warning px-3 py-2">
                                        <i class="bi bi-headset me-1"></i>Priority Support
                                    </span>
                                }
                                @if (plan.HasWhiteLabel)
                                {
                                    <span class="badge bg-dark-subtle text-dark px-3 py-2">
                                        <i class="bi bi-award me-1"></i>White Label
                                    </span>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(plan.StripeProductId))
                            {
                                <div class="section-divider"></div>
                                <div class="d-flex align-items-center text-muted">
                                    <i class="bi bi-stripe me-2" style="font-size: 1.2rem;"></i>
                                    <small>Connected: <code>@plan.StripeProductId</code></small>
                                </div>
                            }
                        </div>

                        <!-- Action Buttons -->
                        <div class="action-buttons">
                            <a asp-action="EditPlan" asp-route-id="@plan.Id" class="btn btn-primary">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                            <form asp-action="TogglePlanStatus" asp-route-id="@plan.Id" method="post" class="d-inline flex-fill">
                                <button type="submit" class="btn btn-@(plan.IsActive ? "warning" : "success") w-100">
                                    <i class="bi bi-@(plan.IsActive ? "pause" : "play")-circle me-1"></i>
                                    @(plan.IsActive ? "Pause" : "Activate")
                                </button>
                            </form>
                            <form asp-action="DeletePlan" asp-route-id="@plan.Id" method="post" 
                                  onsubmit="return confirm('⚠️ Delete this plan permanently?');" 
                                  class="d-inline">
                                <button type="submit" class="btn btn-outline-danger" title="Delete Plan">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>

                        <!-- Footer -->
                        <div class="px-4 py-2 bg-light border-top text-center">
                            <small class="text-muted">
                                <i class="bi bi-calendar-event me-1"></i>
                                Created @plan.CreatedAt.ToString("MMM dd, yyyy")
                            </small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="bi bi-box-seam"></i>
            </div>
            <h3 class="mb-3">No Subscription Plans Yet</h3>
            <p class="text-muted mb-4">Create your first pricing plan to start offering subscriptions</p>
            <a asp-action="CreatePlan" class="btn btn-primary btn-lg px-5">
                <i class="bi bi-plus-circle me-2"></i>Create Your First Plan
            </a>
        </div>
    }
</div>
