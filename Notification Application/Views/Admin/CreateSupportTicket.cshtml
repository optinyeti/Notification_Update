@model CreateSupportTicketViewModel
@{
    ViewData["Title"] = "Create Support Ticket";
}

<div class="max-w-3xl mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center gap-3 mb-2">
            <a asp-action="Support" class="text-gray-600 hover:text-gray-900">
                <i class="bi bi-arrow-left text-xl"></i>
            </a>
            <h1 class="text-3xl font-bold text-gray-900">Create Support Ticket</h1>
        </div>
        <p class="text-gray-600">Submit a new support request</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg mb-6">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        </div>
    }

    <!-- Create Form -->
    <form asp-action="CreateSupportTicket" method="post" class="bg-white rounded-lg shadow border">
        <div class="p-6 space-y-6">
            <!-- Info Box -->
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <i class="bi bi-info-circle text-blue-600 text-xl"></i>
                    </div>
                    <div class="ml-3">
                        <h3 class="text-sm font-medium text-blue-800">Need Help?</h3>
                        <div class="mt-2 text-sm text-blue-700">
                            <p>Our support team is here to help! Please provide as much detail as possible about your issue.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Subject -->
            <div>
                <label asp-for="Subject" class="block text-sm font-medium text-gray-700 mb-2">
                    Subject <span class="text-red-500">*</span>
                </label>
                <input asp-for="Subject" type="text" required 
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                       placeholder="Brief description of your issue" />
                <span asp-validation-for="Subject" class="text-red-500 text-sm"></span>
            </div>

            <!-- Category & Priority -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Category" class="block text-sm font-medium text-gray-700 mb-2">
                        Category <span class="text-red-500">*</span>
                    </label>
                    <select asp-for="Category" required 
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="">-- Select Category --</option>
                        <option value="0">Technical Issue</option>
                        <option value="1">Billing Question</option>
                        <option value="2">Feature Request</option>
                        <option value="3">General Inquiry</option>
                        <option value="4">Other</option>
                    </select>
                    <span asp-validation-for="Category" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Priority" class="block text-sm font-medium text-gray-700 mb-2">
                        Priority <span class="text-red-500">*</span>
                    </label>
                    <select asp-for="Priority" required 
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="">-- Select Priority --</option>
                        <option value="0">Low - General inquiry</option>
                        <option value="1">Medium - Non-urgent issue</option>
                        <option value="2">High - Urgent problem</option>
                        <option value="3">Critical - Service down</option>
                    </select>
                    <span asp-validation-for="Priority" class="text-red-500 text-sm"></span>
                </div>
            </div>

            <!-- Description -->
            <div>
                <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-2">
                    Description <span class="text-red-500">*</span>
                </label>
                <textarea asp-for="Description" rows="8" required 
                          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                          placeholder="Please provide detailed information about your issue including:&#10;- What were you trying to do?&#10;- What happened?&#10;- What did you expect to happen?&#10;- Any error messages you received"></textarea>
                <span asp-validation-for="Description" class="text-red-500 text-sm"></span>
                <p class="text-xs text-gray-500 mt-1">Be as detailed as possible to help us resolve your issue quickly</p>
            </div>

            <!-- Priority Descriptions -->
            <div class="bg-gray-50 p-4 rounded-lg">
                <h4 class="text-sm font-semibold text-gray-900 mb-2">Priority Guidelines:</h4>
                <ul class="space-y-2 text-sm text-gray-600">
                    <li class="flex items-start gap-2">
                        <span class="px-2 py-0.5 rounded text-xs font-medium bg-gray-200 text-gray-800">Low</span>
                        <span>General questions, feature requests, or minor issues</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="px-2 py-0.5 rounded text-xs font-medium bg-blue-200 text-blue-800">Medium</span>
                        <span>Non-critical issues affecting functionality</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="px-2 py-0.5 rounded text-xs font-medium bg-orange-200 text-orange-800">High</span>
                        <span>Urgent issues preventing important work</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="px-2 py-0.5 rounded text-xs font-medium bg-red-200 text-red-800">Critical</span>
                        <span>Service completely unavailable or data loss</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Actions -->
        <div class="px-6 py-4 bg-gray-50 rounded-b-lg flex justify-between items-center border-t">
            <a asp-action="Support" class="text-gray-600 hover:text-gray-900 font-medium">
                <i class="bi bi-x-lg me-2"></i>Cancel
            </a>
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-lg font-semibold flex items-center gap-2">
                <i class="bi bi-send"></i>
                Submit Ticket
            </button>
        </div>
    </form>

    <!-- Help Section -->
    <div class="mt-6 bg-white rounded-lg shadow border p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-3">Before You Submit</h3>
        <div class="space-y-3 text-sm text-gray-600">
            <div class="flex items-start gap-2">
                <i class="bi bi-check-circle text-green-600 mt-0.5"></i>
                <div>
                    <strong>Check our documentation</strong> - Many common questions are answered in our help center
                </div>
            </div>
            <div class="flex items-start gap-2">
                <i class="bi bi-check-circle text-green-600 mt-0.5"></i>
                <div>
                    <strong>Search existing tickets</strong> - Your question may have already been answered
                </div>
            </div>
            <div class="flex items-start gap-2">
                <i class="bi bi-check-circle text-green-600 mt-0.5"></i>
                <div>
                    <strong>Include screenshots</strong> - Describe any error messages or unexpected behavior
                </div>
            </div>
            <div class="flex items-start gap-2">
                <i class="bi bi-check-circle text-green-600 mt-0.5"></i>
                <div>
                    <strong>Response time</strong> - Critical issues: 1 hour | High: 4 hours | Medium: 24 hours | Low: 48 hours
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
