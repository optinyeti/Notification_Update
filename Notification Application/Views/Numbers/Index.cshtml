@model IEnumerable<Notification_Application.Models.PhoneNumber>

@{
    ViewData["Title"] = "My Phone Numbers";
}

<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">My Phone Numbers</h1>
            <p class="text-gray-600 mt-2">Manage your call tracking numbers</p>
        </div>
        <a asp-action="Search" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium">
            <i class="fas fa-plus me-2"></i>Get New Number
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="bg-white rounded-lg shadow border p-12 text-center">
            <i class="fas fa-phone-alt text-6xl text-gray-300 mb-4"></i>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">No Phone Numbers Yet</h3>
            <p class="text-gray-600 mb-6">Get started with call tracking by purchasing your first number</p>
            <a asp-action="Search" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium inline-block">
                <i class="fas fa-search me-2"></i>Search for Numbers
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var number in Model)
            {
                <div class="bg-white rounded-lg shadow border hover:shadow-lg transition">
                    <div class="p-6">
                        <div class="flex items-start justify-between mb-4">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900">@number.FriendlyName</h3>
                                <p class="text-2xl font-bold text-blue-600 mt-1">@number.Number</p>
                            </div>
                            @if (number.IsActive)
                            {
                                <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded">Active</span>
                            }
                            else
                            {
                                <span class="bg-gray-100 text-gray-800 text-xs px-2 py-1 rounded">Inactive</span>
                            }
                        </div>

                        <div class="space-y-2 mb-4">
                            <div class="flex items-center text-sm text-gray-600">
                                <i class="fas fa-map-marker-alt w-5 text-gray-400"></i>
                                <span>@(number.City ?? "N/A"), @(number.State ?? "N/A")</span>
                            </div>
                            <div class="flex items-center text-sm text-gray-600">
                                <i class="fas fa-phone-alt w-5 text-gray-400"></i>
                                <span>@(number.Type == Notification_Application.Models.PhoneNumberType.TollFree ? "Toll-Free" : "Local")</span>
                            </div>
                            <div class="flex items-center text-sm text-gray-600">
                                <i class="fas fa-forward w-5 text-gray-400"></i>
                                <span>→ @number.ForwardToNumber</span>
                            </div>
                        </div>

                        <div class="border-t pt-4 grid grid-cols-3 gap-2 mb-4">
                            <div class="text-center">
                                <p class="text-xs text-gray-500">Calls</p>
                                <p class="text-lg font-semibold text-gray-900">@number.TotalCalls</p>
                            </div>
                            <div class="text-center">
                                <p class="text-xs text-gray-500">Minutes</p>
                                <p class="text-lg font-semibold text-gray-900">@number.TotalMinutes</p>
                            </div>
                            <div class="text-center">
                                <p class="text-xs text-gray-500">Cost</p>
                                <p class="text-lg font-semibold text-gray-900">@number.TotalCost.ToString("C2")</p>
                            </div>
                        </div>

                        <div class="flex gap-2">
                            <a asp-action="Details" asp-route-id="@number.Id" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white text-center px-4 py-2 rounded text-sm font-medium">
                                Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@number.Id" class="flex-1 bg-gray-600 hover:bg-gray-700 text-white text-center px-4 py-2 rounded text-sm font-medium">
                                Edit
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Summary Stats -->
        <div class="mt-8 bg-white rounded-lg shadow border p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Summary</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="text-center p-4 bg-blue-50 rounded-lg">
                    <p class="text-sm text-blue-600 font-medium">Total Numbers</p>
                    <p class="text-3xl font-bold text-blue-900">@Model.Count()</p>
                </div>
                <div class="text-center p-4 bg-green-50 rounded-lg">
                    <p class="text-sm text-green-600 font-medium">Total Calls</p>
                    <p class="text-3xl font-bold text-green-900">@Model.Sum(n => n.TotalCalls)</p>
                </div>
                <div class="text-center p-4 bg-purple-50 rounded-lg">
                    <p class="text-sm text-purple-600 font-medium">Total Minutes</p>
                    <p class="text-3xl font-bold text-purple-900">@Model.Sum(n => n.TotalMinutes)</p>
                </div>
                <div class="text-center p-4 bg-orange-50 rounded-lg">
                    <p class="text-sm text-orange-600 font-medium">Total Cost</p>
                    <p class="text-3xl font-bold text-orange-900">@Model.Sum(n => n.TotalCost).ToString("C2")</p>
                </div>
            </div>
        </div>
    }
</div>
