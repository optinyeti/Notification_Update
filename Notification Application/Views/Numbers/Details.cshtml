@model Notification_Application.Models.PhoneNumber

@{
    ViewData["Title"] = "Phone Number Details";
}

<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="mb-8">
        <a asp-action="Index" class="text-blue-600 hover:text-blue-800 text-sm font-medium mb-4 inline-block">
            <i class="fas fa-arrow-left me-2"></i>Back to My Numbers
        </a>
        <div class="flex justify-between items-start">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">@Model.FriendlyName</h1>
                <p class="text-2xl text-blue-600 mt-2">@Model.Number</p>
            </div>
            <div class="flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded font-medium">
                    <i class="fas fa-edit me-2"></i>Edit
                </a>
                @if (Model.IsActive)
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="inline"
                          onsubmit="return confirm('Are you sure you want to cancel this number? This action cannot be undone.');">
                        <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded font-medium">
                            <i class="fas fa-times me-2"></i>Cancel Number
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
            @TempData["Error"]
        </div>
    }

    <!-- Stats Overview -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white p-6 rounded-lg shadow border">
            <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-medium text-gray-600">Total Calls</h3>
                <i class="fas fa-phone text-blue-500"></i>
            </div>
            <p class="text-3xl font-bold text-gray-900">@Model.TotalCalls</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow border">
            <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-medium text-gray-600">Total Minutes</h3>
                <i class="fas fa-clock text-purple-500"></i>
            </div>
            <p class="text-3xl font-bold text-gray-900">@Model.TotalMinutes</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow border">
            <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-medium text-gray-600">Total Cost</h3>
                <i class="fas fa-dollar-sign text-green-500"></i>
            </div>
            <p class="text-3xl font-bold text-gray-900">@Model.TotalCost.ToString("C2")</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow border">
            <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-medium text-gray-600">Last Call</h3>
                <i class="fas fa-calendar text-orange-500"></i>
            </div>
            <p class="text-sm font-bold text-gray-900">
                @(Model.LastCallDate?.ToString("MMM d, yyyy") ?? "Never")
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Number Details -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-lg shadow border p-6 mb-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Number Configuration</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm text-gray-500">Number Type</p>
                        <p class="font-medium text-gray-900">@(Model.Type == Notification_Application.Models.PhoneNumberType.TollFree ? "Toll-Free" : "Local")</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Status</p>
                        <p class="font-medium">
                            @if (Model.IsActive)
                            {
                                <span class="text-green-600"><i class="fas fa-check-circle me-1"></i>Active</span>
                            }
                            else
                            {
                                <span class="text-red-600"><i class="fas fa-times-circle me-1"></i>Canceled</span>
                            }
                        </p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Forward To</p>
                        <p class="font-medium text-gray-900">@Model.ForwardToNumber</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Location</p>
                        <p class="font-medium text-gray-900">@(Model.City ?? "N/A"), @(Model.State ?? "N/A")</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Purchased</p>
                        <p class="font-medium text-gray-900">@Model.PurchasedDate.ToString("MMM d, yyyy")</p>
                    </div>
                    @if (!Model.IsActive && Model.CanceledDate.HasValue)
                    {
                        <div>
                            <p class="text-sm text-gray-500">Canceled</p>
                            <p class="font-medium text-gray-900">@Model.CanceledDate.Value.ToString("MMM d, yyyy")</p>
                        </div>
                    }
                </div>
            </div>

            <!-- UTM Tracking -->
            @if (!string.IsNullOrEmpty(Model.UtmSource) || !string.IsNullOrEmpty(Model.UtmMedium) || !string.IsNullOrEmpty(Model.UtmCampaign))
            {
                <div class="bg-white rounded-lg shadow border p-6 mb-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4">
                        <i class="fas fa-chart-line text-blue-600 me-2"></i>Tracking Parameters
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        @if (!string.IsNullOrEmpty(Model.UtmSource))
                        {
                            <div>
                                <p class="text-sm text-gray-500">UTM Source</p>
                                <p class="font-medium text-gray-900">@Model.UtmSource</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.UtmMedium))
                        {
                            <div>
                                <p class="text-sm text-gray-500">UTM Medium</p>
                                <p class="font-medium text-gray-900">@Model.UtmMedium</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.UtmCampaign))
                        {
                            <div>
                                <p class="text-sm text-gray-500">UTM Campaign</p>
                                <p class="font-medium text-gray-900">@Model.UtmCampaign</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.UtmTerm))
                        {
                            <div>
                                <p class="text-sm text-gray-500">UTM Term</p>
                                <p class="font-medium text-gray-900">@Model.UtmTerm</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.UtmContent))
                        {
                            <div>
                                <p class="text-sm text-gray-500">UTM Content</p>
                                <p class="font-medium text-gray-900">@Model.UtmContent</p>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Recent Calls -->
            <div class="bg-white rounded-lg shadow border p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Recent Calls</h2>
                
                @if (Model.PhoneCalls.Any())
                {
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead>
                                <tr>
                                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">From</th>
                                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Duration</th>
                                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Cost</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                @foreach (var call in Model.PhoneCalls.OrderByDescending(c => c.CallDate).Take(20))
                                {
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-4 py-3 text-sm text-gray-900">
                                            @call.CallDate.ToString("MMM d, h:mm tt")
                                        </td>
                                        <td class="px-4 py-3 text-sm text-gray-900">
                                            @call.FromNumber
                                            @if (!string.IsNullOrEmpty(call.CallerCity))
                                            {
                                                <br /><span class="text-xs text-gray-500">@call.CallerCity, @call.CallerState</span>
                                            }
                                        </td>
                                        <td class="px-4 py-3 text-sm text-gray-900">
                                            @TimeSpan.FromSeconds(call.DurationSeconds).ToString(@"mm\:ss")
                                        </td>
                                        <td class="px-4 py-3 text-sm">
                                            <span class="px-2 py-1 rounded text-xs @(call.Status == Notification_Application.Models.CallStatus.Completed ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800")">
                                                @call.Status
                                            </span>
                                        </td>
                                        <td class="px-4 py-3 text-sm text-gray-900">
                                            @call.Cost.ToString("C4")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-gray-500 text-center py-8">No calls yet</p>
                }
            </div>
        </div>

        <!-- Pricing & Info -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-lg shadow border p-6 mb-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Pricing</h2>
                <div class="space-y-3">
                    <div class="flex justify-between">
                        <span class="text-gray-600">Monthly Fee:</span>
                        <span class="font-medium">@Model.MonthlyFee.ToString("C2")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Per Minute:</span>
                        <span class="font-medium">@Model.PerMinuteRate.ToString("C4")</span>
                    </div>
                </div>
            </div>

            <div class="bg-blue-50 rounded-lg p-6">
                <h3 class="font-semibold text-gray-900 mb-3">
                    <i class="fas fa-lightbulb text-blue-600 me-2"></i>Tips
                </h3>
                <ul class="text-sm text-gray-600 space-y-2">
                    <li>• Update UTM parameters to track different campaigns</li>
                    <li>• Check analytics for call patterns</li>
                    <li>• Enable call recording for quality assurance</li>
                    <li>• Monitor costs to stay within budget</li>
                </ul>
            </div>
        </div>
    </div>
</div>
