@{
    ViewData["Title"] = "Order Phone Number";
    var phoneNumber = ViewBag.PhoneNumber as string;
    var type = ViewBag.Type as string;
    var monthlyFee = (decimal)ViewBag.MonthlyFee;
    var perMinuteRate = (decimal)ViewBag.PerMinuteRate;
}

<div class="max-w-4xl mx-auto px-4 py-8">
    <div class="mb-8">
        <a asp-action="Search" class="text-blue-600 hover:text-blue-800 text-sm font-medium mb-4 inline-block">
            <i class="fas fa-arrow-left me-2"></i>Back to Search
        </a>
        <h1 class="text-3xl font-bold text-gray-900">Order Phone Number</h1>
        <p class="text-gray-600 mt-2">Configure your new call tracking number</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
            @TempData["Error"]
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Order Form -->
        <div class="lg:col-span-2">
            <form asp-action="Purchase" method="post" class="bg-white rounded-lg shadow border p-6">
                <input type="hidden" name="phoneNumber" value="@phoneNumber" />
                <input type="hidden" name="type" value="@type" />

                <div class="mb-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-2">Selected Number</h2>
                    <p class="text-3xl font-bold text-blue-600">@phoneNumber</p>
                    <p class="text-sm text-gray-500 mt-1">@(type == "tollfree" ? "Toll-Free Number" : "Local Number")</p>
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Friendly Name *</label>
                    <input type="text" name="friendlyName" required 
                           placeholder="e.g., Main Campaign, Website Tracking" 
                           class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
                    <p class="text-xs text-gray-500 mt-1">Give this number a memorable name</p>
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Forward Calls To *</label>
                    <input type="tel" name="forwardToNumber" required 
                           placeholder="+1234567890" 
                           pattern="^\+?[1-9]\d{1,14}$"
                           class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
                    <p class="text-xs text-gray-500 mt-1">Enter the phone number where calls should be forwarded (E.164 format recommended)</p>
                </div>

                <div class="border-t pt-6 mb-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">
                        <i class="fas fa-chart-line text-blue-600 me-2"></i>Tracking Parameters (Optional)
                    </h3>
                    <p class="text-sm text-gray-600 mb-4">Add UTM parameters to track call sources in your CRM</p>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">UTM Source</label>
                            <input type="text" name="utmSource" placeholder="e.g., google" 
                                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">UTM Medium</label>
                            <input type="text" name="utmMedium" placeholder="e.g., cpc" 
                                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">UTM Campaign</label>
                            <input type="text" name="utmCampaign" placeholder="e.g., spring-sale" 
                                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">UTM Term</label>
                            <input type="text" name="utmTerm" placeholder="e.g., running-shoes" 
                                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-2">UTM Content</label>
                            <input type="text" name="utmContent" placeholder="e.g., banner-ad" 
                                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
                        </div>
                    </div>
                </div>

                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium">
                    <i class="fas fa-check me-2"></i>Purchase Number
                </button>
            </form>
        </div>

        <!-- Order Summary -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-lg shadow border p-6 sticky top-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Order Summary</h2>
                
                <div class="space-y-3 mb-6">
                    <div class="flex justify-between">
                        <span class="text-gray-600">Number Type:</span>
                        <span class="font-medium">@(type == "tollfree" ? "Toll-Free" : "Local")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Monthly Fee:</span>
                        <span class="font-medium">@monthlyFee.ToString("C2")/mo</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Per Minute:</span>
                        <span class="font-medium">@perMinuteRate.ToString("C4")/min</span>
                    </div>
                </div>

                <div class="border-t pt-4 mb-6">
                    <div class="flex justify-between text-lg font-semibold">
                        <span>Due Today:</span>
                        <span class="text-blue-600">@monthlyFee.ToString("C2")</span>
                    </div>
                    <p class="text-xs text-gray-500 mt-2">Includes first month. Usage charges billed monthly.</p>
                </div>

                <div class="bg-blue-50 rounded-lg p-4">
                    <h3 class="font-semibold text-gray-900 mb-2">
                        <i class="fas fa-info-circle text-blue-600 me-2"></i>What's Included
                    </h3>
                    <ul class="text-sm text-gray-600 space-y-1">
                        <li>✓ Call forwarding</li>
                        <li>✓ Call recording</li>
                        <li>✓ UTM tracking</li>
                        <li>✓ CRM integration</li>
                        <li>✓ Analytics & reporting</li>
                        <li>✓ Caller ID data</li>
                    </ul>
                </div>

                <div class="mt-4 bg-yellow-50 rounded-lg p-4">
                    <p class="text-xs text-yellow-800">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        By purchasing, you agree to Twilio's usage policies and our terms of service. Monthly fees are non-refundable.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
