@section Scripts {
<script>
    function showCategory(category) {
        // Update tab styles
        document.querySelectorAll('.category-tab').forEach(tab => {
            tab.classList.remove('active');
            if (tab.dataset.tab === category) {
                tab.classList.add('active');
            }
        });
        
        // Show/hide sections
        document.querySelectorAll('.category-section').forEach(section => {
            if (category === 'all') {
                section.style.display = 'block';
            } else {
                section.style.display = section.dataset.category === category ? 'block' : 'none';
            }
        });
    }

    // Website URL form submission
    document.getElementById('websiteUrlForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const websiteUrl = document.getElementById('websiteUrl').value.trim();
        const saveBtn = this.querySelector('button[type="submit"]');
        const originalText = saveBtn.innerHTML;
        
        // Basic URL validation
        if (!websiteUrl) {
            alert('Please enter a website URL');
            return;
        }
        
        if (!websiteUrl.startsWith('http://') && !websiteUrl.startsWith('https://')) {
            alert('Website URL must start with http:// or https://');
            return;
        }
        
        // Show loading state
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Saving...';
        
        try {
            const response = await fetch('/Integration/SaveWebsiteUrl', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ websiteUrl: websiteUrl })
            });
            
            if (response.ok) {
                const result = await response.json();
                // Show success message
                saveBtn.innerHTML = '<i class="fas fa-check mr-2"></i>Saved!';
                saveBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
                saveBtn.classList.add('bg-green-600');
                
                // Reset button after 2 seconds
                setTimeout(() => {
                    saveBtn.innerHTML = originalText;
                    saveBtn.classList.remove('bg-green-600');
                    saveBtn.classList.add('bg-blue-600', 'hover:bg-blue-700');
                    saveBtn.disabled = false;
                }, 2000);
                
                // Show toast notification
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'Website URL Saved',
                        text: 'Your website URL has been configured for live testing.',
                        timer: 3000,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                }
            } else {
                throw new Error('Failed to save website URL');
            }
        } catch (error) {
            console.error('Error saving website URL:', error);
            alert('Failed to save website URL. Please try again.');
            saveBtn.innerHTML = originalText;
            saveBtn.disabled = false;
        }
    });

    // Allowed Websites Management
    const maxWebsites = @ViewBag.MaxWebsites;
    let currentWebsiteCount = @ViewBag.CurrentWebsiteCount;

    // Load allowed websites on page load
    async function loadAllowedWebsites() {
        try {
            const response = await fetch('/Integration/GetAllowedWebsites');
            const data = await response.json();
            
            if (data.success && data.websites) {
                renderWebsitesList(data.websites);
                currentWebsiteCount = data.websites.length;
                updateWebsiteCount();
            }
        } catch (error) {
            console.error('Error loading websites:', error);
        }
    }

    function renderWebsitesList(websites) {
        const container = document.getElementById('websitesList');
        
        if (websites.length === 0) {
            container.innerHTML = `
                <div class="text-center py-8 text-gray-500">
                    <i class="fas fa-globe text-4xl mb-3 opacity-30"></i>
                    <p>No websites added yet. Click "Add Website" to get started.</p>
                </div>`;
            return;
        }

        container.innerHTML = websites.map(website => {
            const pixelScript = `<script src="@ViewBag.AppUrl/js/pixel.js?key=${website.trackingKey || '@ViewBag.TenantKey'}" async></script>`;
            return `
            <div class="p-4 bg-gray-50 rounded-lg border border-gray-200 hover:border-blue-300 transition-colors">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                            <i class="fas fa-globe text-blue-600"></i>
                        </div>
                        <div>
                            <div class="font-semibold text-gray-900">${website.domain}</div>
                            <div class="text-sm text-gray-500">${website.url}</div>
                            ${website.notes ? `<div class="text-xs text-gray-400 mt-1">${website.notes}</div>` : ''}
                        </div>
                    </div>
                    <button onclick="removeWebsite(${website.id}, '${website.domain}')" 
                            class="px-3 py-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
                
                <!-- Per-Website Pixel Script -->
                <div class="mt-3 pt-3 border-t border-gray-200">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-semibold text-gray-600 uppercase">
                            <i class="fas fa-code mr-1"></i>Pixel for this site
                        </span>
                        <button onclick="copyWebsitePixel(${website.id}, '${pixelScript.replace(/'/g, "\\'")}')" 
                                class="text-xs px-2 py-1 bg-purple-100 text-purple-700 rounded hover:bg-purple-200 transition-colors">
                            <i class="fas fa-copy mr-1"></i>Copy
                        </button>
                    </div>
                    <code class="text-xs bg-gray-900 text-green-400 p-2 rounded block overflow-x-auto" style="font-family: monospace;">
                        ${pixelScript}
                    </code>
                    <p class="text-xs text-gray-500 mt-1">
                        <i class="fas fa-info-circle mr-1"></i>This unique pixel tracks only this website's activity
                    </p>
                </div>
            </div>
        `}).join('');
    }

    function updateWebsiteCount() {
        document.getElementById('websiteCount').textContent = currentWebsiteCount;
    }

    // Add website button click
    document.getElementById('addWebsiteBtn').addEventListener('click', async function() {
        // Check limit
        if (currentWebsiteCount >= maxWebsites && maxWebsites < 9999) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'warning',
                    title: 'Limit Reached',
                    html: `You've reached your plan limit of <strong>${maxWebsites}</strong> website(s).<br><br>
                           <a href="/Payment" class="text-blue-600 hover:underline">Upgrade your plan</a> to add more websites.`,
                    showConfirmButton: true
                });
            } else {
                alert(`You've reached your plan limit of ${maxWebsites} website(s). Please upgrade to add more.`);
            }
            return;
        }

        // Show input dialog
        if (typeof Swal !== 'undefined') {
            const { value: formValues } = await Swal.fire({
                title: 'Add Website',
                html: `
                    <input id="swal-url" class="swal2-input" placeholder="https://example.com" type="url" required>
                    <input id="swal-notes" class="swal2-input" placeholder="Notes (optional)">
                `,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Add Website',
                preConfirm: () => {
                    const url = document.getElementById('swal-url').value;
                    const notes = document.getElementById('swal-notes').value;
                    
                    if (!url) {
                        Swal.showValidationMessage('Please enter a website URL');
                        return false;
                    }
                    
                    if (!url.startsWith('http://') && !url.startsWith('https://')) {
                        Swal.showValidationMessage('URL must start with http:// or https://');
                        return false;
                    }
                    
                    return { url, notes };
                }
            });

            if (formValues) {
                await addWebsite(formValues.url, formValues.notes);
            }
        } else {
            const url = prompt('Enter website URL (e.g., https://example.com):');
            if (url) {
                await addWebsite(url, '');
            }
        }
    });

    async function addWebsite(url, notes) {
        try {
            const response = await fetch('/Integration/AddAllowedWebsite', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ url, notes })
            });

            const data = await response.json();

            if (data.success) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'Website Added',
                        text: 'Your website has been added successfully.',
                        timer: 2000,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                }
                await loadAllowedWebsites();
            } else {
                throw new Error(data.message || 'Failed to add website');
            }
        } catch (error) {
            console.error('Error adding website:', error);
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: error.message || 'Failed to add website. Please try again.'
                });
            } else {
                alert(error.message || 'Failed to add website. Please try again.');
            }
        }
    }

    async function removeWebsite(id, domain) {
        const confirmed = typeof Swal !== 'undefined' 
            ? await Swal.fire({
                title: 'Remove Website?',
                text: `Are you sure you want to remove ${domain}?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                confirmButtonText: 'Yes, remove it'
            }).then(result => result.isConfirmed)
            : confirm(`Are you sure you want to remove ${domain}?`);

        if (!confirmed) return;

        try {
            const response = await fetch(`/Integration/RemoveAllowedWebsite/${id}`, {
                method: 'POST'
            });

            const data = await response.json();

            if (data.success) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'Website Removed',
                        timer: 2000,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                }
                await loadAllowedWebsites();
            } else {
                throw new Error(data.message || 'Failed to remove website');
            }
        } catch (error) {
            console.error('Error removing website:', error);
            alert('Failed to remove website. Please try again.');
        }
    }

    // Load websites on page load
    loadAllowedWebsites();

    // Google Analytics & GTM Configuration
    document.getElementById('analyticsForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const gtmId = document.getElementById('gtmId').value.trim();
        const ga4Id = document.getElementById('ga4Id').value.trim();
        const saveBtn = this.querySelector('button[type="submit"]');
        const originalText = saveBtn.innerHTML;
        
        // Validate formats
        if (gtmId && !/^GTM-[A-Z0-9]+$/.test(gtmId)) {
            alert('GTM ID must be in format: GTM-XXXXXXX');
            return;
        }
        
        if (ga4Id && !/^G-[A-Z0-9]+$/.test(ga4Id)) {
            alert('GA4 ID must be in format: G-XXXXXXXXXX');
            return;
        }
        
        // Show loading state
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Saving...';
        
        try {
            const response = await fetch('/Integration/SaveAnalyticsConfig', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ gtmId, ga4Id })
            });
            
            if (response.ok) {
                // Show success message
                saveBtn.innerHTML = '<i class="fas fa-check mr-2"></i>Saved!';
                const btnClasses = saveBtn.className.split(' ');
                saveBtn.className = btnClasses.filter(c => !c.includes('orange') && !c.includes('red')).join(' ') + ' bg-green-600';
                
                // Reset button after 2 seconds
                setTimeout(() => {
                    saveBtn.innerHTML = originalText;
                    saveBtn.className = 'px-6 py-3 bg-gradient-to-r from-orange-600 to-red-600 text-white font-semibold rounded-xl hover:from-orange-700 hover:to-red-700 transition-all shadow-lg hover:shadow-xl';
                    saveBtn.disabled = false;
                }, 2000);
                
                // Show toast notification
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'Analytics Configured',
                        text: 'Your tracking codes will now be automatically added to all content.',
                        timer: 3000,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                }
            } else {
                throw new Error('Failed to save analytics configuration');
            }
        } catch (error) {
            console.error('Error saving analytics config:', error);
            alert('Failed to save analytics configuration. Please try again.');
            saveBtn.innerHTML = originalText;
            saveBtn.disabled = false;
        }
    });

    // Pixel Script Functions
    function copyPixelScript() {
        const scriptText = document.getElementById('pixelScriptCode').textContent;
        navigator.clipboard.writeText(scriptText).then(() => {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'success',
                    title: 'Copied!',
                    text: 'Universal tracking pixel copied to clipboard',
                    timer: 2000,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
            } else {
                alert('Pixel script copied to clipboard!');
            }
        }).catch(err => {
            console.error('Failed to copy:', err);
            alert('Failed to copy script. Please copy manually.');
        });
    }

    function copyWebsitePixel(websiteId, pixelScript) {
        navigator.clipboard.writeText(pixelScript).then(() => {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'success',
                    title: 'Copied!',
                    text: 'Website-specific pixel copied to clipboard',
                    timer: 2000,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
            } else {
                alert('Website pixel copied to clipboard!');
            }
        }).catch(err => {
            console.error('Failed to copy:', err);
            alert('Failed to copy script. Please copy manually.');
        });
    }

    async function testPixelInstallation() {
        const url = document.getElementById('testPixelUrl').value.trim();
        
        if (!url) {
            alert('Please enter a website URL to test');
            return;
        }
        
        if (!url.startsWith('http://') && !url.startsWith('https://')) {
            alert('Please enter a valid URL (including http:// or https://)');
            return;
        }
        
        const loadingDiv = document.getElementById('pixelTestLoading');
        const resultsDiv = document.getElementById('pixelTestResults');
        
        loadingDiv.classList.remove('d-none');
        resultsDiv.innerHTML = '';
        
        try {
            const response = await fetch('/Integration/TestPixel', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ url: url })
            });
            
            const result = await response.json();
            
            loadingDiv.classList.add('d-none');
            
            if (result.installed) {
                resultsDiv.innerHTML = `
                    <div class="alert alert-success border-2 border-green-300">
                        <div class="flex items-start gap-3">
                            <i class="fas fa-check-circle text-green-600 text-2xl"></i>
                            <div class="flex-1">
                                <h5 class="font-bold text-green-900 mb-2">✓ Pixel Installed Successfully!</h5>
                                <p class="text-sm text-green-800 mb-2">The tracking pixel is properly installed on this website.</p>
                                <div class="text-xs text-green-700">
                                    <div><strong>Pixel Version:</strong> ${result.pixelVersion || 'v1.0'}</div>
                                    ${result.popupsFound ? `<div><strong>Active Popups:</strong> ${result.popupsFound} found</div>` : ''}
                                    ${result.lastSeen ? `<div><strong>Last Activity:</strong> ${result.lastSeen}</div>` : ''}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            } else {
                resultsDiv.innerHTML = `
                    <div class="alert alert-warning border-2 border-orange-300">
                        <div class="flex items-start gap-3">
                            <i class="fas fa-exclamation-triangle text-orange-600 text-2xl"></i>
                            <div class="flex-1">
                                <h5 class="font-bold text-orange-900 mb-2">⚠ Pixel Not Detected</h5>
                                <p class="text-sm text-orange-800 mb-2">The tracking pixel was not found on this website.</p>
                                <div class="text-xs text-orange-700">
                                    <strong>Possible reasons:</strong>
                                    <ul class="list-disc list-inside mt-1 ml-2">
                                        <li>Script not added to website</li>
                                        <li>Script in GTM but not published</li>
                                        <li>Website behind firewall or authentication</li>
                                        <li>Incorrect tenant key</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }
        } catch (error) {
            loadingDiv.classList.add('d-none');
            resultsDiv.innerHTML = `
                <div class="alert alert-danger border-2 border-red-300">
                    <div class="flex items-start gap-3">
                        <i class="fas fa-times-circle text-red-600 text-2xl"></i>
                        <div class="flex-1">
                            <h5 class="font-bold text-red-900 mb-2">✗ Test Failed</h5>
                            <p class="text-sm text-red-800">${error.message || 'Unable to reach the website. Please check the URL and try again.'}</p>
                        </div>
                    </div>
                </div>
            `;
        }
    }
</script>
}
