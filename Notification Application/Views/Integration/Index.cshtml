    <!-- eCommerce Section -->
    <div class="category-section" data-category="ecommerce">
        <div class="mb-6 flex items-center gap-3">
            <div class="bg-teal-100 rounded-xl p-3">
                <i class="fas fa-shopping-cart text-teal-600 text-xl"></i>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-gray-900">eCommerce</h2>
                <p class="text-gray-600 text-sm">Connect your online store</p>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 mb-10">
            @foreach (var integration in Model.AvailableEcommerceIntegrations)
            {
                var isConnected = Model.ConnectedIntegrations.Any(c => c.Type == integration.Type && c.IsConnected);
                <div class="integration-card bg-white rounded-xl border border-gray-200 p-5 hover:border-teal-300">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-teal-500 to-teal-700 flex items-center justify-center shadow">
                            <i class="@GetIntegrationIcon(integration.Type) text-white text-xl"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-gray-900 truncate">@integration.Name</h3>
                            @if (isConnected)
                            {
                                <span class="inline-flex items-center gap-1 text-xs text-green-600">
                                    <i class="fas fa-check-circle"></i> Connected
                                </span>
                            }
                        </div>
                    </div>
                    <p class="text-sm text-gray-600 mb-4 line-clamp-2">@integration.Description</p>
                    <a asp-action="Configure" asp-route-type="@integration.Type"
                       class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 @(isConnected ? "bg-gray-100 text-gray-700 hover:bg-gray-200" : "bg-teal-600 text-white hover:bg-teal-700") rounded-lg text-sm font-semibold transition-all">
                        @if (isConnected)
                        {
                            <i class="fas fa-cog"></i>
                            <span>Manage</span>
                        }
                        else
                        {
                            <i class="fas fa-plus-circle"></i>
                            <span>Connect</span>
                        }
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Custom Webhook Section -->
    <div class="category-section" data-category="all">
        <div class="mb-6 flex items-center gap-3">
            <div class="bg-gray-100 rounded-xl p-3">
                <i class="fas fa-code text-gray-600 text-xl"></i>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-gray-900">Custom Integrations</h2>
                <p class="text-gray-600 text-sm">Build your own integrations with webhooks and APIs</p>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 mb-10">
            @foreach (var integration in Model.CustomIntegrations)
            {
                var isConnected = Model.ConnectedIntegrations.Any(c => c.Type == integration.Type && c.IsConnected);
                <div class="integration-card bg-white rounded-xl border border-gray-200 p-5 hover:border-gray-400">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-gray-500 to-gray-700 flex items-center justify-center shadow">
                            <i class="@GetIntegrationIcon(integration.Type) text-white text-xl"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-gray-900 truncate">@integration.Name</h3>
                            @if (isConnected)
                            {
                                <span class="inline-flex items-center gap-1 text-xs text-green-600">
                                    <i class="fas fa-check-circle"></i> Connected
                                </span>
                            }
                        </div>
                    </div>
                    <p class="text-sm text-gray-600 mb-4 line-clamp-2">@integration.Description</p>
                    <a asp-action="Configure" asp-route-type="@integration.Type"
                       class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 @(isConnected ? "bg-gray-100 text-gray-700 hover:bg-gray-200" : "bg-gray-700 text-white hover:bg-gray-800") rounded-lg text-sm font-semibold transition-all">
                        @if (isConnected)
                        {
                            <i class="fas fa-cog"></i>
                            <span>Manage</span>
                        }
                        else
                        {
                            <i class="fas fa-plus-circle"></i>
                            <span>Configure</span>
                        }
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- How It Works -->
    <div class="bg-gradient-to-r from-indigo-50 to-purple-50 rounded-2xl p-8 border border-indigo-100">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
            <i class="fas fa-info-circle text-indigo-600"></i>
            How Integrations Work
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white rounded-xl p-6 shadow-sm">
                <div class="w-12 h-12 rounded-xl bg-indigo-100 flex items-center justify-center mb-4">
                    <i class="fas fa-plug text-indigo-600 text-xl"></i>
                </div>
                <h3 class="font-bold text-gray-900 mb-2">1. Connect</h3>
                <p class="text-sm text-gray-600">Choose an integration and enter your API credentials or authorize via OAuth.</p>
            </div>
            <div class="bg-white rounded-xl p-6 shadow-sm">
                <div class="w-12 h-12 rounded-xl bg-indigo-100 flex items-center justify-center mb-4">
                    <i class="fas fa-sync-alt text-indigo-600 text-xl"></i>
                </div>
                <h3 class="font-bold text-gray-900 mb-2">2. Sync Automatically</h3>
                <p class="text-sm text-gray-600">New leads from popups and forms are automatically synced to your connected platforms.</p>
            </div>
            <div class="bg-white rounded-xl p-6 shadow-sm">
                <div class="w-12 h-12 rounded-xl bg-indigo-100 flex items-center justify-center mb-4">
                    <i class="fas fa-chart-line text-indigo-600 text-xl"></i>
                </div>
                <h3 class="font-bold text-gray-900 mb-2">3. Track Performance</h3>
                <p class="text-sm text-gray-600">Monitor sync status, view logs, and track how popups drive conversions in your tools.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function showCategory(category) {
        // Update tab styles
        document.querySelectorAll('.category-tab').forEach(tab => {
            tab.classList.remove('active');
            if (tab.dataset.tab === category) {
                tab.classList.add('active');
            }
        });
        
        // Show/hide sections
        document.querySelectorAll('.category-section').forEach(section => {
            if (category === 'all') {
                section.style.display = 'block';
            } else {
                section.style.display = section.dataset.category === category ? 'block' : 'none';
            }
        });
    }
</script>
}
