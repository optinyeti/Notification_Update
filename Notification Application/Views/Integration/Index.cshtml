@model IntegrationIndexViewModel
@{
    ViewData["Title"] = "Integrations";
    
    // Helper to get icon for integration type
    string GetIntegrationIcon(IntegrationType type)
    {
        return type switch
        {
            IntegrationType.Mailchimp => "fas fa-mail-bulk",
            IntegrationType.Brevo => "fas fa-envelope",
            IntegrationType.ConvertKit => "fas fa-paper-plane",
            IntegrationType.MailerLite => "fas fa-envelope-open-text",
            IntegrationType.ActiveCampaign => "fas fa-bullseye",
            IntegrationType.Klaviyo => "fas fa-chart-line",
            IntegrationType.CampaignMonitor => "fas fa-broadcast-tower",
            IntegrationType.Listrak => "fas fa-list",
            IntegrationType.Marketo => "fas fa-marker",
            IntegrationType.HubSpot => "fab fa-hubspot",
            IntegrationType.Salesforce => "fab fa-salesforce",
            IntegrationType.Pipedrive => "fas fa-funnel-dollar",
            IntegrationType.Zoho => "fas fa-database",
            IntegrationType.Freshsales => "fas fa-leaf",
            IntegrationType.Keap => "fas fa-key",
            IntegrationType.HighLevel => "fas fa-level-up-alt",
            IntegrationType.Close => "fas fa-handshake",
            IntegrationType.Zapier => "fas fa-bolt",
            IntegrationType.Make => "fas fa-cogs",
            IntegrationType.n8n => "fas fa-project-diagram",
            IntegrationType.Pabbly => "fas fa-link",
            IntegrationType.GoogleAnalytics4 => "fab fa-google",
            IntegrationType.FacebookPixel => "fab fa-facebook",
            IntegrationType.GoogleTagManager => "fas fa-tags",
            IntegrationType.MicrosoftClarity => "fab fa-microsoft",
            IntegrationType.Hotjar => "fas fa-fire",
            IntegrationType.Mixpanel => "fas fa-chart-pie",
            IntegrationType.Segment => "fas fa-random",
            IntegrationType.Slack => "fab fa-slack",
            IntegrationType.Discord => "fab fa-discord",
            IntegrationType.MicrosoftTeams => "fab fa-microsoft",
            IntegrationType.Twilio => "fas fa-sms",
            IntegrationType.Shopify => "fab fa-shopify",
            IntegrationType.WooCommerce => "fab fa-wordpress",
            IntegrationType.Webhook => "fas fa-code",
            IntegrationType.CustomAPI => "fas fa-plug",
            _ => "fas fa-puzzle-piece"
        };
    }
    
    string GetCategoryColor(IntegrationCategory category)
    {
        return category switch
        {
            IntegrationCategory.EmailMarketing => "blue",
            IntegrationCategory.CRM => "purple",
            IntegrationCategory.Automation => "orange",
            IntegrationCategory.Analytics => "green",
            IntegrationCategory.Communication => "pink",
            IntegrationCategory.eCommerce => "teal",
            IntegrationCategory.Custom => "gray",
            _ => "gray"
        };
    }
    
    string GetCategoryGradient(IntegrationCategory category)
    {
        return category switch
        {
            IntegrationCategory.EmailMarketing => "from-blue-500 to-blue-700",
            IntegrationCategory.CRM => "from-purple-500 to-purple-700",
            IntegrationCategory.Automation => "from-orange-500 to-orange-700",
            IntegrationCategory.Analytics => "from-green-500 to-green-700",
            IntegrationCategory.Communication => "from-pink-500 to-pink-700",
            IntegrationCategory.eCommerce => "from-teal-500 to-teal-700",
            IntegrationCategory.Custom => "from-gray-500 to-gray-700",
            _ => "from-gray-500 to-gray-700"
        };
    }
}

<style>
    .integration-card {
        transition: all 0.3s ease;
    }
    .integration-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }
    .category-tab {
        transition: all 0.2s ease;
    }
    .category-tab.active {
        border-bottom: 3px solid #6366f1;
        color: #4f46e5;
        font-weight: 600;
    }
    .status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        animation: pulse 2s infinite;
    }
    .status-dot.connected {
        background: #10b981;
    }
    .status-dot.disconnected {
        background: #ef4444;
    }
    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }
</style>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl p-4 shadow-lg">
                    <i class="fas fa-plug text-white text-3xl"></i>
                </div>
                <div>
                    <h1 class="text-4xl font-bold text-gray-900">Integrations</h1>
                    <p class="text-gray-600 mt-1">Connect your favorite tools and automate workflows</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-2 px-4 py-2 bg-green-100 text-green-800 rounded-full text-sm font-medium">
                    <span class="status-dot connected"></span>
                    @Model.ConnectedIntegrations.Count(i => i.IsConnected) Connected
                </span>
            </div>
        </div>
    </div>

    <!-- Connected Integrations -->
    @if (Model.ConnectedIntegrations.Any())
    {
        <div class="mb-10">
            <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                <i class="fas fa-check-circle text-green-500"></i>
                Your Connected Integrations
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var integration in Model.ConnectedIntegrations)
                {
                    var color = GetCategoryColor(integration.Category);
                    <div class="integration-card bg-white rounded-xl border-2 border-gray-100 p-5 shadow-md">
                        <div class="flex items-start justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 rounded-xl bg-gradient-to-br @GetCategoryGradient(integration.Category) flex items-center justify-center shadow">
                                    <i class="@GetIntegrationIcon(integration.Type) text-white text-xl"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-gray-900">@integration.Name</h3>
                                    <div class="flex items-center gap-2 mt-1">
                                        @if (integration.IsConnected)
                                        {
                                            <span class="inline-flex items-center gap-1 text-xs text-green-600 bg-green-50 px-2 py-0.5 rounded-full">
                                                <i class="fas fa-check-circle"></i> Connected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 text-xs text-yellow-600 bg-yellow-50 px-2 py-0.5 rounded-full">
                                                <i class="fas fa-exclamation-triangle"></i> Pending
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between">
                            <div class="text-xs text-gray-500">
                                @if (integration.LastSyncAt.HasValue)
                                {
                                    <span>Last sync: @integration.LastSyncAt.Value.ToString("MMM d, h:mm tt")</span>
                                }
                                else
                                {
                                    <span>Syncs: @integration.SyncCount</span>
                                }
                            </div>
                            <div class="flex items-center gap-2">
                                <a asp-action="Configure" asp-route-type="@integration.Type" 
                                   class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">
                                    <i class="fas fa-cog"></i> Settings
                                </a>
                                <form asp-action="Disconnect" asp-route-id="@integration.Id" method="post" class="inline"
                                      onsubmit="return confirm('Are you sure you want to disconnect this integration?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-red-600 hover:text-red-800 text-sm font-medium">
                                        <i class="fas fa-unlink"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Category Tabs -->
    <div class="mb-6 border-b border-gray-200">
        <nav class="flex space-x-8 overflow-x-auto" aria-label="Tabs">
            <button onclick="showCategory('all')" class="category-tab active px-1 py-4 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="all">
                <i class="fas fa-th-large me-2"></i>All Integrations
            </button>
            <button onclick="showCategory('email')" class="category-tab px-1 py-4 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="email">
                <i class="fas fa-envelope me-2"></i>Email Marketing
            </button>
            <button onclick="showCategory('crm')" class="category-tab px-1 py-4 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="crm">
                <i class="fas fa-address-book me-2"></i>CRM
            </button>
            <button onclick="showCategory('automation')" class="category-tab px-1 py-4 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="automation">
                <i class="fas fa-bolt me-2"></i>Automation
            </button>
            <button onclick="showCategory('analytics')" class="category-tab px-1 py-4 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="analytics">
                <i class="fas fa-chart-bar me-2"></i>Analytics
            </button>
            <button onclick="showCategory('communication')" class="category-tab px-1 py-4 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="communication">
                <i class="fas fa-comments me-2"></i>Communication
            </button>
            <button onclick="showCategory('ecommerce')" class="category-tab px-1 py-4 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="ecommerce">
                <i class="fas fa-shopping-cart me-2"></i>eCommerce
            </button>
        </nav>
    </div>

    <!-- Email Marketing Section -->
    <div class="category-section" data-category="email">
        <div class="mb-6 flex items-center gap-3">
            <div class="bg-blue-100 rounded-xl p-3">
                <i class="fas fa-envelope text-blue-600 text-xl"></i>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-gray-900">Email Marketing</h2>
                <p class="text-gray-600 text-sm">Sync leads with your email marketing platforms</p>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 mb-10">
            @foreach (var integration in Model.AvailableEmailIntegrations)
            {
                var isConnected = Model.ConnectedIntegrations.Any(c => c.Type == integration.Type && c.IsConnected);
                <div class="integration-card bg-white rounded-xl border border-gray-200 p-5 hover:border-blue-300">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center shadow">
                            <i class="@GetIntegrationIcon(integration.Type) text-white text-xl"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-gray-900 truncate">@integration.Name</h3>
                            @if (isConnected)
                            {
                                <span class="inline-flex items-center gap-1 text-xs text-green-600">
                                    <i class="fas fa-check-circle"></i> Connected
                                </span>
                            }
                        </div>
                    </div>
                    <p class="text-sm text-gray-600 mb-4 line-clamp-2">@integration.Description</p>
                    <a asp-action="Configure" asp-route-type="@integration.Type"
                       class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 @(isConnected ? "bg-gray-100 text-gray-700 hover:bg-gray-200" : "bg-blue-600 text-white hover:bg-blue-700") rounded-lg text-sm font-semibold transition-all">
                        @if (isConnected)
                        {
                            <i class="fas fa-cog"></i>
                            <span>Manage</span>
                        }
                        else
                        {
                            <i class="fas fa-plus-circle"></i>
                            <span>Connect</span>
                        }
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- CRM Section -->
    <div class="category-section" data-category="crm">
        <div class="mb-6 flex items-center gap-3">
            <div class="bg-purple-100 rounded-xl p-3">
                <i class="fas fa-address-book text-purple-600 text-xl"></i>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-gray-900">CRM Integrations</h2>
                <p class="text-gray-600 text-sm">Push leads directly to your CRM system</p>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 mb-10">
            @foreach (var integration in Model.AvailableCrmIntegrations)
            {
                var isConnected = Model.ConnectedIntegrations.Any(c => c.Type == integration.Type && c.IsConnected);
                <div class="integration-card bg-white rounded-xl border border-gray-200 p-5 hover:border-purple-300">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500 to-purple-700 flex items-center justify-center shadow">
                            <i class="@GetIntegrationIcon(integration.Type) text-white text-xl"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-gray-900 truncate">@integration.Name</h3>
                            @if (integration.IsPremium && Model.PlanId < 3)
                            {
                                <span class="inline-flex items-center gap-1 text-xs text-yellow-600">
                                    <i class="fas fa-crown"></i> Pro+
                                </span>
                            }
                            else if (isConnected)
                            {
                                <span class="inline-flex items-center gap-1 text-xs text-green-600">
                                    <i class="fas fa-check-circle"></i> Connected
                                </span>
                            }
                        </div>
                    </div>
                    <p class="text-sm text-gray-600 mb-4 line-clamp-2">@integration.Description</p>
                    @if (integration.IsPremium && Model.PlanId < 3)
                    {
                        <a asp-controller="Payment" asp-action="Upgrade"
                           class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-yellow-400 to-yellow-500 text-yellow-900 rounded-lg text-sm font-semibold transition-all hover:shadow-lg">
                            <i class="fas fa-crown"></i>
                            <span>Upgrade to Pro</span>
                        </a>
                    }
                    else
                    {
                        <a asp-action="Configure" asp-route-type="@integration.Type"
                           class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 @(isConnected ? "bg-gray-100 text-gray-700 hover:bg-gray-200" : "bg-purple-600 text-white hover:bg-purple-700") rounded-lg text-sm font-semibold transition-all">
                            @if (isConnected)
                            {
                                <i class="fas fa-cog"></i>
                                <span>Manage</span>
                            }
                            else
                            {
                                <i class="fas fa-plus-circle"></i>
                                <span>Connect</span>
                            }
                        </a>
                    }
                </div>
            }
        </div>
    </div>

