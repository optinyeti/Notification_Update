                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-500 to-orange-700 flex items-center justify-center shadow">
                            <i class="@GetIntegrationIcon(integration.Type) text-white text-xl"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-gray-900 truncate">@integration.Name</h3>
                            @if (isConnected)
                            {
                                <span class="inline-flex items-center gap-1 text-xs text-green-600">
                                    <i class="fas fa-check-circle"></i> Connected
                                </span>
                            }
                        </div>
                    </div>
                    <p class="text-sm text-gray-600 mb-4 line-clamp-2">@integration.Description</p>
                    <a asp-action="Configure" asp-route-type="@integration.Type"
                       class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 @(isConnected ? "bg-gray-100 text-gray-700 hover:bg-gray-200" : "bg-orange-600 text-white hover:bg-orange-700") rounded-lg text-sm font-semibold transition-all">
                        @if (isConnected)
                        {
                            <i class="fas fa-cog"></i>
                            <span>Manage</span>
                        }
                        else
                        {
                            <i class="fas fa-plus-circle"></i>
                            <span>Connect</span>
                        }
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Analytics Section -->
    <div class="category-section" data-category="analytics">
        <div class="mb-6 flex items-center gap-3">
            <div class="bg-green-100 rounded-xl p-3">
                <i class="fas fa-chart-bar text-green-600 text-xl"></i>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-gray-900">Analytics & Tracking</h2>
                <p class="text-gray-600 text-sm">Track popup performance across your analytics platforms</p>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 mb-10">
            @foreach (var integration in Model.AvailableAnalyticsIntegrations)
            {
                var isConnected = Model.ConnectedIntegrations.Any(c => c.Type == integration.Type && c.IsConnected);
                <div class="integration-card bg-white rounded-xl border border-gray-200 p-5 hover:border-green-300">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-green-500 to-green-700 flex items-center justify-center shadow">
                            <i class="@GetIntegrationIcon(integration.Type) text-white text-xl"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-gray-900 truncate">@integration.Name</h3>
                            @if (isConnected)
                            {
                                <span class="inline-flex items-center gap-1 text-xs text-green-600">
                                    <i class="fas fa-check-circle"></i> Connected
                                </span>
                            }
                        </div>
                    </div>
                    <p class="text-sm text-gray-600 mb-4 line-clamp-2">@integration.Description</p>
                    <a asp-action="Configure" asp-route-type="@integration.Type"
                       class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 @(isConnected ? "bg-gray-100 text-gray-700 hover:bg-gray-200" : "bg-green-600 text-white hover:bg-green-700") rounded-lg text-sm font-semibold transition-all">
                        @if (isConnected)
                        {
                            <i class="fas fa-cog"></i>
                            <span>Manage</span>
                        }
                        else
                        {
                            <i class="fas fa-plus-circle"></i>
                            <span>Connect</span>
                        }
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Communication Section -->
    <div class="category-section" data-category="communication">
        <div class="mb-6 flex items-center gap-3">
            <div class="bg-pink-100 rounded-xl p-3">
                <i class="fas fa-comments text-pink-600 text-xl"></i>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-gray-900">Communication</h2>
                <p class="text-gray-600 text-sm">Get notified when leads convert</p>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 mb-10">
            @foreach (var integration in Model.AvailableCommunicationIntegrations)
            {
                var isConnected = Model.ConnectedIntegrations.Any(c => c.Type == integration.Type && c.IsConnected);
                <div class="integration-card bg-white rounded-xl border border-gray-200 p-5 hover:border-pink-300">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-pink-500 to-pink-700 flex items-center justify-center shadow">
                            <i class="@GetIntegrationIcon(integration.Type) text-white text-xl"></i>
                        </div>
                        <div class="flex-1 min-w-0">
