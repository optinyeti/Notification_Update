                    <p class="text-sm text-gray-600 mb-4 line-clamp-2">@integration.Description</p>
                    <a asp-action="Configure" asp-route-type="@integration.Type"
                       class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 @(isConnected ? "bg-gray-100 text-gray-700 hover:bg-gray-200" : "bg-pink-600 text-white hover:bg-pink-700") rounded-lg text-sm font-semibold transition-all">
                        @if (isConnected)
