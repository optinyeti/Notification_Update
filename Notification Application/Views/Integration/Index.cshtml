@model IntegrationIndexViewModel
@{
    ViewData["Title"] = "Integrations";
    
    // Helper to get icon for integration type
    string GetIntegrationIcon(IntegrationType type)
    {
        return type switch
        {
            IntegrationType.Mailchimp => "fas fa-mail-bulk",
            IntegrationType.Brevo => "fas fa-envelope",
            IntegrationType.ConvertKit => "fas fa-paper-plane",
            IntegrationType.MailerLite => "fas fa-envelope-open-text",
            IntegrationType.ActiveCampaign => "fas fa-bullseye",
            IntegrationType.Klaviyo => "fas fa-chart-line",
            IntegrationType.CampaignMonitor => "fas fa-broadcast-tower",
            IntegrationType.Listrak => "fas fa-list",
            IntegrationType.Marketo => "fas fa-marker",
            IntegrationType.HubSpot => "fab fa-hubspot",
            IntegrationType.Salesforce => "fab fa-salesforce",
            IntegrationType.Pipedrive => "fas fa-funnel-dollar",
            IntegrationType.Zoho => "fas fa-database",
            IntegrationType.Freshsales => "fas fa-leaf",
            IntegrationType.Keap => "fas fa-key",
            IntegrationType.HighLevel => "fas fa-level-up-alt",
            IntegrationType.Close => "fas fa-handshake",
            IntegrationType.Zapier => "fas fa-bolt",
            IntegrationType.Make => "fas fa-cogs",
            IntegrationType.n8n => "fas fa-project-diagram",
            IntegrationType.Pabbly => "fas fa-link",
            IntegrationType.GoogleAnalytics4 => "fab fa-google",
            IntegrationType.FacebookPixel => "fab fa-facebook",
            IntegrationType.GoogleTagManager => "fas fa-tags",
            IntegrationType.MicrosoftClarity => "fab fa-microsoft",
            IntegrationType.Hotjar => "fas fa-fire",
            IntegrationType.Mixpanel => "fas fa-chart-pie",
            IntegrationType.Segment => "fas fa-random",
            IntegrationType.Slack => "fab fa-slack",
            IntegrationType.Discord => "fab fa-discord",
            IntegrationType.MicrosoftTeams => "fab fa-microsoft",
            IntegrationType.Twilio => "fas fa-sms",
            IntegrationType.Shopify => "fab fa-shopify",
            IntegrationType.WooCommerce => "fab fa-wordpress",
            IntegrationType.Webhook => "fas fa-code",
            IntegrationType.CustomAPI => "fas fa-plug",
            _ => "fas fa-puzzle-piece"
        };
    }
    
    string GetCategoryColor(IntegrationCategory category)
    {
        return category switch
        {
            IntegrationCategory.EmailMarketing => "blue",
            IntegrationCategory.CRM => "purple",
            IntegrationCategory.Automation => "orange",
            IntegrationCategory.Analytics => "green",
            IntegrationCategory.Communication => "pink",
            IntegrationCategory.eCommerce => "teal",
            IntegrationCategory.Custom => "gray",
            _ => "gray"
        };
    }
    
    string GetCategoryGradient(IntegrationCategory category)
    {
        return category switch
        {
            IntegrationCategory.EmailMarketing => "from-blue-500 to-blue-700",
            IntegrationCategory.CRM => "from-purple-500 to-purple-700",
            IntegrationCategory.Automation => "from-orange-500 to-orange-700",
            IntegrationCategory.Analytics => "from-green-500 to-green-700",
            IntegrationCategory.Communication => "from-pink-500 to-pink-700",
            IntegrationCategory.eCommerce => "from-teal-500 to-teal-700",
            IntegrationCategory.Custom => "from-gray-500 to-gray-700",
            _ => "from-gray-500 to-gray-700"
        };
    }
}

<style>
    .integration-card {
        transition: all 0.3s ease;
    }
    .integration-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }
    .category-tab {
        transition: all 0.2s ease;
    }
    .category-tab.active {
        border-bottom: 3px solid #6366f1;
        color: #4f46e5;
        font-weight: 600;
    }
    .status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        animation: pulse 2s infinite;
    }
    .status-dot.connected {
        background: #10b981;
    }
    .status-dot.disconnected {
        background: #ef4444;
    }
    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }
</style>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl p-4 shadow-lg">
                    <i class="fas fa-plug text-white text-3xl"></i>
                </div>
                <div>
                    <h1 class="text-4xl font-bold text-gray-900">Integrations</h1>
                    <p class="text-gray-600 mt-1">Connect your favorite tools and automate workflows</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-2 px-4 py-2 bg-green-100 text-green-800 rounded-full text-sm font-medium">
                    <span class="status-dot connected"></span>
                    @Model.ConnectedIntegrations.Count(i => i.IsConnected) Connected
                </span>
            </div>
        </div>
    </div>

    <!-- Website URL Configuration -->
    <div class="mb-10">
        <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl border-2 border-blue-200 p-6 shadow-md">
            <div class="flex items-start gap-4">
                <div class="bg-gradient-to-br from-blue-500 to-indigo-600 rounded-xl p-3 shadow-lg">
                    <i class="fas fa-globe text-white text-2xl"></i>
                </div>
                <div class="flex-1">
                    <h2 class="text-xl font-bold text-gray-900 mb-2">Your Website</h2>
                    <p class="text-gray-600 text-sm mb-4">Configure your website URL to enable live testing and preview features</p>
                    <form id="websiteUrlForm" class="flex gap-3">
                        @Html.AntiForgeryToken()
                        <div class="flex-1">
                            <input type="url" 
                                   id="websiteUrl" 
                                   name="websiteUrl" 
                                   value="@ViewBag.WebsiteUrl" 
                                   placeholder="https://yourwebsite.com" 
                                   class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all"
                                   required />
                        </div>
                        <button type="submit" 
                                class="px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-xl hover:from-blue-700 hover:to-indigo-700 transition-all shadow-lg hover:shadow-xl">
                            <i class="fas fa-save mr-2"></i>Save URL
                        </button>
                    </form>
                    <p class="text-xs text-gray-500 mt-2">
                        <i class="fas fa-info-circle mr-1"></i>This URL will be used for live popup previews and testing
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Pixel Tracking & Testing -->
    <div class="mb-10">
        <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-2xl border-2 border-purple-200 p-6 shadow-md">
            <div class="flex items-start gap-4">
                <div class="bg-gradient-to-br from-purple-500 to-pink-600 rounded-xl p-3 shadow-lg">
                    <i class="fas fa-code text-white text-2xl"></i>
                </div>
                <div class="flex-1">
                    <h2 class="text-xl font-bold text-gray-900 mb-2">Universal Tracking Pixel</h2>
                    <p class="text-gray-600 text-sm mb-2">Install this script once to enable popups, forms, landing pages, and CRM tracking across all your websites</p>
                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-3 mb-4">
                        <div class="flex items-start gap-2">
                            <i class="fas fa-magic text-blue-600 mt-1"></i>
                            <div class="text-sm text-blue-800">
                                <strong>One pixel does it all:</strong> This single script tracks popup views & conversions, form submissions, page visits, and lead behavior. Install once, works everywhere.
                            </div>
                        </div>
                    </div>
                    
                    <!-- Pixel Script Display -->
                    <div class="bg-gray-900 rounded-lg p-4 mb-4 overflow-x-auto">
                        <code class="text-green-400 text-sm font-mono" id="pixelScriptCode">&lt;script src="@ViewBag.AppUrl/js/pixel.js?key=@ViewBag.TenantKey" async&gt;&lt;/script&gt;</code>
                    </div>
                    
                    <div class="flex gap-3 mb-4">
                        <button type="button" onclick="copyPixelScript()" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors">
                            <i class="fas fa-copy me-2"></i>Copy Script
                        </button>
                        <button type="button" class="px-4 py-2 bg-pink-600 text-white rounded-lg hover:bg-pink-700 transition-colors" data-bs-toggle="collapse" data-bs-target="#gtmInstructions">
                            <i class="fab fa-google me-2"></i>GTM Instructions
                        </button>
                        <button type="button" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors" data-bs-toggle="collapse" data-bs-target="#pixelFeatures">
                            <i class="fas fa-list me-2"></i>What It Tracks
                        </button>
                    </div>
                    
                    <!-- What Pixel Tracks (Collapsed) -->
                    <div class="collapse" id="pixelFeatures">
                        <div class="bg-white rounded-lg p-4 border border-purple-200 mb-4">
                            <h4 class="font-bold text-gray-900 mb-3"><i class="fas fa-check-circle text-green-600 me-2"></i>Automatic Tracking Features</h4>
                            <div class="grid grid-cols-2 gap-3">
                                <div class="text-sm">
                                    <div class="font-semibold text-gray-900 mb-1">✅ Popups</div>
                                    <ul class="text-gray-600 text-xs space-y-1 ml-4">
                                        <li>• Views & impressions</li>
                                        <li>• Button clicks</li>
                                        <li>• Conversions & leads</li>
                                        <li>• Close/dismiss events</li>
                                    </ul>
                                </div>
                                <div class="text-sm">
                                    <div class="font-semibold text-gray-900 mb-1">✅ Forms</div>
                                    <ul class="text-gray-600 text-xs space-y-1 ml-4">
                                        <li>• Form views</li>
                                        <li>• Submissions</li>
                                        <li>• Field interactions</li>
                                        <li>• Abandonment tracking</li>
                                    </ul>
                                </div>
                                <div class="text-sm">
                                    <div class="font-semibold text-gray-900 mb-1">✅ Landing Pages</div>
                                    <ul class="text-gray-600 text-xs space-y-1 ml-4">
                                        <li>• Page visits</li>
                                        <li>• Time on page</li>
                                        <li>• Scroll depth</li>
                                        <li>• Exit intent</li>
                                    </ul>
                                </div>
                                <div class="text-sm">
                                    <div class="font-semibold text-gray-900 mb-1">✅ CRM & Leads</div>
                                    <ul class="text-gray-600 text-xs space-y-1 ml-4">
                                        <li>• Lead identification</li>
                                        <li>• Activity timeline</li>
                                        <li>• Behavior scoring</li>
                                        <li>• Session tracking</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- GTM Instructions (Collapsed) -->
                    <div class="collapse" id="gtmInstructions">
                        <div class="bg-white rounded-lg p-4 border border-purple-200 mb-4">
                            <h4 class="font-bold text-gray-900 mb-2"><i class="fab fa-google me-2"></i>Google Tag Manager Setup</h4>
                            <ol class="list-decimal list-inside space-y-2 text-sm text-gray-700">
                                <li>Log in to Google Tag Manager</li>
                                <li>Create a new tag: <strong>Custom HTML</strong></li>
                                <li>Paste the pixel script above</li>
                                <li>Set trigger to: <strong>All Pages</strong></li>
                                <li>Save and publish your container</li>
                            </ol>
                        </div>
                    </div>
                    
                    <!-- Pixel Testing -->
                    <div class="bg-white rounded-lg p-4 border border-purple-200">
                        <h4 class="font-bold text-gray-900 mb-3">
                            <i class="fas fa-flask me-2"></i>Test Pixel Installation
                        </h4>
                        <p class="text-sm text-gray-600 mb-3">Enter a website URL to verify the tracking pixel is properly installed</p>
                        
                        <div class="flex gap-3 mb-3">
                            <input type="url" 
                                   id="testPixelUrl" 
                                   placeholder="https://yourwebsite.com" 
                                   class="flex-1 px-4 py-2 border-2 border-gray-200 rounded-lg focus:border-purple-500 focus:ring-2 focus:ring-purple-200 outline-none" />
                            <button type="button" onclick="testPixelInstallation()" class="px-6 py-2 bg-gradient-to-r from-purple-600 to-pink-600 text-white font-semibold rounded-lg hover:from-purple-700 hover:to-pink-700 transition-all">
                                <i class="fas fa-search me-2"></i>Test
                            </button>
                        </div>
                        
                        <div id="pixelTestLoading" class="d-none text-center py-3">
                            <div class="spinner-border spinner-border-sm text-purple-600 me-2" role="status"></div>
                            <span class="text-sm text-gray-600">Testing pixel installation...</span>
                        </div>
                        
                        <div id="pixelTestResults" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Allowed Websites Management -->
    <div class="mb-10">
        <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h2 class="text-xl font-bold text-gray-900">Allowed Websites</h2>
                    <p class="text-sm text-gray-600 mt-1">Manage which websites can use your popups and tracking pixels</p>
                    <p class="text-xs text-blue-600 mt-1">
                        <i class="fas fa-info-circle mr-1"></i>Your plan allows <strong>@ViewBag.MaxWebsites</strong> website(s) - Currently using: <strong id="websiteCount">@ViewBag.CurrentWebsiteCount</strong>
                    </p>
                </div>
                <button type="button" 
                        id="addWebsiteBtn"
                        class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors flex items-center gap-2">
                    <i class="fas fa-plus"></i>
                    Add Website
                </button>
            </div>

            <!-- Websites List -->
            <div id="websitesList" class="space-y-3">
                <!-- Populated by JavaScript -->
            </div>
        </div>
    </div>

    <!-- Google Analytics Configuration -->
    <div class="mb-10">
        <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
            <div class="flex items-start gap-4 mb-6">
                <div class="bg-gradient-to-br from-orange-500 to-red-600 rounded-xl p-3 shadow-lg">
                    <i class="fab fa-google text-white text-2xl"></i>
                </div>
                <div class="flex-1">
                    <h2 class="text-xl font-bold text-gray-900">Google Analytics & Tag Manager</h2>
                    <p class="text-sm text-gray-600 mt-1">Configure account-wide tracking for all your popups, forms, and landing pages</p>
                </div>
            </div>

            <form id="analyticsForm" class="space-y-4">
                @Html.AntiForgeryToken()
                <div>
                    <label for="gtmId" class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-tags mr-1"></i>Google Tag Manager ID
                    </label>
                    <input type="text" 
                           id="gtmId" 
                           name="gtmId" 
                           value="@ViewBag.GTM" 
                           placeholder="GTM-XXXXXXX" 
                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none transition-all"
                           pattern="GTM-[A-Z0-9]+" />
                    <p class="text-xs text-gray-500 mt-1">
                        <i class="fas fa-info-circle mr-1"></i>Format: GTM-XXXXXXX - <a href="https://tagmanager.google.com" target="_blank" class="text-blue-600 hover:underline">Get your GTM ID</a>
                    </p>
                </div>

                <div>
                    <label for="ga4Id" class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-chart-line mr-1"></i>Google Analytics 4 ID
                    </label>
                    <input type="text" 
                           id="ga4Id" 
                           name="ga4Id" 
                           value="@ViewBag.GA4" 
                           placeholder="G-XXXXXXXXXX" 
                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none transition-all"
                           pattern="G-[A-Z0-9]+" />
                    <p class="text-xs text-gray-500 mt-1">
                        <i class="fas fa-info-circle mr-1"></i>Format: G-XXXXXXXXXX - <a href="https://analytics.google.com" target="_blank" class="text-blue-600 hover:underline">Get your GA4 ID</a>
                    </p>
                </div>

                <div class="flex items-start gap-3 p-4 bg-blue-50 border border-blue-200 rounded-lg">
                    <i class="fas fa-lightbulb text-blue-600 text-lg mt-1"></i>
                    <div class="text-sm text-blue-900">
                        <strong>Automatic Tracking:</strong> Once configured, these tracking codes will be automatically injected into all your popups, forms, landing pages, and embedded content.
                    </div>
                </div>

                <button type="submit" 
                        class="px-6 py-3 bg-gradient-to-r from-orange-600 to-red-600 text-white font-semibold rounded-xl hover:from-orange-700 hover:to-red-700 transition-all shadow-lg hover:shadow-xl">
                    <i class="fas fa-save mr-2"></i>Save Analytics Configuration
                </button>
            </form>
        </div>
    </div>

    <!-- Connected Integrations -->
    @if (Model.ConnectedIntegrations.Any())
    {
        <div class="mb-10">
            <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                <i class="fas fa-check-circle text-green-500"></i>
                Your Connected Integrations
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var integration in Model.ConnectedIntegrations)
                {
                    var color = GetCategoryColor(integration.Category);
                    <div class="integration-card bg-white rounded-xl border-2 border-gray-100 p-5 shadow-md">
                        <div class="flex items-start justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 rounded-xl bg-gradient-to-br @GetCategoryGradient(integration.Category) flex items-center justify-center shadow">
                                    <i class="@GetIntegrationIcon(integration.Type) text-white text-xl"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-gray-900">@integration.Name</h3>
                                    <div class="flex items-center gap-2 mt-1">
                                        @if (integration.IsConnected)
                                        {
                                            <span class="inline-flex items-center gap-1 text-xs text-green-600 bg-green-50 px-2 py-0.5 rounded-full">
                                                <i class="fas fa-check-circle"></i> Connected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 text-xs text-yellow-600 bg-yellow-50 px-2 py-0.5 rounded-full">
                                                <i class="fas fa-exclamation-triangle"></i> Pending
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between">
                            <div class="text-xs text-gray-500">
                                @if (integration.LastSyncAt.HasValue)
                                {
                                    <span>Last sync: @integration.LastSyncAt.Value.ToString("MMM d, h:mm tt")</span>
                                }
                                else
                                {
                                    <span>Syncs: @integration.SyncCount</span>
                                }
                            </div>
                            <div class="flex items-center gap-2">
                                <a asp-action="Configure" asp-route-type="@integration.Type" 
                                   class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">
                                    <i class="fas fa-cog"></i> Settings
                                </a>
                                <form asp-action="Disconnect" asp-route-id="@integration.Id" method="post" class="inline"
                                      onsubmit="return confirm('Are you sure you want to disconnect this integration?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-red-600 hover:text-red-800 text-sm font-medium">
                                        <i class="fas fa-unlink"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Category Tabs -->
    <div class="mb-6 border-b border-gray-200">
        <nav class="flex space-x-8 overflow-x-auto" aria-label="Tabs">
            <button onclick="showCategory('all')" class="category-tab active px-1 py-4 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="all">
                <i class="fas fa-th-large me-2"></i>All Integrations
            </button>
            <button onclick="showCategory('email')" class="category-tab px-1 py-4 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="email">
                <i class="fas fa-envelope me-2"></i>Email Marketing
            </button>
            <button onclick="showCategory('crm')" class="category-tab px-1 py-4 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="crm">
                <i class="fas fa-address-book me-2"></i>CRM
            </button>
            <button onclick="showCategory('automation')" class="category-tab px-1 py-4 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="automation">
                <i class="fas fa-bolt me-2"></i>Automation
            </button>
            <button onclick="showCategory('analytics')" class="category-tab px-1 py-4 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="analytics">
                <i class="fas fa-chart-bar me-2"></i>Analytics
            </button>
            <button onclick="showCategory('communication')" class="category-tab px-1 py-4 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="communication">
                <i class="fas fa-comments me-2"></i>Communication
            </button>
            <button onclick="showCategory('ecommerce')" class="category-tab px-1 py-4 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="ecommerce">
                <i class="fas fa-shopping-cart me-2"></i>eCommerce
            </button>
        </nav>
    </div>

    <!-- Email Marketing Section -->
    <div class="category-section" data-category="email">
        <div class="mb-6 flex items-center gap-3">
            <div class="bg-blue-100 rounded-xl p-3">
                <i class="fas fa-envelope text-blue-600 text-xl"></i>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-gray-900">Email Marketing</h2>
                <p class="text-gray-600 text-sm">Sync leads with your email marketing platforms</p>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 mb-10">
            @foreach (var integration in Model.AvailableEmailIntegrations)
            {
                var isConnected = Model.ConnectedIntegrations.Any(c => c.Type == integration.Type && c.IsConnected);
                <div class="integration-card bg-white rounded-xl border border-gray-200 p-5 hover:border-blue-300">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center shadow">
                            <i class="@GetIntegrationIcon(integration.Type) text-white text-xl"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-gray-900 truncate">@integration.Name</h3>
                            @if (isConnected)
                            {
                                <span class="inline-flex items-center gap-1 text-xs text-green-600">
                                    <i class="fas fa-check-circle"></i> Connected
                                </span>
                            }
                        </div>
                    </div>
                    <p class="text-sm text-gray-600 mb-4 line-clamp-2">@integration.Description</p>
                    <a asp-action="Configure" asp-route-type="@integration.Type"
