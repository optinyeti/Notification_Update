@{
    ViewData["Title"] = "Integrations";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center gap-4 mb-3">
            <div class="bg-gradient-to-br from-blue-500 to-purple-600 rounded-2xl p-4 shadow-lg">
                <i class="fas fa-plug text-white text-3xl"></i>
            </div>
            <div>
                <h1 class="text-4xl font-bold text-gray-900">Integrations</h1>
                <p class="text-gray-600 mt-1">Connect your favorite tools and automate workflows</p>
            </div>
        </div>
    </div>

    <!-- Integration Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <!-- Email Service Card -->
        <div class="bg-white border-2 border-gray-200 rounded-2xl p-6 hover:shadow-xl hover:border-blue-300 transition-all duration-200">
            <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-16 h-16 bg-gradient-to-br from-blue-400 to-blue-600 rounded-xl flex items-center justify-center shadow-lg">
                    <i class="fas fa-envelope text-white text-2xl"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="text-lg font-bold text-gray-900 mb-2">Email Service</h3>
                    <p class="text-sm text-gray-600 mb-4" id="emailStatus">Connect to send captured emails</p>
                    <button onclick="openEmailModal()" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold transition-all duration-200 shadow-md hover:shadow-lg">
                        <i class="fas fa-cog"></i>Configure
                    </button>
                </div>
            </div>
        </div>

        <!-- Zapier Card -->
        <div class="bg-white border-2 border-gray-200 rounded-2xl p-6 hover:shadow-xl hover:border-orange-300 transition-all duration-200">
            <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-16 h-16 bg-gradient-to-br from-orange-400 to-orange-600 rounded-xl flex items-center justify-center shadow-lg">
                    <i class="fas fa-bolt text-white text-2xl"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="text-lg font-bold text-gray-900 mb-2">Zapier</h3>
                    <p class="text-sm text-gray-600 mb-4" id="zapierStatus">Automate workflows with 5000+ apps</p>
                    <button onclick="openZapierModal()" class="inline-flex items-center gap-2 px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white rounded-lg text-sm font-semibold transition-all duration-200 shadow-md hover:shadow-lg">
                        <i class="fas fa-cog"></i>Configure
                    </button>
                </div>
            </div>
        </div>

        <!-- Webhook Card -->
        <div class="bg-white border-2 border-gray-200 rounded-2xl p-6 hover:shadow-xl hover:border-purple-300 transition-all duration-200">
            <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-16 h-16 bg-gradient-to-br from-purple-400 to-purple-600 rounded-xl flex items-center justify-center shadow-lg">
                    <i class="fas fa-code text-white text-2xl"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="text-lg font-bold text-gray-900 mb-2">Webhook</h3>
                    <p class="text-sm text-gray-600 mb-4" id="webhookStatus">Send data to custom endpoint</p>
                    <button onclick="openWebhookModal()" class="inline-flex items-center gap-2 px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-sm font-semibold transition-all duration-200 shadow-md hover:shadow-lg">
                        <i class="fas fa-cog"></i>Configure
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Integration Info Section -->
    <div class="bg-gradient-to-r from-blue-50 to-purple-50 border border-blue-200 rounded-2xl p-8">
        <div class="flex items-start gap-4">
            <div class="flex-shrink-0">
                <i class="fas fa-info-circle text-blue-600 text-3xl"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-xl font-bold text-gray-900 mb-3">How Integrations Work</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <div class="bg-white rounded-lg p-4 shadow-sm">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="bg-blue-100 rounded-lg p-2">
                                    <i class="fas fa-envelope text-blue-600"></i>
                                </div>
                                <h4 class="font-semibold text-gray-900">Email Service</h4>
                            </div>
                            <p class="text-sm text-gray-600">Automatically add captured emails to your preferred email marketing platform like Mailchimp or SendinBlue.</p>
                        </div>
                    </div>
                    <div>
                        <div class="bg-white rounded-lg p-4 shadow-sm">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="bg-orange-100 rounded-lg p-2">
                                    <i class="fas fa-bolt text-orange-600"></i>
                                </div>
                                <h4 class="font-semibold text-gray-900">Zapier</h4>
                            </div>
                            <p class="text-sm text-gray-600">Connect to thousands of apps. Trigger workflows when users submit forms, view popups, or take actions.</p>
                        </div>
                    </div>
                    <div>
                        <div class="bg-white rounded-lg p-4 shadow-sm">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="bg-purple-100 rounded-lg p-2">
                                    <i class="fas fa-code text-purple-600"></i>
                                </div>
                                <h4 class="font-semibold text-gray-900">Webhook</h4>
                            </div>
                            <p class="text-sm text-gray-600">Send real-time data to your own server or API endpoint. Perfect for custom integrations and workflows.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Email Service Modal -->
<div class="modal fade" id="emailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-2xl">
            <div class="modal-header bg-gradient-to-r from-blue-600 to-blue-700 text-white border-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-envelope me-2"></i>Email Service Configuration</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email Provider</label>
                    <select class="form-select" id="emailProvider">
                        <option value="">Select Provider</option>
                        <option value="mailchimp">Mailchimp</option>
                        <option value="sendinblue">SendinBlue</option>
                        <option value="mailerlite">MailerLite</option>
                        <option value="convertkit">ConvertKit</option>
                        <option value="custom">Custom SMTP</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">API Key</label>
                    <input type="password" class="form-control" id="emailApiKey" placeholder="Enter your API key">
                    <small class="text-muted">Your API key will be encrypted and stored securely</small>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">List/Audience ID</label>
                    <input type="text" class="form-control" id="emailListId" placeholder="Enter list ID">
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="emailDoubleOptIn">
                    <label class="form-check-label" for="emailDoubleOptIn">Enable double opt-in</label>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveEmailConfig()">
                    <i class="fas fa-save me-1"></i>Save Configuration
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Zapier Modal -->
<div class="modal fade" id="zapierModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-2xl">
            <div class="modal-header bg-gradient-to-r from-orange-600 to-orange-700 text-white border-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-bolt me-2"></i>Zapier Integration</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info d-flex align-items-start">
                    <i class="fas fa-info-circle me-2 mt-1"></i>
                    <div>
                        <strong>Connect to 5,000+ apps</strong><br>
                        <small>Use Zapier to connect this popup to thousands of apps like Google Sheets, Slack, and more.</small>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Zapier Webhook URL <span class="text-danger">*</span></label>
                    <input type="url" class="form-control" id="zapierWebhook" placeholder="https://hooks.zapier.com/hooks/catch/...">
                    <small class="text-muted">Get this URL from your Zapier account</small>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Trigger Event</label>
                    <select class="form-select" id="zapierEvent">
                        <option value="submission">Form Submission</option>
                        <option value="view">Popup View</option>
                        <option value="click">Button Click</option>
                        <option value="close">Popup Close</option>
                    </select>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="zapierEnabled" checked>
                    <label class="form-check-label" for="zapierEnabled">Enable Zapier integration</label>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveZapierConfig()">
                    <i class="fas fa-save me-1"></i>Save Configuration
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Webhook Modal -->
<div class="modal fade" id="webhookModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-2xl">
            <div class="modal-header bg-gradient-to-r from-purple-600 to-purple-700 text-white border-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-code me-2"></i>Webhook Configuration</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Webhook URL <span class="text-danger">*</span></label>
                    <input type="url" class="form-control" id="webhookUrl" placeholder="https://your-server.com/webhook" required>
                    <small class="text-muted">POST requests will be sent to this URL when events occur</small>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">HTTP Method</label>
                    <select class="form-select" id="webhookMethod">
                        <option value="POST">POST</option>
                        <option value="PUT">PUT</option>
                        <option value="PATCH">PATCH</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Custom Headers (JSON)</label>
                    <textarea class="form-control font-monospace" id="webhookHeaders" rows="3" placeholder='{"Authorization": "Bearer YOUR_TOKEN"}'></textarea>
                    <small class="text-muted">Optional: Add custom headers for authentication</small>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Trigger Event</label>
                    <select class="form-select" id="webhookEvent">
                        <option value="submission">Form Submission</option>
                        <option value="view">Popup View</option>
                        <option value="click">Button Click</option>
                        <option value="conversion">Conversion</option>
                    </select>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="webhookRetry" checked>
                    <label class="form-check-label" for="webhookRetry">Retry on failure (up to 3 times)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="webhookEnabled" checked>
                    <label class="form-check-label" for="webhookEnabled">Enable webhook</label>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-outline-secondary" onclick="testWebhook()">
                    <i class="fas fa-play-circle me-1"></i>Test Webhook
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveWebhookConfig()">
                    <i class="fas fa-save me-1"></i>Save Configuration
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Integration configurations storage
    let integrationConfigs = {
        email: null,
        zapier: null,
        webhook: null
    };

    // Load saved configurations from localStorage
    function loadIntegrationConfigs() {
        const saved = localStorage.getItem('integrationConfigs');
        if (saved) {
            try {
                integrationConfigs = JSON.parse(saved);
                updateIntegrationStatus();
            } catch (e) {
                console.error('Error loading integration configs:', e);
            }
        }
    }

    // Save configurations to localStorage
    function saveIntegrationConfigs() {
        localStorage.setItem('integrationConfigs', JSON.stringify(integrationConfigs));
    }

    // Email Modal Functions
    function openEmailModal() {
        new bootstrap.Modal(document.getElementById('emailModal')).show();
        if (integrationConfigs.email) {
            document.getElementById('emailProvider').value = integrationConfigs.email.provider || '';
            document.getElementById('emailApiKey').value = integrationConfigs.email.apiKey || '';
            document.getElementById('emailListId').value = integrationConfigs.email.listId || '';
            document.getElementById('emailDoubleOptIn').checked = integrationConfigs.email.doubleOptIn || false;
        }
    }

    function saveEmailConfig() {
        const provider = document.getElementById('emailProvider').value;
        const apiKey = document.getElementById('emailApiKey').value;
        const listId = document.getElementById('emailListId').value;

        if (!provider || !apiKey || !listId) {
            alert('Please fill in all required fields');
            return;
        }

        integrationConfigs.email = {
            provider: provider,
            apiKey: apiKey,
            listId: listId,
            doubleOptIn: document.getElementById('emailDoubleOptIn').checked,
            enabled: true,
            configuredAt: new Date().toISOString()
        };
        
        saveIntegrationConfigs();
        bootstrap.Modal.getInstance(document.getElementById('emailModal')).hide();
        updateIntegrationStatus();
        
        // Show success message
        showSuccessToast('Email service configured successfully!');
    }

    // Zapier Modal Functions
    function openZapierModal() {
        new bootstrap.Modal(document.getElementById('zapierModal')).show();
        if (integrationConfigs.zapier) {
            document.getElementById('zapierWebhook').value = integrationConfigs.zapier.webhookUrl || '';
            document.getElementById('zapierEvent').value = integrationConfigs.zapier.event || 'submission';
            document.getElementById('zapierEnabled').checked = integrationConfigs.zapier.enabled !== false;
        }
    }

    function saveZapierConfig() {
        const webhook = document.getElementById('zapierWebhook').value;
        
        if (!webhook) {
            alert('Please enter a Zapier webhook URL');
            return;
        }

        integrationConfigs.zapier = {
            webhookUrl: webhook,
            event: document.getElementById('zapierEvent').value,
            enabled: document.getElementById('zapierEnabled').checked,
            configuredAt: new Date().toISOString()
        };
        
        saveIntegrationConfigs();
        bootstrap.Modal.getInstance(document.getElementById('zapierModal')).hide();
        updateIntegrationStatus();
        
        showSuccessToast('Zapier integration configured successfully!');
    }

    // Webhook Modal Functions
    function openWebhookModal() {
        new bootstrap.Modal(document.getElementById('webhookModal')).show();
        if (integrationConfigs.webhook) {
            document.getElementById('webhookUrl').value = integrationConfigs.webhook.url || '';
            document.getElementById('webhookMethod').value = integrationConfigs.webhook.method || 'POST';
            document.getElementById('webhookHeaders').value = integrationConfigs.webhook.headers || '';
            document.getElementById('webhookEvent').value = integrationConfigs.webhook.event || 'submission';
            document.getElementById('webhookRetry').checked = integrationConfigs.webhook.retry !== false;
            document.getElementById('webhookEnabled').checked = integrationConfigs.webhook.enabled !== false;
        }
    }

    function saveWebhookConfig() {
        const url = document.getElementById('webhookUrl').value;
        
        if (!url) {
            alert('Please enter a webhook URL');
            return;
        }

        // Validate headers if provided
        const headers = document.getElementById('webhookHeaders').value;
        if (headers) {
            try {
                JSON.parse(headers);
            } catch (e) {
                alert('Invalid JSON in custom headers. Please check the format.');
                return;
            }
        }

        integrationConfigs.webhook = {
            url: url,
            method: document.getElementById('webhookMethod').value,
            headers: headers,
            event: document.getElementById('webhookEvent').value,
            retry: document.getElementById('webhookRetry').checked,
            enabled: document.getElementById('webhookEnabled').checked,
            configuredAt: new Date().toISOString()
        };
        
        saveIntegrationConfigs();
        bootstrap.Modal.getInstance(document.getElementById('webhookModal')).hide();
        updateIntegrationStatus();
        
        showSuccessToast('Webhook configured successfully!');
    }

    function testWebhook() {
        const url = document.getElementById('webhookUrl').value;
        
        if (!url) {
            alert('Please enter a webhook URL first');
            return;
        }

        // Create test payload
        const testPayload = {
            test: true,
            event: 'test',
            timestamp: new Date().toISOString(),
            data: {
                message: 'This is a test webhook from Popup Manager Pro'
            }
        };

        // Show loading state
        const btn = event.target;
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Sending...';

        // Send test request
        fetch(url, {
            method: document.getElementById('webhookMethod').value,
            headers: {
                'Content-Type': 'application/json',
                ...(document.getElementById('webhookHeaders').value ? JSON.parse(document.getElementById('webhookHeaders').value) : {})
            },
            body: JSON.stringify(testPayload)
        })
        .then(response => {
            btn.disabled = false;
            btn.innerHTML = originalText;
            if (response.ok) {
                alert('✅ Test webhook sent successfully!\n\nStatus: ' + response.status + '\nCheck your server logs for the incoming request.');
            } else {
                alert('⚠️ Webhook sent but received error response.\n\nStatus: ' + response.status + '\nCheck your server configuration.');
            }
        })
        .catch(error => {
            btn.disabled = false;
            btn.innerHTML = originalText;
            alert('❌ Failed to send test webhook.\n\nError: ' + error.message + '\n\nPlease check the URL and try again.');
        });
    }

    // Update integration status displays
    function updateIntegrationStatus() {
        // Email status
        if (integrationConfigs.email && integrationConfigs.email.enabled) {
            document.getElementById('emailStatus').innerHTML = 
                '<i class="fas fa-check-circle text-success me-1"></i>Connected to ' + 
                integrationConfigs.email.provider.charAt(0).toUpperCase() + integrationConfigs.email.provider.slice(1);
        } else {
            document.getElementById('emailStatus').textContent = 'Connect to send captured emails';
        }

        // Zapier status
        if (integrationConfigs.zapier && integrationConfigs.zapier.enabled) {
            document.getElementById('zapierStatus').innerHTML = 
                '<i class="fas fa-check-circle text-success me-1"></i>Active - Workflows enabled';
        } else {
            document.getElementById('zapierStatus').textContent = 'Automate workflows with 5000+ apps';
        }

        // Webhook status
        if (integrationConfigs.webhook && integrationConfigs.webhook.enabled) {
            document.getElementById('webhookStatus').innerHTML = 
                '<i class="fas fa-check-circle text-success me-1"></i>Configured and active';
        } else {
            document.getElementById('webhookStatus').textContent = 'Send data to custom endpoint';
        }
    }

    // Success toast notification
    function showSuccessToast(message) {
        // Create toast element
        const toastHtml = `
            <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11000">
                <div class="toast align-items-center text-white bg-success border-0 show" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="fas fa-check-circle me-2"></i>${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            </div>
        `;
        
        // Add to page
        const div = document.createElement('div');
        div.innerHTML = toastHtml;
        document.body.appendChild(div);
        
        // Auto remove after 3 seconds
        setTimeout(() => {
            div.remove();
        }, 3000);
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadIntegrationConfigs();
    });
</script>
}
