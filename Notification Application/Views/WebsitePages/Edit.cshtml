@model WebsitePage
@{
    ViewData["Title"] = "Edit Page";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3"><i class="bi bi-pencil me-2"></i>Edit Page</h1>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to List
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Page Title</label>
                            <input asp-for="Title" class="form-control" placeholder="e.g., About Us" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Page URL Slug</label>
                            <div class="input-group">
                                <span class="input-group-text">/</span>
                                <input type="text" class="form-control" value="@Model.Slug" readonly />
                            </div>
                            <small class="form-text text-muted">The URL slug is generated from the title and cannot be changed</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MetaDescription" class="form-label fw-bold">Meta Description</label>
                            <textarea asp-for="MetaDescription" class="form-control" rows="2" placeholder="Brief description for search engines (150-160 characters recommended)"></textarea>
                            <span asp-validation-for="MetaDescription" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MetaKeywords" class="form-label fw-bold">Meta Keywords</label>
                            <input asp-for="MetaKeywords" class="form-control" placeholder="marketing, automation, growth" />
                            <span asp-validation-for="MetaKeywords" class="text-danger"></span>
                            <small class="form-text text-muted">Comma-separated keywords for SEO</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label fw-bold">Page Content</label>
                            <textarea asp-for="Content" class="form-control" rows="15" placeholder="Enter HTML content or use a rich text editor..."></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                            <small class="form-text text-muted">HTML content for your page. You can use Tailwind CSS classes for styling.</small>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input asp-for="IsPublished" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsPublished" class="form-check-label fw-bold">
                                        Publish Page
                                    </label>
                                    <br />
                                    <small class="form-text text-muted">Make this page visible to the public</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input asp-for="IsHomepage" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsHomepage" class="form-check-label fw-bold">
                                        Set as Homepage
                                    </label>
                                    <br />
                                    <small class="form-text text-muted">This will be the default landing page</small>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted">Created</label>
                                <p class="form-control-plaintext">@Model.CreatedAt.ToString("MMMM dd, yyyy 'at' h:mm tt")</p>
                            </div>
                            @if (Model.UpdatedAt.HasValue)
                            {
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-muted">Last Updated</label>
                                    <p class="form-control-plaintext">@Model.UpdatedAt.Value.ToString("MMMM dd, yyyy 'at' h:mm tt")</p>
                                </div>
                            }
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
