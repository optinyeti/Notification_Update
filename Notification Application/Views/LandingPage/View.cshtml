@model Notification_Application.Models.LandingPage
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.MetaTitle</title>
    
    @if (!string.IsNullOrEmpty(Model.MetaDescription))
    {
        <meta name="description" content="@Model.MetaDescription">
    }
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="@Model.MetaTitle">
    @if (!string.IsNullOrEmpty(Model.MetaDescription))
    {
        <meta property="og:description" content="@Model.MetaDescription">
    }
    @if (!string.IsNullOrEmpty(Model.OgImageUrl))
    {
        <meta property="og:image" content="@Model.OgImageUrl">
    }
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:title" content="@Model.MetaTitle">
    @if (!string.IsNullOrEmpty(Model.MetaDescription))
    {
        <meta property="twitter:description" content="@Model.MetaDescription">
    }
    @if (!string.IsNullOrEmpty(Model.OgImageUrl))
    {
        <meta property="twitter:image" content="@Model.OgImageUrl">
    }

    <style>
        @Model.CssContent
    </style>

    @{
        var tenant = ViewBag.Tenant as Notification_Application.Models.Tenant;
        if (tenant != null)
        {
            @:<!-- Google Tag Manager -->
            if (!string.IsNullOrEmpty(tenant.GoogleTagManagerId))
            {
                <script>
                    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
                    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
                    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
                    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
                    })(window,document,'script','dataLayer','@tenant.GoogleTagManagerId');
                </script>
            }

            @:<!-- Google Analytics 4 -->
            if (!string.IsNullOrEmpty(tenant.GoogleAnalytics4Id))
            {
                <script async src="https://www.googletagmanager.com/gtag/js?id=@tenant.GoogleAnalytics4Id"></script>
                <script>
                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);}
                    gtag('js', new Date());
                    gtag('config', '@tenant.GoogleAnalytics4Id');
                </script>
            }
        }
    }
</head>
<body>
    @{
        var tenantData = ViewBag.Tenant as Notification_Application.Models.Tenant;
        if (tenantData != null && !string.IsNullOrEmpty(tenantData.GoogleTagManagerId))
        {
            @:<!-- Google Tag Manager (noscript) -->
            <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=@tenantData.GoogleTagManagerId"
            height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        }
    }

    @Html.Raw(Model.HtmlContent)
</body>
</html>
