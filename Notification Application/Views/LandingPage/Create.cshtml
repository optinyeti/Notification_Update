@{
    ViewData["Title"] = "Create Landing Page";
}

<div class="container mx-auto px-4 py-8 max-w-2xl">
    <div class="mb-6">
        <a href="@Url.Action("Index")" class="text-blue-600 hover:text-blue-700 text-sm font-medium inline-flex items-center">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Back to Landing Pages
        </a>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-6">Create New Landing Page</h1>

        <form id="createForm" method="post" action="@Url.Action("Create")">
            @Html.AntiForgeryToken()

            <div class="space-y-6">
                <div>
                    <label for="title" class="block text-sm font-medium text-gray-700 mb-2">
                        Page Title <span class="text-red-500">*</span>
                    </label>
                    <input type="text" id="title" name="title" required 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                           placeholder="e.g., Summer Sale 2026">
                    <p class="mt-1 text-sm text-gray-500">This will be used as the page title and to generate the URL.</p>
                </div>

                <div>
                    <label for="slug" class="block text-sm font-medium text-gray-700 mb-2">
                        URL Slug
                    </label>
                    <div class="flex items-center">
                        <span class="text-gray-500 text-sm mr-2">/</span>
                        <input type="text" id="slug" name="slug" 
                               class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                               placeholder="Auto-generated from title">
                    </div>
                    <p class="mt-1 text-sm text-gray-500">Leave blank to auto-generate from title. Only lowercase letters, numbers, and hyphens.</p>
                </div>

                <div>
                    <label for="metaDescription" class="block text-sm font-medium text-gray-700 mb-2">
                        Meta Description
                    </label>
                    <textarea id="metaDescription" name="metaDescription" rows="3" 
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                              placeholder="Brief description for search engines (recommended 150-160 characters)"></textarea>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-3">
                        Choose a Starting Template
                    </label>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <label class="cursor-pointer">
                            <input type="radio" name="template" value="blank" checked class="sr-only peer">
                            <div class="border-2 border-gray-300 rounded-lg p-4 peer-checked:border-blue-600 peer-checked:bg-blue-50 hover:border-gray-400 transition-colors">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="font-semibold text-gray-900">Blank Canvas</span>
                                    <svg class="w-5 h-5 text-blue-600 hidden peer-checked:block" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                    </svg>
                                </div>
                                <p class="text-sm text-gray-600">Start with a minimal template and build from scratch.</p>
                            </div>
                        </label>

                        <label class="cursor-pointer opacity-50 cursor-not-allowed">
                            <input type="radio" name="template" value="hero" disabled class="sr-only peer">
                            <div class="border-2 border-gray-300 rounded-lg p-4 bg-gray-50">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="font-semibold text-gray-900">Hero Section</span>
                                    <span class="text-xs text-gray-500">Coming Soon</span>
                                </div>
                                <p class="text-sm text-gray-600">Hero with headline, subheadline, and CTA button.</p>
                            </div>
                        </label>

                        <label class="cursor-pointer opacity-50 cursor-not-allowed">
                            <input type="radio" name="template" value="leadgen" disabled class="sr-only peer">
                            <div class="border-2 border-gray-300 rounded-lg p-4 bg-gray-50">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="font-semibold text-gray-900">Lead Generation</span>
                                    <span class="text-xs text-gray-500">Coming Soon</span>
                                </div>
                                <p class="text-sm text-gray-600">Form-focused page optimized for capturing leads.</p>
                            </div>
                        </label>

                        <label class="cursor-pointer opacity-50 cursor-not-allowed">
                            <input type="radio" name="template" value="thankyou" disabled class="sr-only peer">
                            <div class="border-2 border-gray-300 rounded-lg p-4 bg-gray-50">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="font-semibold text-gray-900">Thank You Page</span>
                                    <span class="text-xs text-gray-500">Coming Soon</span>
                                </div>
                                <p class="text-sm text-gray-600">Confirmation page with next steps and social sharing.</p>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="flex items-center justify-end space-x-4 pt-6 border-t border-gray-200">
                    <a href="@Url.Action("Index")" class="px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">
                        Cancel
                    </a>
                    <button type="submit" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
                        Create Landing Page
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('title').addEventListener('input', function(e) {
            const slugInput = document.getElementById('slug');
            if (!slugInput.value || slugInput.dataset.autoGenerated) {
                const slug = e.target.value
                    .toLowerCase()
                    .replace(/[^a-z0-9\s-]/g, '')
                    .replace(/\s+/g, '-')
                    .replace(/-+/g, '-')
                    .replace(/^-|-$/g, '');
                slugInput.value = slug;
                slugInput.dataset.autoGenerated = 'true';
            }
        });

        document.getElementById('slug').addEventListener('input', function(e) {
            delete this.dataset.autoGenerated;
            this.value = this.value
                .toLowerCase()
                .replace(/[^a-z0-9-]/g, '')
                .replace(/-+/g, '-');
        });
    </script>
}
