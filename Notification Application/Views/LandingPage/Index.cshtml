@model IEnumerable<Notification_Application.Models.LandingPage>
@{
    ViewData["Title"] = "Landing Pages";
    var maxPages = ViewBag.MaxLandingPages as int? ?? 0;
    var currentCount = ViewBag.CurrentCount as int? ?? 0;
    var canCreate = maxPages == -1 || currentCount < maxPages;
}

<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Landing Pages</h1>
            <p class="mt-2 text-sm text-gray-600">
                @if (maxPages == -1)
                {
                    <span>Using @currentCount landing pages (Unlimited)</span>
                }
                else
                {
                    <span>Using @currentCount of @maxPages landing pages</span>
                }
            </p>
        </div>
        <div>
            @if (canCreate)
            {
                <a href="@Url.Action("Create")" class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Create Landing Page
                </a>
            }
            else
            {
                <button disabled class="inline-flex items-center px-4 py-2 bg-gray-300 text-gray-500 font-medium rounded-lg cursor-not-allowed">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                    </svg>
                    Limit Reached - Upgrade Plan
                </button>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <h3 class="mt-2 text-lg font-medium text-gray-900">No landing pages</h3>
            <p class="mt-1 text-sm text-gray-500">Get started by creating your first landing page.</p>
            @if (canCreate)
            {
                <div class="mt-6">
                    <a href="@Url.Action("Create")" class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Create Your First Landing Page
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var lp in Model)
            {
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
                    <div class="p-6">
                        <div class="flex items-start justify-between mb-4">
                            <div class="flex-1">
                                <h3 class="text-lg font-semibold text-gray-900 mb-1">@lp.Name</h3>
                                <p class="text-sm text-gray-500">/@lp.Slug</p>
                            </div>
                            @if (lp.IsPublished)
                            {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    Published
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                    Draft
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(lp.MetaDescription))
                        {
                            <p class="text-sm text-gray-600 mb-4 line-clamp-2">@lp.MetaDescription</p>
                        }

                        <div class="flex items-center text-sm text-gray-500 space-x-4 mb-4">
                            <div class="flex items-center">
                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                </svg>
                                @lp.ViewCount
                            </div>
                            <div class="flex items-center">
                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                @lp.ConversionCount
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(lp.CustomDomain))
                        {
                            <div class="mb-4 p-2 bg-blue-50 rounded text-xs text-blue-700">
                                <svg class="w-3 h-3 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                                </svg>
                                Custom Domain: @lp.CustomDomain
                            </div>
                        }

                        <div class="flex items-center justify-between pt-4 border-t border-gray-200">
                            <a href="@Url.Action("Edit", new { id = lp.Id })" class="text-blue-600 hover:text-blue-700 text-sm font-medium">
                                Edit
                            </a>
                            @if (lp.IsPublished)
                            {
                                <a href="@Url.Action("View", new { slug = lp.Slug })" target="_blank" class="text-gray-600 hover:text-gray-700 text-sm font-medium">
                                    View Live
                                </a>
                            }
                            <button onclick="deletePage('@lp.Id', '@lp.Name')" class="text-red-600 hover:text-red-700 text-sm font-medium">
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function deletePage(id, title) {
            Swal.fire({
                title: 'Delete Landing Page?',
                text: `Are you sure you want to delete "${title}"? This action cannot be undone.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Yes, delete it',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/LandingPage/Delete/${id}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                title: 'Deleted!',
                                text: 'Landing page has been deleted.',
                                icon: 'success',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Error', data.message || 'Failed to delete landing page', 'error');
                        }
                    })
                    .catch(error => {
                        Swal.fire('Error', 'An error occurred while deleting the landing page', 'error');
                    });
                }
            });
        }
    </script>
}
