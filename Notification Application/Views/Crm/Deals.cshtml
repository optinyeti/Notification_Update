@model List<Notification_Application.Models.Deal>
@{
    ViewData["Title"] = "Deals";
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="bi bi-briefcase me-2"></i>Deals
            </h1>
            <p class="text-muted mb-0">Manage your sales opportunities</p>
        </div>
        <div>
            <a href="@Url.Action("Pipeline", "Crm")" class="btn btn-outline-secondary me-2">
                <i class="bi bi-kanban me-1"></i>Pipeline
            </a>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newDealModal">
                <i class="bi bi-plus-lg me-1"></i>New Deal
            </button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small text-uppercase fw-bold">Total Deals</div>
                            <div class="h4 mb-0 fw-bold">@ViewBag.TotalDeals</div>
                        </div>
                        <div class="text-primary">
                            <i class="bi bi-briefcase fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small text-uppercase fw-bold">Open</div>
                            <div class="h4 mb-0 fw-bold">@ViewBag.OpenDeals</div>
                            <small class="text-primary">$@(((decimal)ViewBag.TotalValue).ToString("N0"))</small>
                        </div>
                        <div class="text-warning">
                            <i class="bi bi-hourglass-split fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small text-uppercase fw-bold">Won</div>
                            <div class="h4 mb-0 fw-bold text-success">@ViewBag.WonDeals</div>
                            <small class="text-success">$@(((decimal)ViewBag.WonValue).ToString("N0"))</small>
                        </div>
                        <div class="text-success">
                            <i class="bi bi-trophy fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small text-uppercase fw-bold">Lost</div>
                            <div class="h4 mb-0 fw-bold text-danger">@ViewBag.LostDeals</div>
                        </div>
                        <div class="text-danger">
                            <i class="bi bi-x-circle fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Search</label>
                    <input type="text" class="form-control" name="search" value="@ViewBag.SearchTerm" placeholder="Search deals, leads, companies...">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select class="form-select" name="status">
                        <option value="">All Status</option>
                        <option value="Open" selected="@(ViewBag.StatusFilter == "Open")">Open</option>
                        <option value="Won" selected="@(ViewBag.StatusFilter == "Won")">Won</option>
                        <option value="Lost" selected="@(ViewBag.StatusFilter == "Lost")">Lost</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Deals Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Deal</th>
                                <th>Contact</th>
                                <th>Value</th>
                                <th>Probability</th>
                                <th>Expected Close</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var deal in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@deal.Name</div>
                                        <small class="text-muted">Created @deal.CreatedAt.ToString("MMM d, yyyy")</small>
                                    </td>
                                    <td>
                                        @if (deal.Lead != null)
                                        {
                                            <a href="@Url.Action("LeadDetail", "Crm", new { id = deal.LeadId })" class="text-decoration-none">
                                                <div>@deal.Lead.FirstName @deal.Lead.LastName</div>
                                                @if (!string.IsNullOrEmpty(deal.Lead.Company))
                                                {
                                                    <small class="text-muted">@deal.Lead.Company</small>
                                                }
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No contact</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success">$@deal.Amount.ToString("N0")</span>
                                        <small class="text-muted">@deal.Currency</small>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="width: 60px; height: 6px;">
                                                <div class="progress-bar @(deal.Probability >= 70 ? "bg-success" : deal.Probability >= 40 ? "bg-warning" : "bg-secondary")" 
                                                     style="width: @deal.Probability%"></div>
                                            </div>
                                            <small>@deal.Probability%</small>
                                        </div>
                                    </td>
                                    <td>
                                        @if (deal.ExpectedCloseDate.HasValue)
                                        {
                                            var daysUntil = (deal.ExpectedCloseDate.Value - DateTime.UtcNow).Days;
                                            <span class="@(daysUntil < 0 ? "text-danger" : daysUntil < 7 ? "text-warning" : "")">
                                                @deal.ExpectedCloseDate.Value.ToString("MMM d, yyyy")
                                            </span>
                                            @if (daysUntil < 0)
                                            {
                                                <br><small class="text-danger">@Math.Abs(daysUntil) days overdue</small>
                                            }
                                            else if (daysUntil == 0)
                                            {
                                                <br><small class="text-warning">Due today</small>
                                            }
                                            else if (daysUntil <= 7)
                                            {
                                                <br><small class="text-warning">@daysUntil days left</small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (deal.Status == Notification_Application.Models.DealStatus.Open)
                                        {
                                            <span class="badge bg-primary">Open</span>
                                        }
                                        else if (deal.Status == Notification_Application.Models.DealStatus.Won)
                                        {
                                            <span class="badge bg-success">Won</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Lost</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            @if (deal.Status == Notification_Application.Models.DealStatus.Open)
                                            {
                                                <form method="post" asp-action="UpdateDealStatus" class="d-inline">
                                                    <input type="hidden" name="dealId" value="@deal.Id" />
                                                    <input type="hidden" name="status" value="Won" />
                                                    <button type="submit" class="btn btn-success btn-sm" title="Mark as Won">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                </form>
                                                <form method="post" asp-action="UpdateDealStatus" class="d-inline">
                                                    <input type="hidden" name="dealId" value="@deal.Id" />
                                                    <input type="hidden" name="status" value="Lost" />
                                                    <button type="submit" class="btn btn-danger btn-sm" title="Mark as Lost">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            }
                                            @if (deal.LeadId > 0)
                                            {
                                                <a href="@Url.Action("LeadDetail", "Crm", new { id = deal.LeadId })" class="btn btn-outline-secondary btn-sm" title="View Lead">
                                                    <i class="bi bi-person"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (ViewBag.TotalPages > 1)
                {
                    <div class="card-footer bg-transparent">
                        <nav>
                            <ul class="pagination pagination-sm mb-0 justify-content-center">
                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Deals", new { page = i, status = ViewBag.StatusFilter, search = ViewBag.SearchTerm })">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-briefcase fs-1 text-muted"></i>
                    <h5 class="mt-3">No deals found</h5>
                    <p class="text-muted">Create your first deal to start tracking revenue.</p>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newDealModal">
                        <i class="bi bi-plus-lg me-1"></i>Create Deal
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- New Deal Modal -->
<div class="modal fade" id="newDealModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-briefcase me-2"></i>New Deal</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="CreateDeal">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Deal Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="name" required placeholder="e.g., Website Redesign Project">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Amount <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" name="amount" required min="0" step="0.01" placeholder="0.00">
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Currency</label>
                            <select class="form-select" name="currency">
                                <option value="USD" selected>USD</option>
                                <option value="EUR">EUR</option>
                                <option value="GBP">GBP</option>
                                <option value="CAD">CAD</option>
                                <option value="AUD">AUD</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Probability (%)</label>
                            <input type="number" class="form-control" name="probability" min="0" max="100" value="50">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Expected Close Date</label>
                            <input type="date" class="form-control" name="expectedCloseDate">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Associated Lead <span class="text-danger">*</span></label>
                        <select class="form-select" name="leadId" id="leadSelect" required>
                            <option value="">Select a lead</option>
                        </select>
                        <small class="text-muted">Deals must be associated with a lead.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Deal</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Load leads for the new deal modal
    document.getElementById('newDealModal').addEventListener('show.bs.modal', function() {
        fetch('@Url.Action("GetLeadsJson", "Leads")')
            .then(r => r.json())
            .then(leads => {
                const select = document.getElementById('leadSelect');
                select.innerHTML = '<option value="">Select a lead</option>';
                leads.forEach(lead => {
                    const option = document.createElement('option');
                    option.value = lead.id;
                    option.textContent = `${lead.firstName || ''} ${lead.lastName || ''}${lead.company ? ' - ' + lead.company : ''}`.trim();
                    select.appendChild(option);
                });
            })
            .catch(err => console.log('Could not load leads:', err));
    });
</script>
}
